{
 "poc": "minigim-gebiedscheck",
 "methodiek": "minigim-v0.91",
 "aoi": {
  "schema": "geojson",
  "crs": "EPSG:28992|WGS84"
 },
 "phases": [
  {
   "id": "F0-intake",
   "title": "Intake/scoping",
   "agent": {
    "role": "intake",
    "llm": true
   },
   "tasks": [
    {
     "id": "request-schema",
     "from": "run-input",
     "binding": "auto",
     "tool": {
      "class": "validation",
      "ref": "schema:OpportunityMapRequest",
      "transport": "in-process"
     }
    }
   ],
   "gate": {
    "validate": [
     "V0"
    ]
   }
  },
  {
   "id": "F1-omgevingsanalyse",
   "title": "Omgevingsanalyse (informatie ophalen)",
   "agent": {
    "role": "minigim-specialist"
   },
   "tasks": [
    {
     "id": "locatie.luchtfoto",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "https://www.pdok.nl/datasets/luchtfoto-s (Beeldmateriaal Nederland, WMTS/WMS — raster buiten scope runner)",
     "notes": [
      "rasterlevering, geen vectorstatistiek"
     ]
    },
    {
     "id": "locatie.plangrens",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "run-input",
      "transport": "in-process",
      "derive": [
       "echo_input"
      ]
     },
     "notes": [
      "de plangrens is run-input; BTO (bruto terreinoppervlakte) wordt deterministisch berekend"
     ]
    },
    {
     "id": "locatie.adres",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bag-wfs",
      "transport": "in-process",
      "derive": [
       "list_in_aoi"
      ]
     },
     "notes": [
      "adreslijst uit BAG-verblijfsobjecten binnen plangrens"
     ]
    },
    {
     "id": "locatie.referentie.nulpunt",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "run-input",
      "transport": "in-process",
      "derive": [
       "representative_point"
      ]
     },
     "notes": [
      "representatief punt (shapely representative_point) van de plangrens in RD en WGS84"
     ]
    },
    {
     "id": "topografie.materialisatie",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bgt-ogc-api",
      "transport": "in-process",
      "derive": [
       "clip_stats"
      ]
     },
     "notes": [
      "BGT-objecten binnen plangrens; klasseoverzicht als overzicht van het hele onderdeel"
     ]
    },
    {
     "id": "topografie.materialisatie.afval",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "BGT-viewer gemeente/land (objecttype bak, functie afvalcontainer) — geen aparte open landelijke collectie"
    },
    {
     "id": "topografie.materialisatie.bebouwd-oppervlak",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bag-wfs",
      "transport": "in-process",
      "derive": [
       "clip_stats"
      ]
     },
     "notes": [
      "pandvoetafdruk (m²) binnen plangrens"
     ]
    },
    {
     "id": "topografie.materialisatie.verhard-oppervlak",
     "from": "register:minigim-lijst",
     "binding": "partial",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bgt-ogc-api",
      "transport": "in-process",
      "derive": [
       "clip_stats"
      ]
     },
     "proxyNote": "BGT wegdeel + onbegroeidterreindeel als verhardingsproxy; werkelijke verhardingsgraad (type materialisatie) staat niet als apart attribuut in de open BGT-levering"
    },
    {
     "id": "topografie.materialisatie.onverhard-oppervlak",
     "from": "register:minigim-lijst",
     "binding": "partial",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bgt-ogc-api",
      "transport": "in-process",
      "derive": [
       "clip_stats"
      ]
     },
     "proxyNote": "begroeid terreindeel (plus onverhard onbegroeid deel) als onverhard-proxy; BGT-functie 'onverhard' selecteren waar aanwezig"
    },
    {
     "id": "topografie.materialisatie.wegdeel",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bgt-ogc-api",
      "transport": "in-process",
      "derive": [
       "clip_layer"
      ]
     }
    },
    {
     "id": "topografie.materialisatie.waterdeel",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bgt-ogc-api",
      "transport": "in-process",
      "derive": [
       "clip_layer"
      ]
     }
    },
    {
     "id": "topografie.materialisatie.bebouwing-3d-bag",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "https://3dbag.nl (TU Delft 3D BAG API); zie ook 3d-viewer/ in deze repo (LOD22 tiles)",
     "notes": [
      "volume (m³) voor sloopschatting zit in de 3D BAG; niet als sleutelloze vectorstatistiek in deze runner (fase 2)"
     ]
    },
    {
     "id": "topografie.materialisatie.bebouwing-bag",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-bag-wfs",
      "transport": "in-process",
      "derive": [
       "clip_layer"
      ]
     }
    },
    {
     "id": "topografie.mobiliteit",
     "from": "register:minigim-lijst",
     "binding": "partial",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-nwb-wegen",
      "transport": "in-process",
      "derive": [
       "presence"
      ]
     },
     "proxyNote": "NWB wegvakken dekt verkeerswegen-hiërarchie; OV en parken zitten niet in het NWB"
    },
    {
     "id": "topografie.mobiliteit.verkeerswegen",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-nwb-wegen",
      "transport": "in-process",
      "derive": [
       "clip_layer"
      ]
     },
     "notes": [
      "hiërarchie via NWB-attributen (wegtype/beheerder)"
     ]
    },
    {
     "id": "topografie.mobiliteit.openbaar-vervoer",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "NDOVL / OV-API (https://ndovloket.nl) — haltes en lijnen, niet in deze bronnenstack geverifieerd"
    },
    {
     "id": "topografie.mobiliteit.parkeren",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "gemeente Breda parkeerregistratie (data.breda.nl) — parkeerbalans vraagt gemeentedata"

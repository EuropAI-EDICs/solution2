    },
    {
     "id": "topografie.topotijdreis",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "https://www.topotijdreis.nl (Kadaster, historische topografie)",
     "notes": [
      "PDF/beeldlevering"
     ]
    },
    {
     "id": "ruimtelijke-ordening.kadaster.percelen",
     "from": "register:minigim-lijst",
     "binding": "auto",
     "tool": {
      "class": "retrieval",
      "ref": "pdok-brk-kadastrale-kaart",
      "transport": "in-process",
      "derive": [

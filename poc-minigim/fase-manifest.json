    {
     "id": "ruimtelijke-ordening.bestemmingsplan",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "DSO/LVBB omgevingsdocumenten (https://www.omgevingswet.overheid.nl) — machinekanaal API-sleutel vereist (zie PoC-1 ervaring: DSO download API 401 zonder key); lokale conversie-tooling: imro/ in deze repo",
     "notes": [
      "regelingtekst + GIO's; sleutelgate"
     ]
    },
    {
     "id": "ruimtelijke-ordening.bestemmingsplan.enkelbestemming",
     "from": "register:minigim-lijst",
     "binding": "manual",
     "manualPointer": "idem bestemmingsplan (DSO)"

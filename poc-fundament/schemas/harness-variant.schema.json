{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldt-toolbox/schemas/harness-variant.schema.json",
  "title": "Harness-variant: één voorstel van component-wijzigingen t.o.v. de actieve harness",
  "type": "object",
  "required": ["id", "title", "components"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "base": { "type": "string",
      "description": "optionele register-id van de entry waar deze variant op voortbouwt" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["prompt", "toolGrants", "modelPin"] },
        "target": { "type": "string", "minLength": 1,
          "description": "prompt: 'recipe_driver', 'poc/<naam>' of 'roles/<naam>'; modelPin: 'orchestrator' of 'subagent'" },
        "path": { "type": "string", "minLength": 1,
          "description": "prompt: pad van de variant-prompt, t.o.v. de map van dit variant-bestand" },
        "allow": { "type": "object",
          "description": "toolGrants: agent → tool-namen die (opnieuw) mogen, binnen de pre-slotgate toolset van die agent" },
        "deny": { "type": "object",
          "description": "toolGrants: agent → tool-namen die hoe dan ook afvallen" },
        "env": { "type": "object",
          "description": "modelPin: env-var → waarde, bv. DEEP_AGENT_SUBMODEL" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "prompt" } } },
          "then": { "required": ["path"] } },
        { "if": { "properties": { "type": { "const": "toolGrants" } } },
          "then": { "anyOf": [ { "required": ["allow"] }, { "required": ["deny"] } ] } },
        { "if": { "properties": { "type": { "const": "modelPin" } } },
          "then": { "required": ["env"] } }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/poc-gent/schemas/gent-run.schema.json",
  "title": "Gent transactional run (F1+F2+IAM+F3: intake→context→GIS→routing→H1→H2 EUDI-wallet/ACM-IDM→prefill/validatie→H3→H4/submission)",
  "description": "hcs-run-vorm (nldt/schemas/hcs-run.schema.json) plus transaction-blok, ontwerp 2026-10-30 §5 (fase 1+2; schema v1.1 met status/auth/prefill/validatie/h3; IAM-aanvulling: auth-blok optioneel methode/loa/onthuldeClaims voor de EUDI-wallet-route — achterwaarts compatibel; v1.2 voegt verplicht submission-blok toe: H4, documenten, ontvangst, vervolgsamenvatting).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "recipeId", "processId", "mode", "scenario", "steps", "stopConditions", "kpiSnapshot", "transaction"],
  "properties": {
    "schemaVersion": {"const": "1.2"},
    "runId": {"type": "string"},
    "generatedAt": {"type": "string"},
    "recipeId": {"type": "string"},
    "processId": {"const": "gent-transactional-run"},
    "mode": {"enum": ["replay", "execute"]},
    "scenario": {"type": "string"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runStep"}},
    "stopConditions": {"type": "array"},
    "kpiSnapshot": {"type": "array"},
    "transaction": {"$ref": "#/$defs/transaction"}
  },
  "$defs": {
    "runStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "title", "actor", "genAiTestPoint", "dataUsed", "consent", "handover", "kpiEvents", "prov"],
      "properties": {
        "stepId": {"type": "string"},
        "title": {"type": "string"},
        "actor": {"enum": ["agent", "mens", "partij"]},
        "genAiTestPoint": {"enum": ["G1", "G2", "G3", "G4", "G5", "—"]},
        "dataUsed": {"type": "array", "items": {"type": "string"}},
        "consent": {"enum": ["n.v.t.", "gevraagd", "gegeven", "geweigerd"]},
        "handover": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["reason", "to"], "additionalProperties": false, "properties": {"reason": {"type": "string"}, "to": {"type": "string"}}}]},
        "kpiEvents": {"type": "array", "items": {"type": "object", "required": ["kpi", "effect"], "additionalProperties": false, "properties": {"kpi": {"type": "string"}, "effect": {"type": "string"}}}},
        "prov": {"type": "object", "required": ["sources"], "additionalProperties": false, "properties": {"sources": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "routing", "h1", "status", "auth", "prefill", "validatie", "h3", "submission"],
      "properties": {
        "context": {"type": "object", "required": ["tekst", "regels"], "additionalProperties": false, "properties": {"tekst": {"type": "string"}, "regels": {"type": "array", "items": {"$ref": "#/$defs/contextRegel"}}}},
        "routing": {
          "type": "object", "required": ["outcome", "paths", "trace", "uitleg"], "additionalProperties": false,
          "properties": {
            "outcome": {"enum": ["paden", "escalatie"]},
            "paths": {"type": "object", "required": ["transactions", "info"], "additionalProperties": false, "properties": {"transactions": {"type": "array", "items": {"type": "string"}}, "info": {"type": "array", "items": {"type": "string"}}}},
            "trace": {"type": "array", "items": {"type": "object", "required": ["ruleId", "fired", "reden"], "additionalProperties": false, "properties": {"ruleId": {"type": "string"}, "fired": {"type": "boolean"}, "reden": {"type": "string"}}}},
            "uitleg": {"type": "array", "items": {"type": "object", "required": ["regelId", "tekst", "bron"], "additionalProperties": false, "properties": {"regelId": {"type": "string"}, "tekst": {"type": "string"}, "bron": {"type": "string"}}}}
          }
        },
        "h1": {"type": "object", "required": ["verdict", "correcties"], "additionalProperties": false, "properties": {"verdict": {"enum": ["gegeven", "geweigerd"]}, "correcties": {"type": "object"}}},
        "status": {"enum": ["gereed", "gereed-met-waarschuwing", "blokkade", "geweigerd", "escalatie"]},
        "auth": {"type": "object", "additionalProperties": false,
          "required": ["authenticatie", "toestemming", "mandaten"],
          "properties": {"authenticatie": {"enum": ["uitgevoerd", "niet-uitgevoerd"]},
                         "toestemming": {"enum": ["gegeven", "geweigerd", "n.v.t."]},
                         "mandaten": {"type": "array"},
                         "methode": {"enum": ["eudi-wallet", "acm-idm"]},
                         "loa": {"enum": ["low", "substantial", "high"]},
                         "onthuldeClaims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
        "prefill": {"type": "object", "additionalProperties": false, "required": ["transacties"],
          "properties": {"transacties": {"type": "array", "items": {"$ref": "#/$defs/prefillTransactie"}}}},
        "validatie": {"type": "object", "additionalProperties": false, "required": ["transacties"],
          "properties": {"transacties": {"type": "array", "items": {"$ref": "#/$defs/validatieTransactie"}}}},
        "h3": {"type": "object", "additionalProperties": false, "required": ["verdict", "correcties"],
          "properties": {"verdict": {"enum": ["gegeven", "geweigerd", "n.v.t."]}, "correcties": {"type": "object"}}},
        "submission": {"type": "object", "additionalProperties": false,
          "required": ["h4", "documenten", "ontvangst", "vervolgsamenvatting"],
          "properties": {
            "h4": {"$ref": "#/$defs/submissionH4"},
            "documenten": {"$ref": "#/$defs/submissionDocumenten"},
            "ontvangst": {"type": "object", "additionalProperties": false, "required": ["transacties"],
              "properties": {"transacties": {"type": "array", "items": {"$ref": "#/$defs/ontvangstTransactie"}}}},
            "vervolgsamenvatting": {"$ref": "#/$defs/vervolgsamenvatting"}
          }}
      }
    },
    "contextRegel": {
      "type": "object", "required": ["feit", "waarde", "label", "bron"], "additionalProperties": false,
      "properties": {"feit": {"type": "string"}, "waarde": {}, "label": {"enum": ["gebruiker", "correctie", "afgeleid", "authentiek"]}, "bron": {"type": "string"}}
    },
    "prefillTransactie": {"type": "object", "additionalProperties": false, "required": ["service", "velden", "ontbrekend"],
      "properties": {"service": {"type": "string"}, "ontbrekend": {"type": "array", "items": {"type": "string"}},
        "velden": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["veld", "waarde", "label", "bron"],
          "properties": {"veld": {"type": "string"}, "waarde": {}, "bron": {"type": "string"},
            "label": {"enum": ["gebruiker", "correctie", "afgeleid", "authentiek"]}}}}}},
    "validatieTransactie": {"type": "object", "additionalProperties": false, "required": ["service", "status", "bevindingen"],
      "properties": {"service": {"type": "string"},
        "status": {"enum": ["gereed", "gereed-met-waarschuwing", "blokkade"]},
        "bevindingen": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "ernst", "melding"],
          "properties": {"id": {"type": "string"}, "ernst": {"enum": ["blokkade", "waarschuwing"]}, "melding": {"type": "string"}}}}}},
    "submissionH4": {"type": "object", "additionalProperties": false, "required": ["verdict", "bevestigdOp"],
      "properties": {"verdict": {"enum": ["gegeven", "geweigerd", "n.v.t."]}, "bevestigdOp": {"type": "string"}}},
    "submissionDocumenten": {"type": "object", "additionalProperties": false, "required": ["status", "bevindingen"],
      "properties": {"status": {"enum": ["volledig", "onvolledig", "n.v.t."]},
        "bevindingen": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "ernst", "melding"],
          "properties": {"id": {"type": "string"}, "ernst": {"enum": ["blokkade", "waarschuwing"]}, "melding": {"type": "string"}}}}}},
    "ontvangstTransactie": {"type": "object", "additionalProperties": false, "required": ["service", "referentie", "status"],
      "properties": {"service": {"type": "string"}, "referentie": {"type": ["string", "null"]},
        "status": {"enum": ["geaccepteerd", "in-wachtrij", "afgewezen", "technisch-mislukt", "niet-ingediend"]}}},
    "vervolgsamenvatting": {"type": "object", "additionalProperties": false, "required": ["gereed", "open"],
      "properties": {"gereed": {"type": "array", "items": {"type": "string"}}, "open": {"type": "array", "items": {"type": "string"}}}}
  }
}

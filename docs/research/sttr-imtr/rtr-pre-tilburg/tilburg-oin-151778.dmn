<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd"
                 xmlns:feel="http://www.omg.org/spec/FEEL/20140401"
                 xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel"
                 xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel"
                 xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel"
                 xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content"
                 xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001172773000"
                 namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001172773000"
                 exporter="Geodan FLO Legal STTR Builder" exporterVersion="" id="_a88259eb-d0b3-4489-99a8-527b79bebd4a"
                 name="Indieningsvereisten Informatie Ongewoon voorval bij een milieubelastende activiteit gereguleerd in het omgevingsplan">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="_9569dc8b-0288-44a7-b075-a51f7d6d6c62">
    <inter:naam>Diverse vragen</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_96f51b2c-a713-4132-8604-01e732898bab">
    <inter:naam>Algemene bijlagen</inter:naam>
    <inter:prioriteit>20</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__1debd14d-c21b-4f02-954c-733f8af6047b">
        <uitv:regelgroepRef href="#_9569dc8b-0288-44a7-b075-a51f7d6d6c62"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Beschrijf de activiteit en het onderwerp waarvoor u een ongewoon voorval wilt melden.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Doet zich bij u een voorval voor dat afwijkt van de normale gang van zaken (zoals een storing, een incident of gepland onderhoud)? En heeft dit mogelijk gevolgen voor de omgeving? Dan moet u de gemeente hierover zo snel mogelijk informeren.  
De Omgevingsdienst heeft hiervoor een speciaal telefoonnummer dat 24/7 beschikbaar is: 073 - 681 28 21. Dit formulier gebruikt u voor het aanleveren van informatie over het voorval.]]></content:toelichting>
    
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__2638b00e-954a-4e3d-94a9-82a2d9acfd5c">
        <uitv:regelgroepRef href="#_96f51b2c-a713-4132-8604-01e732898bab"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>20</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Oorzaken en omstandigheden ongewoon voorval</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: informatie over de oorzaken van het ongewoon voorval en de omstandigheden waaronder het voorval zich heeft voorgedaan\.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__f6c4f254-f089-4f22-8f80-1bb9248828fd">
        <uitv:regelgroepRef href="#_96f51b2c-a713-4132-8604-01e732898bab"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>30</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Informatie vrijgekomen stoffen en hun eigenschappen</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Heeft het ongewoon voorval zich voorgedaan bij een milieubelastende activiteit? Voeg dan informatie over de vrijgekomen stoffen en hun eigenschappen toe als bijlage\.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__c34bd664-f739-49e4-95b9-20c87dbf972a">
        <uitv:regelgroepRef href="#_96f51b2c-a713-4132-8604-01e732898bab"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>40</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Gegevens inschatten aard en ernst gevolgen voorval</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Heeft u nog andere gegevens die nodig zijn om de aard en ernst van de gevolgen van het ongewoon voorval in te kunnen schatten? Voeg deze gegevens dan toe als bijlage\.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__ffa4a34b-b7bd-4ad8-a26d-2cda8765e2a9">
        <uitv:regelgroepRef href="#_96f51b2c-a713-4132-8604-01e732898bab"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>50</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Maatregelen om nadelige gevolgen van het voorval te voorkomen</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: informatie over de maatregelen die zijn getroffen of worden overwogen om de nadelige gevolgen van het ongewoon voorval te voorkomen\.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        

        </semantic:inputExpression>
      </semantic:input>
      <semantic:output id="_5555724" />
      <semantic:rule id="_4399955">
        <semantic:inputEntry id="_4810061">
          <semantic:text>if ?=null then false else contains(?,"Starten van een nieuwe activiteit of activiteit verplaatsen naar een ander adres") or contains(?,"Uitvoeren van een bestaande activiteit waarover u niet eerder informatie heeft gegeven")</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_7162485">
          <semantic:text>true</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
      <semantic:rule id="_8559849">
        <semantic:inputEntry id="_6489345">
          <semantic:text>if ?=null then false else not(contains(?,"Starten van een nieuwe activiteit of activiteit verplaatsen naar een ander adres") or contains(?,"Uitvoeren van een bestaande activiteit waarover u niet eerder informatie heeft gegeven"))</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_5470644">
          <semantic:text>false</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
    </semantic:decisionTable>

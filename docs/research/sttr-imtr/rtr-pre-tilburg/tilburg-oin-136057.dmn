            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_c54ad249-1ec8-4b72-beeb-9f8c073f06ea" label="Is het bord hoger dan 1 meter boven de grond?">
            <dmn:inputExpression typeRef="feel:boolean">

            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_33774fc2-7fc0-44b5-8146-aa49a45683f8" label="Hebt u een vergunning nodig voor het veranderen van het monument?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_0f3fa861-e33f-407c-8c14-2b8206bcac7b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_d0500f55-1d27-40fe-8f68-b82b054c951c" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_9c7254d2-a0f5-4a43-9ea7-0a0862da7b98" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">
            <dmn:inputExpression typeRef="feel:boolean">

            <dmn:input id="_aa3f3103-bbef-4d59-9295-997a6721e66e" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_175bac15-0f8e-4fb2-8d82-0a6f2b4c13eb" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_d623b890-c8e7-4cd9-a40c-d1ed52f4098b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_9b282066-107f-43bc-8a59-7e8aed43a516" label="Is de onroerende zaak waarop de reclame komt een monument?">

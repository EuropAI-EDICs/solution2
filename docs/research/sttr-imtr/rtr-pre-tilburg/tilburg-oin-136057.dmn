            <dmn:input id="_57959f17-0dd1-4681-96b3-6d3e41494d21" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_ba942aef-eb54-4b1f-a834-d191806530d9" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">

            <dmn:input id="_607af771-37b2-478a-a2ad-a6d0d8b36dd7" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_cfc79dfd-7f3f-414b-af27-613aedfaf8eb" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_d623b890-c8e7-4cd9-a40c-d1ed52f4098b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_64ffd961-3c5c-4f89-8961-d28e6edaaa53" label="Is de onroerende zaak waarop de reclame komt een monument?">

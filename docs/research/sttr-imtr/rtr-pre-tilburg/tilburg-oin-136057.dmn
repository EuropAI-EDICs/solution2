            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_b5fe81d5-d337-4708-adf5-1896a8e41a6d" label="Hebt u een vergunning nodig voor het veranderen van het monument?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_0f3fa861-e33f-407c-8c14-2b8206bcac7b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_a115cce9-222f-478b-bf8e-eef7ba5b1438" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_03593d4f-15e4-4a3b-a1cc-5383ae1fe20d" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">

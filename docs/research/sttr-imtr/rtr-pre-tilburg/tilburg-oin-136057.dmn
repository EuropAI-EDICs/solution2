            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_13847914-83f9-4f59-a0d5-b29b5ecfc9ce" label="Steekt het bord meer dan 10 centimeter voor het gevelvlak uit?">
            <dmn:inputExpression typeRef="feel:boolean">

            <dmn:input id="_eefc4412-9567-49d7-91a8-8ae8384cfe16" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_d2102ad7-425e-46dd-b6e5-ea09965d6e9b" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_d623b890-c8e7-4cd9-a40c-d1ed52f4098b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_8a957440-8dc2-446e-a213-73f5c65e2d6f" label="Is de onroerende zaak waarop de reclame komt een monument?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_57c9d609-b2f2-4c28-b1ae-b0f7ecf0878d</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_531c02c0-182f-45af-b8fb-ca18192137c0" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_90742f87-ab64-4a9c-bdf8-12820d2a5c9b" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_2e88b2e8-7f87-47f1-9b24-7bbec290b4dd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_8fe4c06d-062c-4a38-b88e-b9f48a9a5e0a" label="Wordt het bord verlicht?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_bfb135c9-bbbf-46df-b960-1b1ef62e0913</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_09047c81-1626-49dd-86e0-6dfa9b396889" label="Waar wordt het bord geplaatst?">
            <dmn:inputExpression typeRef="feel:string">
                <dmn:text>_212123bd-ea02-493b-b571-2fb42f662d03</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_8c24f4f6-25be-4f3a-b596-c41ad6a129bc" label="Steekt het bord meer dan 10 centimeter voor het gevelvlak uit?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_a97ed665-be5a-4f85-ab8b-58ffa2b40710</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_84faa9af-1c93-4e03-beda-32c281fa097e" label="Wordt de bovenzijde van het bord hoger dan 2 meter boven de grond geplaatst?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_ca547a64-2b18-40e3-9a24-497fe2c98d01</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_51c438c2-bcda-4d0c-854d-80e699aceca5" label="Is de oppervlakte van het bord groter dan  0,5 m2?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_6fc7c01e-a5dc-4269-a353-1b0018719819</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_935ab995-3d4e-4499-b0f4-bd0768cefe46" label="Is de lengte of de breedte van het bord meer  dan 1 meter?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_4c38eb94-3e1a-4f15-bce2-5129288a80cb</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
    
            <dmn:output id="_96a9037d-d78b-48cc-878e-f16361013f77" label="Vergunningplicht pad 18"/>
                    

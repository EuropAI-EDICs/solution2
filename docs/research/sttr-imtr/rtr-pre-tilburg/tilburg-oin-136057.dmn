                <dmn:text>_0f3fa861-e33f-407c-8c14-2b8206bcac7b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_08a32f97-03cd-4cef-951d-60aefb13baab" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_9c0829f9-1916-4147-93c3-0b6a7fa86e85" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_2e88b2e8-7f87-47f1-9b24-7bbec290b4dd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_b6265c95-1335-4119-af48-6b9df44d5326" label="Wordt het bord verlicht?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_bfb135c9-bbbf-46df-b960-1b1ef62e0913</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_d0d5f5f5-d492-4e2a-b453-57e4e379131a" label="Waar wordt het bord geplaatst?">
            <dmn:inputExpression typeRef="feel:string">
                <dmn:text>_212123bd-ea02-493b-b571-2fb42f662d03</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_d83298df-3e2b-4181-bfb8-e90aae5ab4b3" label="Steekt het bord meer dan 10 centimeter voor het gevelvlak uit?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_a97ed665-be5a-4f85-ab8b-58ffa2b40710</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_93556307-0d94-4be8-beb1-a9236db5bb4b" label="Wordt de bovenzijde van het bord hoger dan 2 meter boven de grond geplaatst?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_ca547a64-2b18-40e3-9a24-497fe2c98d01</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_451c5589-3a37-4500-9190-a5d5402c8838" label="Is de oppervlakte van het bord groter dan  0,5 m2?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_6fc7c01e-a5dc-4269-a353-1b0018719819</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
    

            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_f7c05adb-92ae-4562-b7e4-650d4b14a48a" label="Wordt het bord verlicht?">
            <dmn:inputExpression typeRef="feel:boolean">

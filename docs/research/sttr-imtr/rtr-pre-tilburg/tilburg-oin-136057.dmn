            <dmn:input id="_44b144f2-aa2a-44b1-80ae-efe87d6c4763" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_f9060b5d-d57e-45af-a9b6-ea68d6c382ac" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">

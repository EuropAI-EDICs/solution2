            <dmn:input id="_0105ea05-3198-42ed-b4aa-e617c8bf8af6" label="Komt de reclame op of aan een onroerende zaak?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_32f5ce7a-e0d7-4e06-ba7b-b537c33767bd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_7d1f6a02-60ce-43fb-a7ec-a005a8b85d82" label="Is voor het plaatsen van de reclame een omgevingsvergunning voor bouwen nodig?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_d623b890-c8e7-4cd9-a40c-d1ed52f4098b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_092abeb6-ddd1-46af-97f4-8ceeaeda7e26" label="Is de onroerende zaak waarop de reclame komt een monument?">

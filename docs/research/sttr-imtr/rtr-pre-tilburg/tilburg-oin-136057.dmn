            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_a014306d-55a9-4003-8015-64d0e74b4baf" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_78bf0c62-3475-4c66-a052-d42430e40db2" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">

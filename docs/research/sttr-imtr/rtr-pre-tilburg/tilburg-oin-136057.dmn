                <dmn:text>_57c9d609-b2f2-4c28-b1ae-b0f7ecf0878d</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_996711ad-ce48-4d5e-a80e-03722d2a453c" label="Hebt u een vergunning nodig voor het veranderen van het monument?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_0f3fa861-e33f-407c-8c14-2b8206bcac7b</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_856de0f7-0d4d-4ca1-a7f0-a1eb21fbc2b6" label="Komt de reclame in een welstandsvrij gebied?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_8605495b-1bcb-478a-90af-64d5c0e57c3c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_2f9a1350-9a63-491c-8881-7a94e107de6b" label="Gaat het om een bord met naamsaanduiding op of bij een gebouw?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_2e88b2e8-7f87-47f1-9b24-7bbec290b4dd</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_0cf7c530-7f15-4be3-94e9-6f84021697c5" label="Wordt het bord verlicht?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_bfb135c9-bbbf-46df-b960-1b1ef62e0913</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_4a2c817f-7a47-4bf7-b291-90cbdb7a6bf9" label="Waar wordt het bord geplaatst?">
            <dmn:inputExpression typeRef="feel:string">

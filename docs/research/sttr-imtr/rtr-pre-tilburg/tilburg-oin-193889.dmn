  <semantic:decision id="_f0f595cd-e384-4844-b426-da24bef2cc2d_1c411473-a34d-410e-81cc-9be43e1fd472" name="Indieningsvereisten - Informatieplicht - FokkenLandbHuisdieren">
    <semantic:extensionElements>
      <bedr:functioneleStructuurRef href="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001172773000/id/concept/IndieningsvereistenInformatienl.imow-gm0855.activiteit.FokkenLandbHuisdieren" />
    </semantic:extensionElements>
    <semantic:variable id="_f0f595cd-e384-4844-b426-da24bef2cc2d_1c411473-a34d-410e-81cc-9be43e1fd472_var" name="Indieningsvereisten - Informatieplicht - FokkenLandbHuisdieren" typeRef="feel:boolean" />
    <semantic:informationRequirement>
      <semantic:requiredDecision href="#_15970_BizRule" />

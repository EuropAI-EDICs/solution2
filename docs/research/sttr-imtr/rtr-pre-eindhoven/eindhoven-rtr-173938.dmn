<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_4064834" name="Indieningsvereisten Vergunning - Handelsreclame maken of voeren" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_1515_RuleGroup">
        <inter:naam>Diverse vragen</inter:naam>
        <inter:prioriteit>990</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_26303_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>990</inter:prioriteit>
        <uitv:bijlage>
          <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan hiervoor al gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14031_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Omschrijf wat u wilt gaan doen.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14012_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef aan wat u wilt gaan doen?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Een nieuwe handelsreclame plaatsen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Een bestaande handelsreclame wijzigen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Een bestaande handelsreclame vervangen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14048_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>80</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wie maakt of voert reclame op of bij de onroerende zaak?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Eigenaar van de onroerende zaak]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Beperkt zakelijk gerechtigde van de onroerende zaak]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Gebruiker van de onroerende zaak]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14051_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>false</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>90</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef naam, adres en woonplaats van degene die reclame maakt of voert.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14032_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Hoeveel reclameobjecten betreft het?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14033_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de afmeting van de reclame?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Geef van elk reclameobject afzonderlijk de afmetingen aan\.  
Deze informatie mag u ook opnemen in een bijlage \.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14045_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>50</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de hoogte van de reclame gemeten vanaf het maaiveld tot aan de onderkant van de reclame?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Het gaat hier om de afstand tussen het maaiveld en de onderkant van het reclameobject\. Geef  van elk reclameobject afzonderlijk de hoogte op\.  
Deze informatie mag u ook opnemen in een bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14046_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>60</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef een omschrijving van het uiterlijk (kleur), materiaalgebruik en verlichting van de reclame.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14047_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>70</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de tekst van de reclame?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14078_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Kleurenfoto’s reclame</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: kleurenfoto’s die de bestaande situatie van de \(locatie van de\) reclame weergeven\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[De kleurenfoto’s moeten van de locatie van de te plaatsen reclame de volgende gegevens bevatten:

* straat\- en gevelbeeld
* belendende bebouwing
* plaats van de nieuw te plaatsen reclame
* overige al aanwezige reclame]]></content:langeToelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14079_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Tekeningen reclame</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: situatie\-, gevel\- en/of ontwerptekeningen die details van de te plaatsen reclame bevatten\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[Tekeningen, in de vorm van een situatie\-, gevel\- en/of ontwerptekening, moeten de volgende gegevens bevatten:

* plaats van de reclame \(aan de gevel, op het dak, en dergelijke\)
* aantal en afmetingen van de reclame
* hoogte van de reclame, gemeten vanaf het maaiveld tot de onderkant van de reclame
* bevestigingsconstructie
* te gebruiken materialen, kleuren en verlichting
* tekst van de reclame
* belendende bebouwing
* overige al aanwezige reclame
* details uiterlijk reclame: kleuren, opdruk, lettertypen en dergelijke
* details verlichting reclame: wattage, lichtsterkte en knipperfrequentie
* detailtekening in schaal 1:5 of groter
* duidelijke maatvoering en schaalaanduiding \(aanduiding met maatlijn\)]]></content:langeToelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>
  </semantic:extensionElements>

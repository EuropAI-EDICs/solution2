  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_2740_RuleGroup">
        <inter:naam>Nieuwe of bestaande activiteit</inter:naam>
        <inter:prioriteit>5</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_1515_RuleGroup">
        <inter:naam>Diverse vragen</inter:naam>
        <inter:prioriteit>990</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_24124_BizRule">
        <uitv:regelgroepRef href="#_2740_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>1</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef aan waarover deze vergunningaanvraag gaat.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Starten van een nieuwe activiteit]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Veranderen of uitbreiden van een activiteit waarvoor u al een vergunning heeft]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Gaat uw vergunningaanvraag over een activiteit waarvoor u al een vergunning heeft?

Dan hoeft u alleen gegevens toe te voegen over de verandering of uitbreiding van de activiteit\. Het gaat om de gegevens die niet meer kloppen met de situatie waarvoor u al een vergunning heeft\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_14381_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Begrenzing locatie activiteit</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: informatie over de begrenzing van de locatie waar u de activiteit\(en\) gaat verrichten\. Dit kan een kaart zijn of worden aangegeven met coördinaten\.

Geef precies aan waar activiteit\(en\) beginnen en ophouden\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[Gaat u dit aangeven met coördinaten? Voeg dan bij voorkeur een geografisch bestand van de coördinaten toe\. Kijk bovenaan dit scherm onder ‘Bestandsformaten’ welke formaten u daarvoor kunt gebruiken\.   
Heeft u geen geografisch bestand? Neem de coördinaten dan op in een lijst of een kaartje\.

##### Welk coördinatenstelsel gebruikt u hiervoor?

Gebruik voor de coördinaten het stelsel van de Rijksdriehoeksmeting \(RD\)\.   
In het [Omgevingsloket](../../../../../) kunt u met **Regels op de kaart** de RD\-coördinaten opzoeken\.]]></content:langeToelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_15798_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef aan waarover deze vergunningaanvraag gaat. Kies alle opties die van toepassing zijn.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Opslaan van meer dan 600 m3 vaste mest]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Opslaan van drijfmest, digestaat of dunne fractie in 1 of meer mestbassins met een gezamenlijke oppervlakte groter dan 750 m2]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Opslaan van drijfmest, digestaat of dunne fractie in 1 of meer mestbassins met een gezamenlijke inhoud groter dan 2.500 m3]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_15799_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de opslagcapaciteit voor vaste mest in kubieke meters?]]></uitv:vraagTekst>
          <inter:inputType>text</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_15801_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de totale inhoud van de mestbassins in kubieke meters?]]></uitv:vraagTekst>
          <inter:inputType>text</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20527_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat is de totale oppervlakte van de mestbassins in vierkante meters?]]></uitv:vraagTekst>
          <inter:inputType>text</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_26303_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>990</inter:prioriteit>
        <uitv:bijlage>
          <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan hiervoor al gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>

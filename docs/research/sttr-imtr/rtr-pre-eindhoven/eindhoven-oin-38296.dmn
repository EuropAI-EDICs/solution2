<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001172773000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_2860025" name="Indieningsvereisten Vergunning - Uitweg maken, hebben of veranderen of het gebruik daarvan te veranderen" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001172773000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_2473_RuleGroup">
        <inter:naam>Werkzaamheden in- of uitrit</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_1515_RuleGroup">
        <inter:naam>Diverse vragen</inter:naam>
        <inter:prioriteit>990</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_2542_RuleGroup">
        <inter:naam>Aanwezigheid obstakels in- of uitrit</inter:naam>
        <inter:prioriteit>20</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_26303_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>990</inter:prioriteit>
        <uitv:bijlage>
          <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan hiervoor al gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10143_BizRule">
        <uitv:regelgroepRef href="#_2473_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Kies de werkzaamheden die u gaat uitvoeren]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Een nieuwe in- of uitrit aanleggen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Een bestaande in- of uitrit veranderen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10141_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat zijn de afmetingen van de nieuwe in- of uitrit?]]></uitv:vraagTekst>
          <inter:inputType>text</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10155_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Welke materialen gaat u gebruiken?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10170_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>50</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Aan welk erf ligt de in- of uitrit?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Voorerf]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Zijerf]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Achtererf]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10147_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat worden de afmetingen van de in- of uitrit in de nieuwe situatie?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10146_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat zijn de afmetingen van de bestaande in- of uitrit?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10167_BizRule">
        <uitv:regelgroepRef href="#_2473_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[U heeft aangegeven dat u andere werkzaamheden gaat uitvoeren dan een nieuwe in- of uitrit aanleggen of een bestaande in- of uitrit veranderen. Omschrijf wat u wilt gaan doen.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10158_BizRule">
        <uitv:regelgroepRef href="#_2542_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Zijn er obstakels aanwezig die het aanleggen of het gebruiken van de in- of uitrit in de weg staan?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Obstakels zijn bijvoorbeeld bomen, lantaarnpalen en nutsvoorzieningen \(zoals transformatorhuisjes, flitspalen of buspoortjes\)\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10159_BizRule">
        <uitv:regelgroepRef href="#_2542_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Welke obstakel(s) zijn aanwezig?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Boom]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Lantaarnpaal]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Nutsvoorziening]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10163_BizRule">
        <uitv:regelgroepRef href="#_2542_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Beschrijf het obstakel dat voor het aanleggen of gebruiken van de in- of uitrit in de weg staat.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10172_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>60</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Vul de straatnaam in waar de in- of uitrit op uitkomt.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_10178_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Situatietekening uitrit</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: Een situatietekening waaruit blijkt waar de uitrit wordt aangelegd\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[Deze tekening geeft de bestaande situatie weer\. De nieuwe situatie kan ingetekend worden op deze tekening, of aangeleverd worden op een extra situatietekening\. In plaats van een tekening mag u ook een kleurenfoto toevoegen\.

De situatietekening uitrit moet de volgende gegevens bevatten:

* locatie van de uitrit aan het voor\-, zij\- of achtererf
* aanwezigheid van obstakels die bij het aanleggen van de uitrit in de weg staan, zoals bomen, lantaarnpalen en nutsvoorzieningen
* noordpijl
* duidelijke maatvoering en schaalaanduiding \(aanduiding met maatlijn\)
* formaat van de tekening \(minimaal A4, maximaal A1\)
* datum van de eerste opstelling van de tekening
* datum van de laatste wijziging van de tekening
* ondergrond van voldoende kwaliteit \(bijvoorbeeld grootschalige basiskaart van Nederland, kadastrale kaart\)
* grens van de locatie
* dichtstbijzijnde openbare weg
* dichtstbijzijnde woonbebouwing
* functie van de aangrenzende percelen]]></content:langeToelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_13771_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Tekening vormgeving uitrit</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: een tekening van de exacte vormgeving van de nieuwe of gewijzigde uitrit\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[De ontwerptekening moet de volgende gegevens bevatten:

* afmeting van de nieuwe uitrit
* te gebruiken materialen
* duidelijke maatvoering en schaalaanduiding \(aanduiding met maatlijn\)


Indien van toepassing moet de ontwerptekening nieuwe of gewijzigde uitrit ook de onderstaande gegevens bevatten:

* afmetingen van de bestaande uitrit]]></content:langeToelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>

  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_4693_RuleGroup">
        <inter:naam>Meer dan 2 opslagtanks met propaan of propeen</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_18279_BizRule">
        <uitv:regelgroepRef href="#_4693_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u propaan of propeen opslaan in meer dan 2 opslagtanks?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_45916_BizRule">
        <uitv:regelgroepRef href="#_4693_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Hebben de opslagtanks een inhoud van meer dan 150 liter?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft de opslagtank een inhoud van 150 liter of minder? Dan is het een gasfles\. Daarvoor moet u een andere werkzaamheid kiezen\. Controleer of u die al heeft gekozen\. Heeft u die nog niet gekozen? Ga dan terug naar stap 2: Kies werkzaamheden\. Zoek daar naar ‘gasfles’ en kies de passende werkzaamheid\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_18247_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:vasteWaardeVoorbehoud>
          <uitv:vasteWaarde>
            <uitv:waarde>true</uitv:waarde>
            <uitv:gegevensType>boolean</uitv:gegevensType>
          </uitv:vasteWaarde>
          <uitv:tekstVoorbehoud>Kan er in 1 van de opslagtanks meer dan 13.000 liter propaan of propeen? Dan heeft u om die reden al een vergunning nodig. U hoeft dan geen aparte vergunning aan te vragen voor het opslaan in meer dan 2 opslagtanks.</uitv:tekstVoorbehoud>
        </uitv:vasteWaardeVoorbehoud>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>
  </semantic:extensionElements>

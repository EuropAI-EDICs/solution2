                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>380</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Moet er een verkeersplan komen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Als u hier **ja** invult, vergeet dan niet in de volgende stap het verkeersplan toe te voegen als bijlage. Doet u dit niet dan kunnen wij de aanvraag niet in behandeling nemen. We zullen u een verzoek sturen om het plan alsnog aan te leveren. Dit betekent dat het langer duurt voor u een beslissing ontvangt op uw aanvraag.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ee1bc7be-965f-4dfb-8273-a07a112fbf1f">
                <uitv:regelgroepRef href="#_1e3ba8ec-e127-4e9e-917a-ecd782ae904d"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>390</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U bent verplicht een verkeersplan bij uw aanvraag toe te voegen. Voegt u het verkeersplan hier toe.]]></uitv:bijlageType>
                    <uitv:documenttypeGeneriek>Plan</uitv:documenttypeGeneriek>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__81d23387-ed7d-46df-93b9-d355cb2c3ce6">
                <uitv:regelgroepRef href="#_1e3ba8ec-e127-4e9e-917a-ecd782ae904d"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>400</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U bent niet verplicht een verkeersplan bij uw aanvraag toe te voegen. Mocht u toch een verkeersplan hebben, kunt u dit hier toch toevoegen.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__e6be4d68-9c61-418f-94a5-92166e5db1e7">
                <uitv:regelgroepRef href="#_1e3ba8ec-e127-4e9e-917a-ecd782ae904d"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>410</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn er verkeersomleidingen nodig?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__390aca60-554b-451d-a982-173f61c5390d">
                <uitv:regelgroepRef href="#_1e3ba8ec-e127-4e9e-917a-ecd782ae904d"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>420</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U bent verplicht een situatietekening van de verkeersomleiding bij uw aanvraag toe te voegen. Voegt u hier de situatietekening van deze verkeersomleiding toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[U hoeft hier niet apart een tekening voor aan te leveren als u de verkeersomleiding meeneemt in de situatietekening van de plaatsing van het object.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_3656b283-b133-41ec-b1dd-a606ab3097e3">
                <inter:naam>Maatregel: Fotografisch materiaal ontwikkelen of afdrukken (verbeterd en omgezet naar PROD)_Eindhoven</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>

            <dmn:text><![CDATA[not(null)]]></dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_412bd204-2927-462f-93cc-fc79c80a44db">
                    <dmn:extensionElements>
                <content:conclusieToelichting>
                    <content:toelichting><![CDATA[Als het niet gaat om een gemeentelijk monument of eventueel toekomstig gemeentelijk monument, dan is deze activiteit niet van toepassing.]]></content:toelichting>
                </content:conclusieToelichting>
            </dmn:extensionElements>
                <dmn:text><![CDATA["NietVanToepassing"]]></dmn:text>
    </dmn:outputEntry>

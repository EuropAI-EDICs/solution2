        <dmn:output id="_5224c14a-2868-4ac8-a1dd-2d2dc28b9950" label="aanpassing aan gemeentelijk monument"/>
            <dmn:rule id="_7975ae03-8f55-4c05-b56b-1e7bff679b1c">
            <dmn:inputEntry id="_9f56e48b-ae66-43ef-b5b9-4d59e9daef3e">
            <dmn:text><![CDATA["Vergunningplicht"]]></dmn:text>
        </dmn:inputEntry>
            <dmn:inputEntry id="_6eb86fc7-4005-483b-bee6-8f999d0918ab">
            <dmn:text><![CDATA[not(null)]]></dmn:text>
        </dmn:inputEntry>
            <dmn:inputEntry id="_47e5e24f-ce02-4bc2-865b-4826015d8f7d">
            <dmn:text><![CDATA[not(null)]]></dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_6cda9774-c7df-4c57-b411-5d93104c593b">
                    <dmn:extensionElements>
                <content:conclusieToelichting>
                    <content:toelichting><![CDATA[U heeft een omgevingsvergunning nodig voor het slopen, verstoren, verplaatsen of in enig opzicht wijzigen van een gebouwd of aangelegd monument, of voor het zodanig herstellen of (laten) gebruiken dat het wordt ontsierd of in gevaar gebracht.

U kunt er ook voor kiezen om eerst een [principeaanvraag (vooroverleg)](https://www.nieuwegein.nl/inenomhethuis/principeaanvraag-vooroverleg "Ga naar Principeaanvraag (vooroverleg)") in te dienen. Op basis van uw schets en foto's kijken wij of de aanvraag haalbaar is. U hoeft nog geen officiële tekeningen mee te sturen.]]></content:toelichting>
                </content:conclusieToelichting>
            </dmn:extensionElements>
                <dmn:text><![CDATA["Vergunningplicht"]]></dmn:text>
    </dmn:outputEntry>
</dmn:rule>
            <dmn:rule id="_5324d67d-f881-444e-b99e-c238e4050772">
            <dmn:inputEntry id="_8bfc86b9-6c29-4ccc-a744-65ef40fbde4d">
            <dmn:text><![CDATA[not(null)]]></dmn:text>
        </dmn:inputEntry>

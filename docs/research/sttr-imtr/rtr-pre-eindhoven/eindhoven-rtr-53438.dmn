        <dmn:decisionTable hitPolicy="RULE ORDER" id="_790ed88c-a3b7-4505-b9fc-65239b524dbe" outputLabel="aanpassing aan gemeentelijk monument">
            <dmn:input id="_fcbc64d9-1792-43fe-8650-0ed378103f2e" label="Vergunningplicht">
            <dmn:inputExpression typeRef="feel:string">
                <dmn:text>Vergunningplicht</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_e8a72ccd-c75e-4071-bc14-31487502617f" label="NietVanToepassing">

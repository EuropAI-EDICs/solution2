                    <dmn:extensionElements>
                        <content:conclusieToelichting>
                            <content:toelichting><![CDATA[Onder punt 2 van de actielijst staat dat er aanvullende informatie nodig is om te beoordelen of u voldoet aan de regels. Omdat u in uw situatie geen vergunning nodig hebt is dat toch niet nodig.

Mocht u zelf vragen hebben, kunt u natuurlijk toch contact met ons opnemen. Onze contactgegevens vindt u ook op deze pagina onder 2 en onder 4.]]></content:toelichting>
                        </content:conclusieToelichting>
                    </dmn:extensionElements>
                    <dmn:text>"Toestemmingsvrij"</dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
        </dmn:decisionTable>

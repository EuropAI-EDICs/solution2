        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__334346ff-ce75-40c2-8aec-953df52bad2c">
                <uitv:regelgroepRef href="#_d433c722-f03c-4cfa-8715-5c7e10508003"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Betreft het werkzaamheden aan een openbaar telecomnetwerk?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, het betreft werkzaamheden aan een openbaar telecomnetwerk]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:toelichting><![CDATA[Let op, hiermee vraagt u een instemmingsbesluit aan volgens de Telecomwet.]]></content:toelichting>
                                <content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, het betreft geen werkzaamheden aan een openbaar telecomnetwerk]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Andere optie]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__09a5f371-8d9f-4a79-abb9-645149f3d680">
                <uitv:regelgroepRef href="#_d433c722-f03c-4cfa-8715-5c7e10508003"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[namelijk:]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__53706bfb-57ce-4594-ad08-0ff2bb52532f">
                <uitv:regelgroepRef href="#_e6d2dcab-3fd8-4eb5-be7a-1f9cfa25ea4c"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wordt er een boortechniek toegepast?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, er wordt een boortechniek toegepast]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:toelichting><![CDATA[Tekening(en) en relevante informatie hierover kunnen bij Documenten worden toegevoegd aan het einde van de aanvraag.]]></content:toelichting>
                                <content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, er wordt geen boortechniek toegepast]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Onder boortechnieken vallen Pilot boring, boogzinker, nano-drilling en front boring (open/gesloten).

Let op, staalpersingen en raketpersingen vallen niet onder boortechnieken.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__03844bb9-e31a-4407-9190-46dbbcd7bff7">
                <uitv:regelgroepRef href="#_e6d2dcab-3fd8-4eb5-be7a-1f9cfa25ea4c"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan om welke werkzaamheden het gaat]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Aanleggen]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Verleggen]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ruimen]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>4</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Vervangen]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>5</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Overige]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f139154d-06dc-4a9d-9dfd-7b5d19354e70">

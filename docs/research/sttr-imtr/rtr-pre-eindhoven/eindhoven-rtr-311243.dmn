                        <uitv:optie>
                            <uitv:sequenceId>6</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Anders, de gegevens van de financiële contactpersoon zijn:]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Deze persoon is het aanspreekpunt voor aanlevering van de financiële gegevens op basis waarvan de gemeente kosten kan factureren.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>

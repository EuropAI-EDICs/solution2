            <uitv:uitvoeringsregel id="uitv__91027e01-14ec-4474-b395-b13b6476423b">
                <uitv:regelgroepRef href="#_e6d2dcab-3fd8-4eb5-be7a-1f9cfa25ea4c"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er sprake van een wegafzetting?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de weg wordt helemaal afgezet]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de weg wordt gedeeltelijk afgezet]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[nee, er hoeft geen wegafzetting te komen]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit geldt ook voor afsluiting van fiets- en/of voetpaden.

Is uw antwoord ja, voeg dan (later) bij deze melding als bijlage het goedgekeurde verkeersplan toe.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__009d8b55-d863-4abf-8759-6318ebd553ed">
                <uitv:regelgroepRef href="#_e2a87449-9555-4cf8-a15f-147be98a220f"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>number</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef de lengte van het tracé in hele meters.]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Rond het getal af op hele meters.

De tracétekening en relevante informatie dienen bij Documenten te worden toegevoegd aan het einde van deze aanvraag.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1d68dbf1-eac0-45e5-b84e-14a0ab9962d3">
                <uitv:regelgroepRef href="#_e2a87449-9555-4cf8-a15f-147be98a220f"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>number</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef de breedte van het tracé in hele centimeters.]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[**Let op** hier vragen wij, anders dan bij de vraag over de lengte van de tracé, centimeters en **niet** meters!

De tracétekening en relevante informatie dienen bij Documenten te worden toegevoegd aan het einde van deze aanvraag.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6a9b7001-089a-4640-bbc3-9423e83d596f">
                <uitv:regelgroepRef href="#_73e81aaa-b1fb-4e0e-b2c8-cfbb91a5d8df"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>130</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wie is de netwerkeigenaar?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Aanvrager]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Anders, de gegevens van de netwerkeigenaar zijn:]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De netwerkeigenaar is eigenaar van een kavel of leidingennetwerk en verantwoordelijk voor het beheer en onderhoud daarvan.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

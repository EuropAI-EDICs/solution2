            <uitv:uitvoeringsregel id="uitv__dd0cd993-ab99-4b72-908c-4cb476b4c3eb">
                <uitv:regelgroepRef href="#_e6d2dcab-3fd8-4eb5-be7a-1f9cfa25ea4c"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat is de geplande uitvoeringsperiode?]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit mag een globale omschrijving zijn zoals bijvoorbeeld: "in Q3 van 2026" of "periode november-december 2026" en zo voorts.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__20cb09d0-2ec8-49a5-a0fb-f2d16e0bcf08">

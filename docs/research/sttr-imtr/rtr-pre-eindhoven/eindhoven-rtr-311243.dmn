                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef een beschrijving van de werkzaamheden die worden uitgevoerd.]]></uitv:vraagTekst>

            <inter:regelgroep id="_26b07113-100a-40b6-ab99-ec0abb2cdd3a">
                <inter:naam>Maatregel: Afvalwater, afkomstig van het maken van betonmortel, lozen in het riool of op of in de bodem (verbeterd en omgezet naar PROD)_Eindhoven</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>

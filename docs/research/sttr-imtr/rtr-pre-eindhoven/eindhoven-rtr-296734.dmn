<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:ns10="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Uitvoeringsregel" xmlns:ns11="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Content" xmlns:ns12="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Interactieregel" xmlns:ns13="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Boom kappen of houtopstand vellen" id="_f513d395_dc9b_424c_8a4b_d98cb69a5437" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <bedr:sttr versie="2"/>
        <inter:regelgroepen>
            <inter:regelgroep id="_95e41e37_8174_4817_b46f_9f7899c53ea0">
                <inter:naam>bomenkap</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__e814e4ac_aaed_4eea_9ad3_a7ce7dcc5613">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Welke situatie past het beste bij wat u wilt doen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik heb een boom met een plantenziekte]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Het gaat hierbij om een plantenziekte die zich kan verspreiden. Het maakt niet uit of de boom nog in de tuin staat, of dat deze al gekapt is, u delen van deze boom opslaat of delen ervan vervoert.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik wil een boom kappen]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Het kappen van een boom is hetzelfde als het vellen van een boom.

In de wet wordt nog gesproken van vellen. Vellen als bedoeld in de omgevingswet: het rooien of verrichten van andere handelingen die de dood of ernstige beschadiging van een houtopstand (boom) tot gevolg kunnen hebben.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik wil een boom snoeien]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>4</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik wil een boom verplaatsen]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Dit wordt ook wel verplanten genoemd.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>5</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik wil een boom voor het eerst op een speciale manier snoeien, waarbij alleen de dikke takken overblijven]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Dit noemen we ook wel kandelaberen en/of kandelaren.

Kandelaberen is het (terug)snoeien tot op de hoofdtakken van een boom, alle gesteltakken worden tot tussen de 35 en 50% van de taklengte ingekort, resterende takken worden kort gezet.

Onder “kandelaberen” wordt in de verordening bomen 2024 ook “kandelaren” verstaan.

Kandelaren is het (terug)snoeien tot op de hoofdtakken van een boom, alle gesteltakken worden tot tussen de 50% en 75% van de taklengte ingekort, resterende takken worden kort gezet.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Wij spreken in deze vergunningcheck vaker over een boom. Waar u boom leest kan het ook gaan om een houtopstand. Een houtopstand als bedoeld in de Omgevingswet is een zelfstandige eenheid van bomen, boomvormers, struiken, hakhout of griend.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a2da6cf2-2ec3-4e36-b5c4-aab54ba3b070">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat is de reden van het kappen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Voor natuurbehoud]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Groene redenen om een boom te kappen zijn groene beheermaatregelen of maatregelen ten gunste van natuur, te behouden bomen, of te kappen bomen als gevolg van onrechtmatige hinder.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Voor een bouwplan of project]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Dit noemen we kappen met een rode reden. Rode redenen om een boom te kappen zijn redenen die gelinkt zijn aan bouwontwikkelingen of aan financiële compensatie. Denk aan sloop-, bouw-, uitbouw- of verbouwwerkzaamheden, aanleg van parkeerplaatsen of kunstgrasveld, vervanging van riolering, civieltechnische werkzaamheden, aanleg van uitwegen, uitbouwen van woningen en opstallen.

Anders gezegd zijn het redenen voor het kappen van de boom, die niets te maken hebben met het beheer van bomen. In deze situaties moeten de te kappen bomen worden gecompenseerd. Dit mag fysiek door een nieuwe boom te planten of financieel.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Voor een andere reden]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Valt de reden van het kappen niet onder reen groene of rode reden? Dan noemen we dit kappen met een oranje reden. Oranje redenen zijn redenen die niet gelinkt zijn aan bouwontwikkelingen. Denk aan herindeling van een tuin, maar ook vellen van bomen met een lage levensverwachting of die gevaar opleveren. Voor oranje redenen geldt wel een compensatieplicht, alleen is taxatie en boomonderzoek niet nodig. Voor iedere boom wordt minimaal een boom terug geplant op het perceel die vergelijkbaar is in grootte (wanneer volgroeid) en ecologische waarde (bijvoorbeeld uit de lijst van 40 van 040). Financiële compensatie is niet mogelijk bij oranje reden.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Twijfelt u? Kies de optie die het beste past bij uw situatie.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c937dd3f_7382_436b_a19a_cab1d28302c5">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om een boom die verplicht is geplant of moet blijven staan?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dat is bijvoorbeeld het geval als:

-   De boom verplicht is geplant als onderdeel van een vergunning die verleend is voor de kap van een andere boom;
-   De boom moest worden geplant als compensatie voor een bouwproject.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a3eedfe9_4f58_46be_a078_6d9c20ea32a3">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is de stam van de boom op 130 centimeter hoogte 45 centimeter of meer in omtrek?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Meet de stam op 1,30 meter boven de grond, op het smalste punt van de stam. Gebruik hiervoor bijvoorbeeld een meetlint. Een omtrek van 45 centimeter of meer is gelijk aan ongeveer 15 centimeter aan doorsnede.

Sommige bomen hebben meer dan één stam. Meet in dat geval alleen de dikste stam.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ba2da336-1879-44d9-bd2b-f282332edaea">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om normaal onderhoud van een vormboom, zoals jaarlijks snoeien van een leiboom of een knotboom?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het jaarlijks snoeien van bijvoorbeeld een leiboom, zodat deze zijn vorm vorm behoudt valt onder normaal onderhoud. De boom wordt hierdoor niet (zwaar) aangetast, maar zorgt er juist voor dat deze het volgende jaar weer tot bloei kan komen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__cd265b5d_afa9_4812_891a_96fcaffe55ef">
                <uitv:regelgroepRef href="#_95e41e37_8174_4817_b46f_9f7899c53ea0"/>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u meer dan 30% van de kroon (takken) of de wortels van de boom snoeien?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Met de kroon bedoelen we alle takken en bladeren van de boom.

Een paar takken weghalen is meestal minder dan 30%. Veel takken of grote delen snoeien is vaak meer dan 30%.Twijfelt u hoeveel 30% is? Kies dan ‘ja’ als u van plan bent om de boom flink te snoeien.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

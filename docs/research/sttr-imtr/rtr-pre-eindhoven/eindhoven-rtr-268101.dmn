    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_4c23f784-6cbc-4c5f-a513-471ced4ddba8">
                <inter:naam>Maatregel: Elektriciteit opwekken met een windturbine die slagschaduw of lichtschittering veroorzaakt (verbeterd en omgezet naar PROD)_Eindhoven</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>

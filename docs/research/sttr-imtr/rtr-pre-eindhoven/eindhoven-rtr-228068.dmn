                 name="Indieningsvereisten Vergunning Werk niet zijnde bouwwerk of werkzaamheid uitvoeren">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="_cb8d283f-beab-47ef-ba8e-29b8fb64082d">
    <inter:naam>Diverse vragen</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_ea4959e0-81e7-48f6-908c-ba5934b3c116">
    <inter:naam>Algemene bijlagen</inter:naam>
    <inter:prioriteit>20</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__f0dc4612-a859-4fd7-992a-98f4b7965164">
        <uitv:regelgroepRef href="#_cb8d283f-beab-47ef-ba8e-29b8fb64082d"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Geef aan welke materialen u gaat gebruiken.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__f826ff16-7946-4576-8436-a36f19d8eb57">
        <uitv:regelgroepRef href="#_cb8d283f-beab-47ef-ba8e-29b8fb64082d"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>20</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Gaat u grond afvoeren naar een andere locatie?</uitv:vraagTekst>
        </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__9a69c5a8-c834-4d98-b26d-1d9dc0a5de0f">
        <uitv:regelgroepRef href="#_cb8d283f-beab-47ef-ba8e-29b8fb64082d"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>30</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Geef aan hoeveel grond (in kubieke meter) u gaat afvoeren naar een andere locatie.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__24e9b829-fa71-4b7f-97d4-bc3c4f4825e2">
        <uitv:regelgroepRef href="#_cb8d283f-beab-47ef-ba8e-29b8fb64082d"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>40</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Zijn er obstakels aanwezig die in de weg staan voor het uitvoeren van het werk of de werkzaamheid? Beschrijf dan de obstakels die in de weg staan.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Obstakels zijn bijvoorbeeld bomen, lantaarnpalen en nutsvoorzieningen (zoals transformatorhuisjes, flitspalen of buspoortjes).]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__8b2ca0bd-133d-4553-91b3-e9ca0bf1ce97">
        <uitv:regelgroepRef href="#_ea4959e0-81e7-48f6-908c-ba5934b3c116"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>50</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Locatie van de werkzaamheden</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: een situatietekening van de locatie waar u het werk of de werkzaamheden gaat uitvoeren.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[Een situatietekening is een getekende kaart van de omgeving van de locatie van de werkzaamheden. De locatie is van bovenaf gezien en duidelijk herkenbaar aangegeven.

Hieronder staat welke gegevens de situatietekening moet bevatten.

*   noordpijl
*   duidelijke maatvoering en schaalaanduiding (aanduiding met maatlijn)
*   formaat van de tekening (minimaal A4, maximaal A1)
*   datum van de eerste opstelling van de tekening
*   datum van de laatste wijziging van de tekening
*   ondergrond van voldoende kwaliteit (bijvoorbeeld grootschalige basiskaart van Nederland, kadastrale kaart)
*   grens van de locatie
*   dichtstbijzijnde openbare weg
*   dichtstbijzijnde woonbebouwing
*   functie van de aangrenzende percelen]]></content:langeToelichting>
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__656aac06-5f0c-44a7-9496-c2014efa1303">
        <uitv:regelgroepRef href="#_ea4959e0-81e7-48f6-908c-ba5934b3c116"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>60</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Rapport archeologische waarde</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Staat er in het omgevingsplan dat de locatie waar u de werkzaamheden wilt gaan verrichten naar verwachting archeologische waarde heeft? En staat er in het omgevingsplan dat u een rapport van een archeologisch vooronderzoek moet aanleveren waarin de archeologische waarde van de locatie voldoende is vastgesteld? Voeg dit rapport dan toe als bijlage.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[##### Waarvoor is dit rapport nodig?

De gemeente moet op basis van het rapport voldoende inzicht krijgen in de exacte impact van de werkzaamheden op de archeologische waarde. In die gevallen dat de archeologische waarde eerder al voldoende is vastgesteld, zal dit rapport niet nodig zijn.

Het rapport moet zijn opgesteld volgens de normen van de archeologische beroepsgroep. Als voor het archeologisch (voor)onderzoek bodemverstorende handelingen vereist zijn, moet het archeologisch bedrijf dat dit onderzoek verricht hiervoor gecertificeerd zijn.]]></content:langeToelichting>
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__6b54c301-fb72-4059-94f8-f61c06d6bed3">
        <uitv:regelgroepRef href="#_ea4959e0-81e7-48f6-908c-ba5934b3c116"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>70</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Zijn er nog andere gegevens belangrijk bij de beoordeling van uw aanvraag? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        

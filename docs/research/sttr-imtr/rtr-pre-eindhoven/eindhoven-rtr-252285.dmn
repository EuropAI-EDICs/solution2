<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Indieningsvereisten Vergunning Bouwwerk slopen" id="_32a75d14_4b70_4f74_b54e_26febcc81dcf" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_21a93794-25fe-40ea-aedc-914bfabfda66">
                <inter:naam>Vragen over een vervangend bouwwerk</inter:naam>
                <inter:prioriteit>10</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_7ff0d17e-210a-4041-b133-a03f721fa532">
                <inter:naam>Bijlagen</inter:naam>
                <inter:prioriteit>150</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__16f4bc4c-37bf-4bd6-9d68-ea04e7e7f575">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat er op de locatie van het te slopen bouwwerk een vervangend bouwwerk gebouwd worden?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[**Let op!** Wilt u een bouwwerk slopen in een **gemeentelijk beschermd of rijksbeschermd stads- of dorpsgezicht**? Doe dan een aanvraag voor de activiteit 'Bouwwerk slopen in een gemeentelijk beschermd of rijksbeschermd stads- of dorpsgezicht'.

Wilt u een **monument** slopen? Doe dan een aanvraag voor de activiteit 'Activiteit die betrekking heeft op een gemeentelijk monument'. Of iets een gemeentelijk monument is, kunt u opzoeken in het monumentenkaart. Deze vind u op onze site ([Monumenten | Gemeente Eindhoven](https://www.eindhoven.nl/stad-en-wonen/stad/erfgoed/monumenten?search=monument)). In de omschrijving van het monument staat om welke onroerende zaak/onroerende zaken of welk terrein het gaat.

Doe eerst **de vergunningcheck** voor u een aanvraag doet als u niet zeker bent van de activiteit.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__031a49fe-a61f-4be2-9348-2cbf35ca9391">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Heeft u een omgevingsvergunning voor het bouwen van een vervangend bouwwerk?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat is het kenmerk van deze omgevingsvergunning?]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9edb798e-5c7d-4405-aab7-59f8a3311d8c">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Heeft u wel een omgevingsvergunning voor een vervangend bouwwerk aangevraagd?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__4f0a733b-1a7f-421c-b881-f572b207dbd4">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat is het kenmerk van uw aanvraag?]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f256913e-9fef-42e0-8617-db6cff911491">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Heeft u vergevorderde plannen voor een vervangend bouwwerk?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ba661b0a-dec0-4b5f-a266-af3849ba0af7">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>date</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wanneer bent u van plan hiervoor een omgevingsvergunning aan te vragen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__59093418-96ec-47ed-979d-dd791aa7af2f">
                <uitv:regelgroepRef href="#_21a93794-25fe-40ea-aedc-914bfabfda66"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Vervangend bouwwerk]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Geef duidelijk aan wat de plannen zijn om het vervangende bouwwerk te bouwen. Voeg bijvoorbeeld de vergevorderde bouwplannen als bijlage toe.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__0ab51eec-4011-4045-b41a-dcfa5c80de71">
                <uitv:regelgroepRef href="#_7ff0d17e-210a-4041-b133-a03f721fa532"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voeg een tekening toe waarop u aangeeft welke delen van het bouwwerk worden gesloopt.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Voeg als bijlage toe: een tekening waaruit blijkt wat wordt gesloopt.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[De tekening slopen moet de volgende gegevens bevatten:

*   het bouwwerk of de delen van het bouwwerk dat wordt gesloopt
*   duidelijke maatvoering en schaalaanduiding (aanduiding met maatlijn)
*   noordpijl
*   datum van de eerste opstelling van de tekening
*   datum van de laatste wijziging van de tekening
*   ondergrond van voldoende kwaliteit (bijvoorbeeld grootschalige basiskaart van Nederland, kadastrale kaart)
*   dichtstbijzijnde openbare weg
*   dichtstbijzijnde bebouwing]]></content:langeToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f9a99a0c-bd3f-4407-ac1d-f61fb7f50707">
                <uitv:regelgroepRef href="#_7ff0d17e-210a-4041-b133-a03f721fa532"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Overige gegevens noodzakelijk voor toetsing aan omgevingsplan]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan hiervoor al gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1d75e3cd-7d53-4a68-9740-bfd0b7775688">
                <uitv:regelgroepRef href="#_7ff0d17e-210a-4041-b133-a03f721fa532"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Overige bijlagen die u wilt toevoegen?]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

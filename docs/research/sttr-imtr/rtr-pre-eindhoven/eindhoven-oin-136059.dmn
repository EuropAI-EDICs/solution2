                 name="Bouwwerk slopen">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="groep1">
    <inter:naam>Bouwwerk slopen Gemeente Tilburg</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__71f4bf29-7ed2-43e8-b1af-7b5c3f79c21a">
        <uitv:regelgroepRef href="#groep1"/>
        <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Is er in het omgevingsplan een dubbelbestemming Waarde - Cultuurhistorie opgenomen op uw perceel?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Weet u het antwoord op deze vraag niet? Kijk dan eerst bij regels op de kaart.

Alleen binnen de dubbelbestemming waarde-cultuurhistorie zijn regels opgenomen over het slopen van bouwwerken. Indien het te slopen bouwwerk niet binnen deze dubbelbestemming ligt kunt u de vraag met nee beantwoorden.

Neem bij twijfel contact op met de gemeente.]]></content:toelichting>
    
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__cf15c4c7-8ee9-47d7-a2f3-8a2401cf3246">
        <uitv:regelgroepRef href="#groep1"/>
        <inter:prioriteit>20</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Op uw perceel is de dubbelbestemming Waarde - Cultuurhistorie van toepassing. Is er in de regels van deze dubbelbestemming een vergunningplicht voor de gewenste sloopwerkzaamheden opgenomen?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Weet u het antwoord op deze vraag niet? Kijk dan eerst bij regels op de kaart.

Alleen binnen de dubbelbestemming waarde-cultuurhistorie zijn regels opgenomen over het slopen van bouwwerken. U kunt in de regels van deze dubbelbestemming nagaan of er vergunning nodig is voor de gewenste sloopwerkzaamheden. Deze vindt u in het artikel met betrekking tot "werken en werkzaamheden". Sommige sloopwerkzaamheden zijn uitgezonderd van de vergunningplicht. Als dit het geval is, staat dit in de regel met betrekking tot slopen.

Neem bij twijfel contact op met de gemeente.]]></content:toelichting>
    
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        

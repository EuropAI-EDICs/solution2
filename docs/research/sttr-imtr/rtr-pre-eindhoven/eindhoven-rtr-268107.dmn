            <dmn:requiredDecision href="#_307866b6_4a49_453f_8899_7cb5f1dd1bb2"/>
        </dmn:informationRequirement>
        <dmn:decisionTable hitPolicy="COLLECT" outputLabel="Geluid veroorzaakt door windturbines en windparken" id="_c7489b6c_367b_44b9_914a_e19d12b05e49_dt">
            <dmn:input>
                <dmn:inputExpression typeRef="string">
                    <dmn:text><![CDATA[Maatregelen relevant_Uitkomst maatregelen]]></dmn:text>
                </dmn:inputExpression>
            </dmn:input>
            <dmn:output name="Voorschriften" typeRef="string" id="_6bcd5070_64a4_49ae_82d7_34ae8cde838a"/>

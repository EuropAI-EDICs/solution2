    <dmn:decision name="Geluid veroorzaakt door windturbines en windparken" id="_c7489b6c_367b_44b9_914a_e19d12b05e49">
        <dmn:extensionElements>
            <bedr:functioneleStructuurRef href="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000/id/concept/Maatregelennl.imow-gm0772.activiteit.GeluidProdWindturbine"/>
        </dmn:extensionElements>

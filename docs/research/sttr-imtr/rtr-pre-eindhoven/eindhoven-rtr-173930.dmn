  <semantic:decision id="_24122_BizRule" name="starten veranderen vergunning CR">
    <semantic:variable id="_24122_BizRule_var" name="starten veranderen vergunning CR" typeRef="feel:boolean" />
    <semantic:informationRequirement>
      <semantic:requiredInput href="#_34537_Concept" />
    </semantic:informationRequirement>
    <semantic:decisionTable id="_24122_BizRule_td" hitPolicy="FIRST" outputLabel="starten veranderen vergunning CR">
      <semantic:input id="_4826405">
        <semantic:inputExpression typeRef="feel:string">
          <semantic:text>starten veranderen vergunning UR</semantic:text>
        </semantic:inputExpression>
      </semantic:input>
      <semantic:output id="_5486601" />
      <semantic:rule id="_8220922">
        <semantic:inputEntry id="_4855036">
          <semantic:text>if ?=null then false else contains(?,"Starten van een nieuwe activiteit") or contains(?,"Veranderen of uitbreiden van een activiteit waarvoor u al een vergunning heeft")</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_2439390">
          <semantic:text>true</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>

                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__2e317952-62a5-477b-964c-69ca8ba7e0c0">
                <uitv:regelgroepRef href="#_fb502225-ba2b-4b78-b703-3ccf207e40ed"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>450</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om werkzaamheden die meer dan 10 m2 omvatten]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let op: is het antwoord ja, dan moet u ook alsnog een vergunning aanvragen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>

        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>50</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Aanleggen of veranderen van een Rijksweg of provinciale weg: Gaat het om een weg die buiten de bebouwde kom ligt?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Het gaat hier om de wegen inclusief de daarbij horende bruggen, viaducten en andere kunstwerken\.]]></content:toelichting>

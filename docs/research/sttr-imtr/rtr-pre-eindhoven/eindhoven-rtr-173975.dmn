      <inter:regelgroep id="_4683_RuleGroup">
        <inter:naam>Regenwater lozen in het riool of op of in de bodem</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_18252_BizRule">
        <uitv:regelgroepRef href="#_4683_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u regenwater lozen dat afkomstig is van een vloer die de bodem beschermt tegen stoffen die de bodem kunnen verontreinigen?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Gaat het hier om het lozen van regenwater dat afkomstig is van een lekbak, een vloeistofdichte vloer of een vloer die gemorste of gelekte vloeistof een tijdje tegenhoudt? Kies hier dan voor Ja\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_19937_BizRule">

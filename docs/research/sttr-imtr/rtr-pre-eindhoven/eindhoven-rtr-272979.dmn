            <uitv:uitvoeringsregel id="uitv__ae05a900-1d09-4890-afa7-0adaf4b75b76">
                <uitv:regelgroepRef href="#_2dc4e0ee-40ab-4cdb-a214-ce1abdc8335b"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>250</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Heeft de woning/ het pand in de nieuwe situatie een of meer balkon(s) of dakteras(sen)?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Bij woningsplitsing beoordelen wij of de aanwezigheid van balkons en/of dakterrassen niet leidt tot een ontoelaatbare aantasting van de privacy van aangrenzende woonpercelen.  
Geef op de plattegrondtekening die u in een vervolgstap moet indienen aan waar het balkon en/of dakterras zit.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__aad744f8-bfd7-4cd2-8b36-dfc157cf5aac">
                <uitv:regelgroepRef href="#_2dc4e0ee-40ab-4cdb-a214-ce1abdc8335b"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>260</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn de scheidingswanden met de buren uitgevoerd als ankerloze spouwmuren?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Is het antwoord nee, geef dan op de plattegrondtekening in de vervolgstap duidelijk aan welke maatregelen u treft om geluidshinder te voorkomen.  
Een voorbeeld van een maatregel is het plaatsen van een voorzetwand.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a3a8cc10-3e47-4715-9fe2-d9244019935f">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>270</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Lever een situatietekening met minimaal 2 straten aan]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit kan bijvoorbeeld een kadastraal kaartje zijn.  
Zorg ervoor dat de tekening op schaal is, of is voorzien van maten. Zo voorkomt u dat uw aanvraag vertraging oploopt.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__29efe5b9-ffba-4c22-9dbc-f7df7681b4f4">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>280</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Lever een situatietekening van parkeermogelijkheden voor fiets en auto op eigen terrein aan.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Zorg ervoor dat de tekening op schaal is, of is voorzien van maten. Zo voorkomt u dat uw aanvraag vertraging oploopt.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__76cc38e6-c451-450f-be60-2bed022e4d97">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>290</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Lever het resultaat van de rekentool parkeernormen aan]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Deze is te vinden via de volgende link: [Parkeernormen Portaal Gemeente Eindhoven](https://parkeernota.eindhoven.nl/)]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__b303a897-5a1a-4e97-b413-3cd2e8a791b0">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>300</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Een plattegrondtekening van de bestaande legale situatie.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Geeft u hierop de verschillende functieaanduidingen van de ruimtes (zoals woonkamer, slaapkamer, keuken, badkamer/douche, toilet, berging) aan.  
Zorg ook hier ervoor dat de tekening op schaal is of is voorzien van maten.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__b3e24b1b-628d-4212-a668-9950c03d0874">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>310</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Een plattegrondtekening van de nieuwe situatie.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In het geval van __kamerbewoning__: Geeft u hierop de verschillende functieaanduidingen aan van de ruimtes (zoals: kamer 1, kamer 2 enz, met daarbij vermeld de gezamenlijke ruimtes zoals woonkamer, keuken(blok), badkamer/douche, toilet, berging).  
In het geval van __woningsplitsing__: Geeft u hierop de verschillende functieaanduidingen van de ruimtes (zoals: woning 1/studio 1, woning 2/studio 2 enz, met daarin vermeld woonkamer, slaapkamer, keuken(blok), badkamer/douche, toilet, berging) aan.  
Zorg ook hier ervoor dat de tekening op schaal is én is voorzien van alle maten.  
Let u ook op dat u op de tekening ook alle geluidswerende maatregelen duidelijk aangeeft.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__421fa849-38d1-46ce-af0f-eadfda2703fb">
                <uitv:regelgroepRef href="#_41a9011f-4f87-4e0b-b17e-b649eae27bfe"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>320</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Overige stukken die van belang zijn bij de beoordeling van uw aanvraag]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit kan ook een toelichting zijn op uw situatie als u hier behoefte aan hebt. Stel dit dan in Word of PDF op en voeg uw toelichting hier als bijlage toe.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

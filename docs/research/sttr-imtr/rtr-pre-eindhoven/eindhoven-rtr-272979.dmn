<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Indieningsvereisten Vergunning kamerbewoning woningsplitsing" id="_78007419_6719_45b6_b5a8_3548c962fb2b" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_d41911a1-95ea-49be-8f85-6f174758b901">
                <inter:naam>Algemeen</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_af30163e-f101-498c-b4d1-df35dcd15eff">
                <inter:naam>Kamerbewoning</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_2dc4e0ee-40ab-4cdb-a214-ce1abdc8335b">
                <inter:naam>woningsplitsing</inter:naam>
                <inter:prioriteit>3</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_41a9011f-4f87-4e0b-b17e-b649eae27bfe">
                <inter:naam>Benodigde bijlagen voor uw aanvraag</inter:naam>
                <inter:prioriteit>4</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__588108e9-dc94-4b3a-88c9-8c1930f5c1f0">
                <uitv:regelgroepRef href="#_d41911a1-95ea-49be-8f85-6f174758b901"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan waar u een aanvraag voor wilt indienen]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kamerbewoning]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Let u op dat in een kamer in beginsel maximaal één persoon wordt gehuisvest\*]]></content:toelichting>
<content:langeToelichting><![CDATA[\*Met het begrip ‘in beginsel’ wordt niet bedoeld dat een bewoner nooit een vriend/vriendin mag laten slapen/logeren, zoals dat wel eens gebeurt. Met deze voorwaarde dient voorkomen te worden dat kamers min of meer structureel dubbel bezet worden, waardoor de ruimtelijke effecten voor de omwonenden/buurt extra belastend zijn.]]></content:langeToelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[woningsplitsing]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Wanneer een woonruimte over alle woonvoorzieningen beschikt is nooit sprake van een kamer (onzelfstandige woonruimte). Er is dan sprake van een zelfstandige woonruimte zoals een appartement, studio of woning.

Gaat u (ver)bouwen om dit te realiseren, houdt u er dan rekening mee dat u ook mogelijk een vergunning moet aanvragen voor de bouwactiviteit. Doorloop in dit geval ook de vergunningcheck voor de werkzaamheid ‘bouwwerk veranderen’ om te weten of u ook voor het veranderen van uw woning een aparte vergunning moet indienen.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let u op dat de woning/het pand niet in een van de op-slot-gebieden [Limbeek-Noord](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Limbeek-Noord&location=16,51.44857,5.46379&basemap=jawg.light "(opent in een nieuw venster)"), [Limbeek-Zuid](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Limbeek-Zuid&location=17,51.44437,5.46818&basemap=jawg.light "(opent in een nieuw venster)"), [Bennekel-Oost](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Bennekel-Oost&location=16,51.41957,5.46327&basemap=jawg.light "(opent in een nieuw venster)"), [Doornakkers-Oost](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Doornakkers-Oost&location=15,51.43864,5.51791&basemap=jawg.light "(opent in een nieuw venster)"), [Doornakkers-West](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Doornakkers-West&location=15,51.43945,5.50847&basemap=jawg.light "(opent in een nieuw venster)"), [Woensel-West](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtcode=421&location=15,51.45767,5.45744&basemap=jawg.light "(opent in een nieuw venster)"), [Hemelrijken](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Hemelrijken&location=16,51.44862,5.46998&basemap=jawg.light "(opent in een nieuw venster)"), [Gildebuurt](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Gildebuurt&location=16,51.44911,5.47472&basemap=jawg.light "(opent in een nieuw venster)") ligt, want dan krijgt u geen vergunning.  
__30 meter-regel__  
Met uitzondering van het [centrumgebied](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Binnenstad&refine.wijknaam=Wijk+Centrum&location=15,51.43806,5.48078&basemap=jawg.light "(opent in een nieuw venster)") en flatgebouwen geldt deze regel in heel de stad. Dit betekent simpel gezegd dat wanneer de woning binnen een straal van 30 meter valt van een al legaal gesplitste of verkamerde woning u geen vergunning krijgt.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[Zo beoordelen wij de straal van 30 meter:  
•De straal van 30 meter wordt gemeten vanuit het zwaartepunt van een bestaand kamersgewijs bewoond pand en/of bestaand gesplitste woning. Hierbij worden ook panden betrokken waarvoor al eerder een aanvraag is ingediend die nog in behandeling is.  
•Er kan in principe geen vergunning worden verleend voor panden die geheel of gedeeltelijk liggen binnen of geraakt worden door de cirkel met een straal van 30 meter zoals hierboven beschreven.  
•De cirkels/contouren gaan voor wat betreft bestaande kamergewijs bewoonde panden en/of bestaande gesplitste woningen uit van het zwaartepunt van die panden op 15 mei 2020. Bij aanvragen voor nieuwe situaties wordt het zwaartepunt van het pand bepaald zoals dat is ten tijde van de beslissing op de aanvraag, dit punt wijzigt daarna niet meer.  
•Een aanvraag voor een bestaand volledig legaal kamerverhuurpand waaraan één of meer kamers worden toegevoegd, wordt niet beoordeeld aan de hand van het 30 meter criterium.]]></content:langeToelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a3966da7-9447-4dbb-973c-044e49c1d2da">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om wat voor een gebouw gaat het in de legale bestaande situatie?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Woning]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Let op het gaat hier om de bestaande __legale__ situatie, deze kan anders zijn dan de feitelijk bestaande situatie. Als u hierover twijfelt of vragen heeft, neemt u dan contact met ons op.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Legaal kamersgewijs bewoond pand]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__42e71212-8cdf-4b4c-9d91-511e74263edd">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om hoeveel kamers gaat het in de legale bestaande situatie?]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9ab89081-ead4-46c9-a97f-cb452f2a42b8">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om hoeveel kamers gaat het in de nieuwe situatie?]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__32cbb44c-0fb2-48e6-96a5-ffab35cfffcf">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn de gezamenlijke voorzieningen toereikend?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Onder toereikende gezamenlijke voorzieningen wordt het volgende verstaan:  
• een gezamenlijke woonkamer (minimaal 7,5 m²),  
én  
• een gezamenlijke keuken (minimaal 5 m²).  
In plaats van een losse woonkamer en keuken kan er ook een woonkeuken gerealiseerd worden van minimaal 12,5 m².]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1085f011-b1e9-4655-957e-e131aa3631d4">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hebben de kamers gemiddeld een gebruiksoppervlak van minimaal 10 m2?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het gaat hier om de netto vloeroppervlakte van de niet gezamenlijke verblijfsruimten, binnenmaats gemeten op een hoogte van tenminste 1,50 meter.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ddc91c95-721a-424e-b6fc-738faad5780f">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hebben de kamers gemiddeld een gebruiksoppervlak van minimaal 14 m2?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het gaat hier om de netto vloeroppervlakte van de niet gezamenlijke verblijfsruimten, binnenmaats gemeten op een hoogte van tenminste 1,50 meter.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a627d0d0-cfa9-4d5e-9591-4eff85b70183">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Komt in iedere kamer daglicht binnen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit kan via één of meer ramen in de gevel of in het geval van een zolder mag dit ook in het dak zijn.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6c298f82-162b-44ce-88ca-a2ee0fbd3b9f">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn alle kamers rechtstreeks via de hoofdtoegang intern bereikbaar?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het is namelijk niet de bedoeling dat een kamer alleen van buitenaf bereikbaar is of dat iemand alleen via buiten de gemeenschappelijke voorzieningen kan bereiken.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__0d6c52ff-b889-4a65-b343-fcdb56358c50">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Heeft de woning/ het pand in de nieuwe situatie een of meer balkon(s) of dakteras(sen)?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Bij kamerbewoning beoordelen wij of de aanwezigheid van balkons en/of dakterrassen niet leidt tot een ontoelaatbare aantasting van de privacy van aangrenzende woonpercelen.  
Geef op de plattegrondtekening die u in een vervolgstap moet indienen aan waar het balkon en/of dakterras zit.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__634c68b3-95c3-43a6-b0de-083cc5e605ba">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>130</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn de scheidingswanden met de buren uitgevoerd als ankerloze spouwmuren?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Is het antwoord nee, geef dan op de plattegrondtekening in de vervolgstap duidelijk aan welke maatregelen u treft om geluidshinder te voorkomen.  
Een voorbeeld van een maatregel is het plaatsen van een voorzetwand.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__13c2dd05-ae6c-4183-8eb1-cdcc3e63dc3e">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>140</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er sprake van een maatregel om geluidshinder door het dichtslaan van de gemeenschappelijke voordeur in de nieuwe situatie te voorkomen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Een voorbeeld van een maatregel is het plaatsen van een goed afgestelde deurdranger op de gemeenschappelijke voordeur. Geef dit aan op de plattegrondtekening die u in een vervolgstap moet indienen.
Heeft u iets anders in gedachte om geluidsoverlast te voorkomen bij het dichtvallen van deze deur, dan is dat ook mogelijk. U moet dit dan wel duidelijk aangeven op de plattegrondtekening die u in een vervolgstap moet indienen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__8b07da3f-9e98-433b-ac1a-4aa97de61183">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>150</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn er binnen de woning één of meer traptreden aanwezig?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6a273827-565a-4f6d-a146-588f9587c8e3">
                <uitv:regelgroepRef href="#_af30163e-f101-498c-b4d1-df35dcd15eff"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>160</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Worden in de nieuwe situatie de traptreden voorzien van geluiddempende trapbekleding met brandklasse T3?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>

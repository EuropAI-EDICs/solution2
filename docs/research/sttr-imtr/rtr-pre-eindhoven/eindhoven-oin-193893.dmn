  <semantic:decision id="_16120_BizRule" name="Indieningsvereisten Informatieplicht - Starten uitvoeren GeluidProdAct">
    <semantic:variable id="_16120_BizRule_var" name="Indieningsvereisten Informatieplicht - Starten uitvoeren GeluidProdAct" typeRef="feel:boolean" />
    <semantic:informationRequirement>
      <semantic:requiredDecision href="#_de43b52e-7ebb-41cf-bc28-1410ae4d1234" />
    </semantic:informationRequirement>
    <semantic:informationRequirement>

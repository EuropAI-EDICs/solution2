<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:ns10="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Uitvoeringsregel" xmlns:ns11="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Content" xmlns:ns12="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Interactieregel" xmlns:ns13="http://toepasbare-regels.omgevingswet.overheid.nl/v2.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Indieningsvereisten Vergunning Boom kappen of houtopstand vellen" id="_9434437f_3058_4e4a_8d79_ae235a4c3eb7" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <bedr:sttr versie="2"/>
        <inter:regelgroepen>
            <inter:regelgroep id="_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e">
                <inter:naam>boomkap</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_74b90bc0-301a-4859-9060-e69bdf7ad8c3">
                <inter:naam>monumentale, waardevolle of veteranenboom</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_5498441f_b652_4afb_9fb7_9769bbe159aa">
                <inter:naam>Algemene bijlagen</inter:naam>
                <inter:prioriteit>3</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__974f377c-17a1-43e2-9de6-37514fe50bd4">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is de boom van u?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, deze is van mij]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, deze is van iemand anders]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Als de boom niet in uw bezit is moet u een schriftelijke toestemming van de eigenaar aanleveren om een vergunning aan te vragen. Voeg die in het volgende scherm toe.

Is de boom in het bezit van de gemeente, neemt u dan contact op met ons, via: [boombeheer@eindhoven.nl](mailto:boombeheer@eindhoven.nl)]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Wij spreken in dit aanvraagformulier vaker over een boom. Waar u boom leest kan het ook gaan om een houtopstand. Een houtopstand als bedoeld in de Omgevingswet is een zelfstandige eenheid van bomen, boomvormers, struiken, hakhout of griend.

Kijkt u op de bomenposter “werken rondom bomen” voor meer informatie over welke randvoorwaarden en eisen gelden bij werkzaamheden (dicht)bij bomen. Kijkt u hiervoor op [deze site](https://www.eindhoven.nl/kwaliteitscontrole) van ons. U vindt de poster onder de naam ‘bomenposter - werken rondom bomen’, u kunt daarvoor iets naar beneden scrollen of de naam zoeken (ctrl+F) op de site.

Voldoet u aan de randvoorwaarden en eisen zoals op de bomenposter vermeld, dan hebt u geen vergunning nodig.

Als nog niet duidelijk is of u volgens de bomenposter “werken rondom bomen” kunt handelen, geeft u dan bij deze vraag nee aan.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__8d613e7e-70c0-4579-aa17-70d556afa88b">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voegt u hier de schriftelijke toestemming van de eigenaar van de boom toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Omdat u niet zelf de eigenaar bent van de boom, of het perceel waar de boom op staat, hebt u toestemming nodig van de persoon die wel de eigenaar is. Deze toestemming moet schriftelijk zijn (dat wil zeggen via de mail of in een brief) en er moet duidelijk uit blijken dat de eigenaar u toestemming geeft.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__b5ff3410_2fb2_462f_b970_26d410484259">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>number</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om hoeveel bomen gaat het?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Gaat het om een groep, dan moet u het aantal bomen of struiken van die groep doorgeven.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__7be4ebce_88b0_481d_ae22_dc8200984b05">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat wilt u gaan doen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kappen/Verwijderen]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Snoeien]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Let op: dit is alleen vergunningplichtig als u meer dan 30% van de boom gaat snoeien.

Gaat u de boom voor het eerst op een speciale manier snoeien, waarbij alleen de dikke takken overblijven dan nomen we dit ook wel kandelaberen en/of kandelaren.

Kandelaberen is het (terug)snoeien tot op de hoofdtakken van een boom, alle gesteltakken worden tot tussen de 35 en 50% van de taklengte ingekort, resterende takken worden kort gezet.

Onder “kandelaberen” wordt in de verordening bomen 2024 ook “kandelaren” verstaan.

Kandelaren is het (terug)snoeien tot op de hoofdtakken van een boom, alle gesteltakken worden tot tussen de 50% en 75% van de taklengte ingekort, resterende takken worden kort gezet.

Kiest u dus ook snoeien als u gaat kandelaberen/kandelaren.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__5f332449_dc75_46e5_9edf_3ba3194d430f">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om welke reden bent u van plan de boom te gaan kappen of verwijderen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kappen of verwijderen voor natuurontwikkeling of voor (de gezondheid van) andere bomen]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Groene redenen om een boom te kappen zijn groene beheermaatregelen of maatregelen ten gunste van natuur, te behouden bomen, of te kappen bomen als gevolg van onrechtmatige hinder.

Compensatie is **niet** vereist als het gaat om groene redenen.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kappen of verwijderen voor een bouwproject]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Dit noemen we kappen met een rode reden. Rode redenen om een boom te kappen zijn redenen die gelinkt zijn aan bouwontwikkelingen of aan financiële compensatie. Denk aan sloop-, bouw-, uitbouw- of verbouwwerkzaamheden, aanleg van parkeerplaatsen of kunstgrasveld, vervanging van riolering, civieltechnische werkzaamheden, aanleg van uitwegen, uitbouwen van woningen en opstallen.

Anders gezegd zijn het redenen voor het kappen van de boom, die niets te maken hebben met het beheer van bomen. In deze situaties **moeten** de te kappen bomen **worden gecompenseerd.** Uitgangspunt is hierbij dat de gekapte bomen op locatie fysiek gecompenseerd worden. Alleen als dit niet mogelijk is (dit moet u kunnen aantonen), is financieel compenseren mogelijk.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kappen of verwijderen om een andere reden]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Valt de reden van het kappen niet onder een groene of rode reden? Dan noemen we dit kappen met een oranje reden. Oranje redenen zijn redenen die niet gelinkt zijn aan bouwontwikkelingen. Denk aan herindeling van een tuin, maar ook vellen van bomen met een lage levensverwachting of die gevaar opleveren. Voor oranje redenen **geldt een fysieke compensatieplicht.** Taxatie en boomonderzoek zijn hierbij niet nodig. Voor iedere boom wordt minimaal een boom terug geplant op het perceel die vergelijkbaar is in grootte (wanneer volgroeid) en ecologische waarde (bijvoorbeeld uit de lijst van 40 van 040).

**Financiële compensatie** is **niet mogelijk** bij oranje reden.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Er kunnen meerdere redenen zijn om bomen te kappen. Omdat we als gemeente niet willen dat iedereen zo maar elke boom kan kappen, willen we graag de reden van het kappen weten. In sommige situaties kunnen er, juist vanwege de reden van het kappen, eisen aan het kappen van de bomen gesteld worden. Om die reden maken we een onderscheid in een groene, rode en oranje reden voor het kappen. Kijkt u ook op [Omgevingsvergunning kappen | Gemeente Eindhoven](https://www.eindhoven.nl/stad-en-wonen/wonen/groen/omgevingsvergunning-kappen?search=kapvergunning) en de ‘Nadere regels compensatieplicht Verordening Bomen 2026’ voor meer informatie.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__682b9c83_2d5a_45f4_b735_0f3d94be39aa">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hebt u gekeken of er ook alternatieven zijn, zodat u de boom niet hoeft te kappen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__11e699bd_e8f4_4b71_b3db_c14320e96170">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Bent u van plan om een van de alternatieven ook uit te voeren, in plaats van het kappen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__25247434_2e52_4142_a226_8e37a192ec15">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Leg uit wat het alternatief is en hoe u dit gaat toepassen.]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__cd529ede_cfd3_4c8e_b1d7_721d62dcbf10">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef hier een toelichting waarom u er toch voor hebt gekozen om de boom te kappen in plaats van een alternatief te overleggen.]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__7140bf4b-b0c2-46d7-80bd-20e1e1265c58">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan waarom er geen alternatieven waren om de boom te behouden.]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__3cb3bf92_c666_432d_8a2f_040a4ed7a9e8">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voegt u hier een document toe met de waardebepaling van de te kappen bomen.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__7a5001e2_9381_4a88_9cc5_f9b0ad4e53fb">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U moet een compensatieplan opstellen. Voegt u hier het compensatieplan toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In het compensatieplan zijn in ieder geval de volgende punten opgenomen:

-   de taxatiewaarde van de te kappen/ verloren gegane boom (als u deze apart als bijlage heeft toegevoegd bij deze aanvraag hoeft deze hier niet nogmaals toegevoegd te worden);
-   de wijze waarop fysiek of financieel wordt gecompenseerd;
-   een ontwerpplan met bijbehorende plantlijsten en groeiplaatsverbetering en onderbeplanting, bijvoorbeeld in een plattegrond;
-   een overzicht van de te herplanten bomen;
-   de exacte locatie van de te herplanten bomen, ondergrondse groeiplaats, of alternatief groen (dit kunt u in het compensatieplan aangeven of apart op een duidelijke situatietekening);
-   de maat van de te herplanten bomen gemeten op een hoogte van 130 centimeter vanaf maaiveld (voorkeur voor omtrek 20-25 cm);
-   nieuwe bomen dienen in het plan aangegeven te worden met voldoende boven- en ondergrondse ruimte, als bedoeld in de [groeiplaatstool](https://groenblauw.site/);]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__08e975f7-c16d-446d-a2f7-baa1cf1c9494">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>130</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Mogelijk heeft u een Bomen Effect Analyse (BEA) nodig. Als u deze al hebt kunt u die hier toevoegen.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Een Bomen Effect Analyse laat u opstellen door een gecertificeerd boomdeskundig bedrijf. Het rapport wijst uit of, en zo ja hoe, het mogelijk is om de boom duurzaam te behouden. Vul dit formulier nogmaals in wanneer vervolgstappen duidelijk zijn.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9977ca27-ca16-4df4-b0f3-a3bcbefa0753">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>140</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U moet een compensatieplan opstellen. Voegt u hier het compensatieplan toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In het compensatieplan zijn in ieder geval de volgende punten opgenomen:

-   de wijze waarop fysiek wordt gecompenseerd;
-   een ontwerpplan met bijbehorende plantlijsten en groeiplaatsverbetering en onderbeplanting, bijvoorbeeld in een plattegrond;
-   een overzicht van de te herplanten bomen;
-   de exacte locatie van de te herplanten bomen, ondergrondse groeiplaats, of alternatief groen (dit kunt u in het compensatieplan aangeven of apart op een duidelijke situatietekening);
-   de maat van de te herplanten bomen gemeten op een hoogte van 130 centimeter vanaf maaiveld
-   nieuwe bomen dienen in het plan aangegeven te worden met voldoende boven- en ondergrondse ruimte, als bedoeld in de [groeiplaatstool](https://groenblauw.site/);]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__eddda1c2_66af_40ee_b3f6_943de9db613c">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>150</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Op welke manier gaat u de gekapte boom compenseren?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik ga fysiek compenseren (bomen herbeplanten)]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik ga financieel compenseren, omdat fysieke compensatie niet mogelijk is]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__e592d9d0-407a-407c-bd68-5bc757860191">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>160</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan waarom fysieke compensatie op de locatie niet mogelijk is.]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__bf4f7d6d_3f72_483d_8cfd_ea1dbd1ebb60">
                <uitv:regelgroepRef href="#_3f3020ef_b13a_45ba_80d9_fbf2fe371d1e"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>170</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Beschrijf wat u wilt gaan doen.]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6fb52f43-c91b-4071-bd98-054eeac7c4bc">
                <uitv:regelgroepRef href="#_74b90bc0-301a-4859-9060-e69bdf7ad8c3"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>180</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om een monumentale, waardevolle of veteranenboom?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Een **waardevolle** boom is een boom met een leeftijd van ten minste 50 jaar die niet verkeert in een onomkeerbare slechte conditie verkeert. De bomen met deze status zijn gelijk aan de “Beleidsklasse II” bomen, zoals vermeld in het Handboek Bomen 2022. Tot gemeentelijke waardevolle bomen behoren ook alle bomen die zich bevinden in de groenstructuren van de stad. Gemeentelijke waardevolle bomen zijn te vinden op de [Groene kaart](<Boom met een leeftijd van ten minste 80 jaar, een herdenkingsboom, veteranenboom,  boom met dendrologische waarde of zeldzame boom, die niet in een onomkeerbare  Inboeknummer  8 slechte conditie verkeert. De bomen met deze status zijn gelijk aan de “Beleidsklasse I”  bomen, zoals vermeld in het Handboek Bomen 2022. De gemeentelijke monumentale  bomen zijn ook te vinden op de Groene kaart.>).

Een **monumentale** boom is een boom met een leeftijd van ten minste 80 jaar, een herdenkingsboom, veteranenboom, boom met dendrologische waarde of zeldzame boom, die niet in een onomkeerbare slechte conditie verkeert. De bomen met deze status zijn gelijk aan de “Beleidsklasse I” bomen, zoals vermeld in het Handboek Bomen 2022. De gemeentelijke monumentale bomen zijn ook te vinden op de [Groene kaart](<Boom met een leeftijd van ten minste 80 jaar, een herdenkingsboom, veteranenboom,  boom met dendrologische waarde of zeldzame boom, die niet in een onomkeerbare  Inboeknummer  8 slechte conditie verkeert. De bomen met deze status zijn gelijk aan de “Beleidsklasse I”  bomen, zoals vermeld in het Handboek Bomen 2022. De gemeentelijke monumentale  bomen zijn ook te vinden op de Groene kaart.>).

Een **veteranenboom** is een oude boom die vaak in een ongeschonden bodem staat. Deze bomen vervullen een nichefunctie voor bepaalde schimmels en insecten. Veteranenbomen spelen een belangrijke rol in het behoud van biodiversiteit en worden vaak met zorg behandeld vanwege hun ecologische en historische waarde.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__54e87029-7525-430b-85b5-6e81a230148b">
                <uitv:regelgroepRef href="#_74b90bc0-301a-4859-9060-e69bdf7ad8c3"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>190</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan waarom er sprake is van een (zwaarwegend) maatschappelijk belang om tot het kappen van de boom over te gaan?]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het kappen van een boom is hetzelfde als het vellen van een boom.

In de wet wordt nog gesproken van vellen. Vellen als bedoeld in de omgevingswet: het rooien of verrichten van andere handelingen die de dood of ernstige beschadiging van een houtopstand (boom) tot gevolg kunnen hebben.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ea19d5ae-72a8-4215-9166-1adc30999a27">
                <uitv:regelgroepRef href="#_74b90bc0-301a-4859-9060-e69bdf7ad8c3"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>200</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voeg hier eventueel documenten toe ter ondersteuning van het (zwaarwegend) maatschappelijk belang.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__d75d0461_363e_4a88_8d17_316e9ff7396d">
                <uitv:regelgroepRef href="#_5498441f_b652_4afb_9fb7_9769bbe159aa"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>210</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Situatietekening kappen]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Voeg als bijlage toe: een situatietekening waarop de te kappen houtopstanden genummerd zijn aangegeven.

Op de situatietekening moet de te kappen houtopstanden zijn genummerd en moet duidelijk te zien zijn wat de locatie van de houtopstand op het voor-, zij- dan wel achtererf is.

Let op deze gegevens hebben wij nodig voor de behandeling van uw aanvraag. Zonder deze gegevens loopt uw aanvraag vertraging op of kunnen wij uw aanvraag buiten behandeling stellen.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[##### Wat is een houtopstand?
Een houtopstand is een zelfstandige boom of een groep van bomen, boomvormers, struiken, hakhout of griend .  
Een boomvormer is een houtig, opgaand gewas met ontwikkeling van één of meer hoofdtakken. Een boomvormer kan uitgroeien tot een boom, een meerstammige boom of een boomachtige struik.  
Een griend is een vochtige akker waarop wilgenhout wordt verbouwd.]]></content:langeToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c68f03bf-b683-4ea2-9db6-5b2aa1e2af4b">
                <uitv:regelgroepRef href="#_5498441f_b652_4afb_9fb7_9769bbe159aa"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>220</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voeg hier één of meer foto's toe om de situatie te verduidelijken]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__d25bdbd4_df86_473d_b550_4bea0ab28bb3">
                <uitv:regelgroepRef href="#_5498441f_b652_4afb_9fb7_9769bbe159aa"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>230</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Gegevens boom/bomen]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Voeg als bijlage toe: gegevens over de te kappen bomen. Deze gegevens kunt u hier aanleveren in een apart rapport, of toevoegen aan de gevraagde situatietekening kappen. Ook kunt u een foto van de situatie mee sturen ter verduidelijking. Het rapport of de situatietekening moet per boom de volgende gegevens bevatten:

-   een situatietekening waarop de oude en de nieuwe situatie duidelijk zichtbaar is
-   redenen of argumentatie waarom kappen gewenst of noodzakelijk is
-   volgnummer dat overeenkomt met het volgnummer op de situatietekening kappen;
-   de soort boom en de leeftijd van ervan;
-   de locatie van de boom op het voor-, zij, of achtererf;
-   de diameter van de bomen in centimeters gemeten op 1,30 meter vanaf het maaiveld;
-   de mogelijkheid tot herbeplanten.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[##### Wat is een houtopstand?
Een houtopstand is een zelfstandige boom of een groep van bomen, boomvormers, struiken, hakhout of griend .  
Een boomvormer is een houtig, opgaand gewas met ontwikkeling van één of meer hoofdtakken. Een boomvormer kan uitgroeien tot een boom, een meerstammige boom of een boomachtige struik.  
Een griend is een vochtige akker waarop wilgenhout wordt verbouwd.]]></content:langeToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__eeae8135_65a3_42c6_be87_3caf01857478">
                <uitv:regelgroepRef href="#_5498441f_b652_4afb_9fb7_9769bbe159aa"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>240</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Overige gegevens noodzakelijk voor toetsing aan omgevingsplan]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Hier hebt u de mogelijkheid om zelf nog andere gegevens of documenten toe te voegen die u belangrijk vindt voor de beoordeling van uw aanvraag.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

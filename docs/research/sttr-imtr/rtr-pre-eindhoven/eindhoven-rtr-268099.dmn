            <inter:regelgroep id="_5f87f210-2068-496f-8dcb-a37af6185649">
                <inter:naam>Maatregel: Geur veroorzaakt door het exploiteren van zuiveringtechnische werken (verbeterd en omgezet naar PROD)_Eindhoven</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Roerende zaken opslaan" id="_6a7215d2_3ee9_4a63_b4e7_78fb121f3aa0" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <bedr:sttr versie="2"/>
        <inter:regelgroepen>
            <inter:regelgroep id="_24270644_63cd_46f7_a19a_9e758fc63172">
                <inter:naam>doel van gebruik openbare ruimte</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_a1b9a0c9-2e2e-486b-8281-8d80bfc38614">
                <inter:naam>een verhuizing of (bouw)werkzaamheden</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_4c72eab5-cc49-419c-a704-3e1ae28e2e25">
                <inter:naam>filmopnames</inter:naam>
                <inter:prioriteit>3</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_89f4107a-ad45-430c-9a55-d74af00fa215">
                <inter:naam>een springkussen tijdens een buurt- of kinderfeest</inter:naam>
                <inter:prioriteit>4</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__c74709db-3b10-4d59-9132-6f0c325a52e0">
                <uitv:regelgroepRef href="#_24270644_63cd_46f7_a19a_9e758fc63172"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Waarvoor wilt u de openbare ruimte gebruiken?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Vanwege een verhuizing of (bouw)werkzaamheden]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Het maken van filmopnames]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Het plaatsen van een springkussen vanwege een buurt- of kinderfeest (<250 mensen)]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:toelichting><![CDATA[Wanneer meer dan 250 mensen aanwezig zijn gaat het om een evenement. Kijkt u dan op [Evenementen | Ondernemend Eindhoven](https://www.ondernemendeindhoven.nl/regel-je-zaken/evenementen) wat u dan moet doen.]]></content:toelichting>
                                <content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ab279d15_c6dc_4ce1_b2ca_88e73f874840">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wilt u een van de volgende objecten plaatsen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[(Rol)Steiger]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Tijdelijke in- en uitrit]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[(Mobiele) Kraan]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>4</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Hoogwerker]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>5</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Container (open/dicht)]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>6</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ander object]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:toelichting><![CDATA[Een ander object kan zijn:

*   Schaftkeet;
*   Bouwschutting;
*   Bouwhek;

maar kan bijvoorbeeld ook zijn:

*   Bouwplaats inrichting;
*   Tijdelijke materiaalopslag;
*   Verhuislift.

Let op: een springkussen zien wij niet als een “ander object”, waarvoor een vergunning op basis van ons omgevingsplan nodig is. Wilt u tijdelijk een springkussen in de openbare ruimte plaatsen, bijvoorbeeld voor een buurt- of kinderfeest in een openbaar park of een speeltuin, geeft u dit dan aan bij de vorige vraag om te zien wat u moet doen.

Let op: het plaatsen van een springkussen in de voetgangerszone van de Eindhovense binnenstad is niet toegestaan. Ook niet als je hiervan melding maakt.]]></content:toelichting>
                                <content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Gaat u 2 of meer verschillende objecten tijdelijk plaatsen, vult u dan voor de volledigheid de vragenlijst in voor elk afzonderlijk object.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1e5d6eb0_f0f9_49c2_b723_c5b93037537e">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wilt u dit object plaatsen op gemeentegrond en/of openbaar toegankelijk terrein?]]></uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__3146c270_11b7_40d7_b291_60a752e5fa25">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Plaatst u een kraan of hoogwerker op eigen grond en komt u met de draaicirkel van de kraan of armbeweging van de hoogwerker over gemeentegrond?]]></uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__2353d652_e7ce_449f_83ee_87d43b1b0ef6">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Plaatst u de container(s) binnen een betaald parkeergebied?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Een overzicht van de gebieden die betaald parkeren zijn, vindt u op:

[Parkeergebieden betaald parkeren woonwijken | Gemeente Eindhoven](https://www.eindhoven.nl/parkeergebieden-betaald-parkeren-woonwijken)]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a47c3862_c576_4c30_a3b3_f7086e7365f1">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hoeveel objecten wilt u plaatsen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[1]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[2]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Meer dan 2 objecten]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Als u 1 of 2 objecten wilt plaatsen is het, afhankelijk van het soort object, mogelijk dat u in aanmerking komt voor een flitsvergunning. Meer informatie hierover vindt u op onze website ([Tijdelijk gebruik openbare ruimte | Gemeente Eindhoven](https://www.eindhoven.nl/ondernemen/algemeen/tijdelijk-gebruik-openbare-ruimte)).

Bij meer dan 2 objecten moet u een reguliere vergunningaanvraag indienen. Zie ook hier weer voor meer informatie onze website ([Tijdelijk gebruik openbare ruimte | Gemeente Eindhoven](https://www.eindhoven.nl/ondernemen/algemeen/tijdelijk-gebruik-openbare-ruimte)).]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1cddd697_d084_43dd_bc58_cb40874d4937">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wilt u de container maximaal vijf aaneengesloten werkdagen plaatsen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Als de container binnen deze 5 dagen wordt gewisseld, gaat de termijn opnieuw in.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__dd5334ba_1870_49fd_b670_d9989c0be781">
                <uitv:regelgroepRef href="#_a1b9a0c9-2e2e-486b-8281-8d80bfc38614"/>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Voldoet de container aan de andere eisen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De andere eisen zijn:

*   Naam en telefoonnummer van de eigenaar of verhuurder staan op de container vermeld;
*   De container staat in het weekend en op feestdagen niet in een winkelstraat.
*   Betreft de plaatsing van de container een voetgangerszone, dan moet de container geplaatst worden tussen 07:00 uur en 11:00 uur (vanaf 11:00 uur moet de container verwijderd zijn) en blijft er na de plaatsing van de container nog minimaal 3,5 meter ruimte over in de breedte van de weg.

Bij een *open container* geldt ook dat:

*   De inhoud van de container maximaal 10 m3 is; en
*   De inhoud van de container is afgedekt met een dekzeil en/of een net.

Bij een *gesloten container* geldt ook dat:

*   De container maximaal 6 meter lang, maximaal 2,5 meter breed en maximaal 2,5 meter hoog is; en
*   Aan alle kanten gesloten is.

Let u op, als de container op openbaar toegankelijk terrein of gemeente grond wordt geplaatst, bent u ervoor verantwoordelijk dat het openbaar toegankelijk terrein of gemeente grond weer in nette, originele staat verkeerd wanneer de container wordt verwijderd.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__23851748-27c1-41cf-816a-f8bf9ddd7d91">
                <uitv:regelgroepRef href="#_4c72eab5-cc49-419c-a704-3e1ae28e2e25"/>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u opnames maken in de openbare ruimte?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Gaat u geen opnames maken in openbare ruimtes, maar in besloten ruimtes, zoals achtertuinen of woonkamers? Dan is geen vergunning nodig. Houd er wel rekening mee dat toestemming nodig is van de eigenaar van de afgesloten ruimte om in deze ruimtes opnames te mogen maken.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__3c8059a7-a4d5-4021-9207-6c52c23ad2b5">
                <uitv:regelgroepRef href="#_4c72eab5-cc49-419c-a704-3e1ae28e2e25"/>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om kleinschalige opnames?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Kleinschalige opnames zijn opnames waarbij:

*   Geen objecten in de openbare ruimte worden geplaatst;
*   Geen tijdelijke verkeersmaatregelen en/of wegafzettingen nodig zijn; en
*   Die per locatie maximaal 30 minuten duren.

Voorbeelden zijn bijvoorbeeld: straatinterviews of korte fotoreportages.

  

Let op: u mag niet zonder toestemming vanuit de openbare ruimte opnames maken van besloten ruimtes, zoals achtertuinen en kantoorruimtes.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__e008c7ae-ca24-4358-9d93-fa6956598b31">
                <uitv:regelgroepRef href="#_4c72eab5-cc49-419c-a704-3e1ae28e2e25"/>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u objecten in de openbare ruimte plaatsen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Voorbeelden van objecten zijn bijvoorbeeld:

*   Een hoogwerker voor het maken van opnames van bovenaf;
*   Een schaftkeet voor het personeel betrokken bij de opnames;
*   Het in parkeervakken plaatsen van productiemateriaal en -materieel.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__29188ca0-94c6-41d7-8948-cca1ef6bda5a">
                <uitv:regelgroepRef href="#_4c72eab5-cc49-419c-a704-3e1ae28e2e25"/>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Zijn er tijdelijke verkeersmaatregelen en/of wegafzettingen nodig?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Voorbeelden hiervan zijn:

*   Het plaatsen van schrikhekken op het trottoir, waardoor voetgangers moeten oversteken;
*   Het plaatsen van tijdelijke parkeerverboden;
*   Het afzetten van een weg waarop de opnames plaatsvinden.

Als u geen object in de openbare ruimte gaat plaatsen, maar wel ja op deze vraag antwoordt, moet u toestemming hebben van Team Eindhoven Bereikbaar om de maatregelen en/of afzetting toe te passen. Hiervoor mailt u de te nemen maatregelen en/of afzettingen, samen met de gewenste dag en tijd waarop deze actief zullen zijn, naar [bereikbaar@eindhoven.nl](mailto:bereikbaar@eindhoven.nl).

__Let u op:__ zonder toestemming mogen er geen opnames gemaakt worden.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__bc99eb0a-0f93-43d0-af23-15c87da13428">
                <uitv:regelgroepRef href="#_89f4107a-ad45-430c-9a55-d74af00fa215"/>
                <inter:prioriteit>130</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u het springkussen plaatsen in een voetgangerszone van de Eindhovense binnenstad?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het plaatsen van een springkussen in de voetgangerszone van de Eindhovense binnenstad is niet toegestaan. Ook niet als je hiervan melding maakt.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

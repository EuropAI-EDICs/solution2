                    <sttrbuilder:questionPath>
                        <sttrbuilder:outcome><![CDATA[Neem contact op met]]></sttrbuilder:outcome>
                        <sttrbuilder:information><![CDATA[U heeft geen vergunning nodig. Wel moet u toestemming hebben van Team Eindhoven Bereikbaar om de maatregelen en/of afzetting toe te passen. Hiervoor mailt u de te nemen maatregelen en/of afzettingen, samen met de gewenste dag en tijd waarop deze actief zullen zijn, naar [bereikbaar@eindhoven.nl](mailto:bereikbaar@eindhoven.nl).  

Let op: zonder toestemming mogen er geen opnames gemaakt worden.]]></sttrbuilder:information>
                        <sttrbuilder:outcomeId><![CDATA[NeemContactOpMet]]></sttrbuilder:outcomeId>
                        <sttrbuilder:answers>

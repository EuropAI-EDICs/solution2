            <uitv:uitvoeringsregel id="uitv__b0d1b100-0569-494d-b183-b6fa4b02b17e">
                <uitv:regelgroepRef href="#_e5343424-c76f-4e6c-800e-84bd7186eda6"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>date</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wanneer verwacht u klaar te zijn met de activiteit?*]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ed7928e4-b241-4e13-bef9-394a56c45a55">
                <uitv:regelgroepRef href="#_e5343424-c76f-4e6c-800e-84bd7186eda6"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Ligt de locatie waar u grondwater uit de bodem wilt halen binnen de beheersgrens?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de locatie ligt binnen de beheersgrens]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, de locatie ligt niet binnen de beheersgrens]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het opgepompte water uit de grond noemen we (juridisch) bronneringswater.

De beheersgrens ziet u hieronder op de kaart afgebeeld binnen de rode stippellijnen. Ligt de locatie hierbinnen, laat u dit dan ook weten aan ons door een mail te sturen naar [ggb-centrum@eindhoven.nl](mailto:ggb-centrum@eindhoven.nl)

![](https://sttr-files-preprod.apps.geodan.nl/00000001001902763000/beheersgrens.jpg)]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Indieningsvereisten Melding Werkzaamheden ten behoeve van ondergrondse infrastructuren" id="_bfed20d1_82ff_44f3_a488_1958d3e97308" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <bedr:sttr versie="2"/>
        <inter:regelgroepen>
            <inter:regelgroep id="_132433b8-d0ae-4350-acd9-df75d2359075">
                <inter:naam>soort melding</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_5f39ab35-95af-44df-aaca-17f84da4c553">
                <inter:naam>werkzaamheden klein graafwerkzaamheden</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_583f9169-f4c9-4102-81fa-f249fdcddfff">
                <inter:naam>Handhole</inter:naam>
                <inter:prioriteit>3</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_7a205576-bb60-4be2-a38d-a70d80acb711">
                <inter:naam>Benodigde informatie contactpersoon</inter:naam>
                <inter:prioriteit>4</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_59e8ca57-fc32-480f-8a32-c4bc713bae08">
                <inter:naam>bijlagen</inter:naam>
                <inter:prioriteit>5</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__a372cf5b-6f1e-4eff-af65-d58ec91f2118">
                <uitv:regelgroepRef href="#_132433b8-d0ae-4350-acd9-df75d2359075"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Om wat voor soort melding gaat het?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[handhole]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kleine graafwerkzaamheden]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
                                <content:toelichting><![CDATA[Let u op, met dit formulier kunt u een melding doen voor kleine graafwerkzaamheden ten behoeve van het (ver)leggen van kabels en leidingen in de openbare ruimte.

Dit formulier is niet van toepassing als het vergunningsplichtige werkzaamheden betreft (tracélengte > 25 m en/of tracé oppervlak groter dan 10 m² en/of een boortechniek wordt toegepast) of werkzaamheden aan handholes of calamiteiten betreft. Kies dan het aanvraagformulier voor de vergunning en vul dat formulier in.]]></content:toelichting>
                                <content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De melding dient minimaal 5 werkdagen voor aanvang van de werkzaamheden ingediend te worden.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__87374551-d194-4460-bc5f-2212a15fd2b4">
                <uitv:regelgroepRef href="#_5f39ab35-95af-44df-aaca-17f84da4c553"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Beschrijf hier de werkzaamheden die u gaat uitvoeren op de aangegeven locatie]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let op, als u liever een foto of tekening wenst in te dienen, geeft u hier dan een korte omschrijving. In een volgend scherm krijgt u de mogelijkheid om de documenten toe te voegen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__d486389b-2bc8-4ea3-b353-9932a0a5104c">
                <uitv:regelgroepRef href="#_5f39ab35-95af-44df-aaca-17f84da4c553"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>date</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan wat de geplande startdatum is van de werkzaamheden]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De werkzaamheden worden geacht gereed te zijn uiterlijk 10 werkdagen na opgegeven startdatum]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c43aa829-3170-40a9-8ed8-7da2e43bbcba">
                <uitv:regelgroepRef href="#_5f39ab35-95af-44df-aaca-17f84da4c553"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er sprake van een wegafzetting?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de weg wordt helemaal afgezet]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de weg wordt gedeeltelijk afgezet]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[nee, er hoeft geen wegafzetting te komen]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Dit geldt ook voor afsluiting van fiets- en/of voetpaden.

Is uw antwoord ja, voeg dan (later) bij deze melding als bijlage het goedgekeurde verkeersplan toe.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__54098dfd-fff5-4d41-99a7-d43f044a6bc2">

                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wie is de netwerkeigenaar?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Melder]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Anders, de gegevens van de netwerkeigenaar zijn:]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De netwerkeigenaar is eigenaar van een kavel of leidingennetwerk en verantwoordelijk voor het beheer en onderhoud daarvan.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

                <uitv:vraag>
                    <uitv:gegevensType>date</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geeft u aan wanneer u met de werkzaamheden verwacht te starten]]></uitv:vraagTekst>

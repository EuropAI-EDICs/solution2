<?xml version="1.0" encoding="UTF-8" standalone="no"?><semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_5788747" name="Maatregelen - LPGTanken" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements>
    <inter:regelgroepen>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_1491465" name="Conclusie - Dierlijke meststoffen opslaan" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_4115_RuleGroup">
        <inter:naam>Soort mest</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4116_RuleGroup">
        <inter:naam>Vaste mest</inter:naam>
        <inter:prioriteit>20</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4122_RuleGroup">
        <inter:naam>Opslaan van mest in een mestbassin</inter:naam>
        <inter:prioriteit>30</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_20325_BizRule">
        <uitv:regelgroepRef href="#_4115_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Kies alle soorten mest die u gaat opslaan.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Vaste mest]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Onder vaste mest valt alle mest van dieren die u kunt stapelen\. U kunt vaste mest niet met een pomp verplaatsen\. Vaste mest heet ook wel steekvaste mest\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Drijfmest, dunne fractie of digestaat]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[##### Wat is drijfmest?

Drijfmest is mest van dieren dat u met een pomp kunt verplaatsen\. Drijfmest heet ook wel dunne mest\. Het bestaat meestal uit uitwerpselen en urine van vee\. Soms zit er ook spoelwater of regenwater bij\.

##### Wat is dunne fractie?

Als u drijfmest scheidt, ontstaat er een vast deel en een vloeibaar deel\. Het vloeibare deel is de dunne fractie\.

##### Wat is digestaat?

Digestaat is een restproduct dat overblijft als u dierlijke mest vergist\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20332_BizRule">
        <uitv:regelgroepRef href="#_4116_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Kunt u 3 m3 of meer vaste mest opslaan?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Het gaat om de maximale hoeveelheid die op enig moment aanwezig kan zijn\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20327_BizRule">
        <uitv:regelgroepRef href="#_4116_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Kunt u meer dan 600 m3 vaste mest opslaan?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Het gaat om de maximale hoeveelheid die op enig moment aanwezig kan zijn\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20330_BizRule">
        <uitv:regelgroepRef href="#_4116_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u de vaste mest opslaan bij een bedrijf?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20331_BizRule">
        <uitv:regelgroepRef href="#_4116_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>50</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Bij wat voor soort bedrijf gaat u de vaste mest opslaan?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf voor grootschalig verwerken van mest]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om grootschalige mestverwerking zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/complexe-bedrijven/grootschalige-mestverwerking/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Veehouderij]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een veehouderij zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/veehouderij/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf voor het telen van gewassen in de openlucht]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om het telen van gewassen in de openlucht zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/telen-openlucht/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf voor het telen van gewassen in een gebouw]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om het telen van gewassen in een gebouw zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/telen-gebouw/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>5</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf dat loonwerk doet voor agrarische bedrijven]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een agrarisch loonwerkbedrijf zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/loonwerkbedrijf/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>6</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf voor mestbehandeling]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een bedrijf voor mestbehandeling zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/mestbehandeling/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>7</uitv:sequenceId>
              <uitv:optieText><![CDATA[Ander bedrijf]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20333_BizRule">
        <uitv:regelgroepRef href="#_4116_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u vaste mest korter dan twee weken op dezelfde plek opslaan?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20385_BizRule">
        <uitv:regelgroepRef href="#_4122_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u drijfmest, dunne fractie of digestaat opslaan in 1 of meer mestbassins?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[##### Wat is een mestbassin?

Een mestbassin is een opslagplaats voor drijfmest, digestaat of dunne fractie\. Daaronder vallen ook de volgende opslagplaatsen:

* mestzak of foliebassin
* mestsilo


Het maakt hierbij niet uit of deze opslagplaatsen zijn ingegraven\.

##### Wat valt niet onder mestbassin?

De volgende opslagplaatsen vallen niet onder mestbassin:

* mestkelder
* giertank]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_4312_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:vasteWaarde>
          <uitv:waardeVraag>vaste waarde FALSE</uitv:waardeVraag>
          <uitv:waarde>false</uitv:waarde>
          <uitv:gegevensType>boolean</uitv:gegevensType>
        </uitv:vasteWaarde>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20386_BizRule">
        <uitv:regelgroepRef href="#_4122_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Is de oppervlakte van de mestbassins groter dan 750 m2?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft u meer dan 1 mestbassin? Neem dan de totale oppervlakte van alle mestbassins\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20387_BizRule">
        <uitv:regelgroepRef href="#_4122_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Is de inhoud van de mestbassins groter dan 2500 m3?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft u meer dan 1 mestbassin? Neem dan de totale inhoud van alle mestbassins\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>

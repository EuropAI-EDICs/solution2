<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_9386230" name="Conclusie - Afvalwater lozen bij telen, kweken, spoelen of sorteren van gewassen" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_4682_RuleGroup">
        <inter:naam>Afvalwater lozen in het riool of op of in de bodem</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_27115_BizRule">
        <uitv:regelgroepRef href="#_4682_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Afvalwater van activiteiten bij een bedrijf: Om wat voor soort bedrijf gaat het? Kies alle opties die van toepassing zijn.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Agrarisch loonwerkbedrijf]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een agrarisch loonwerkbedrijf zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/loonwerkbedrijf/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf dat gewassen teelt in een gebouw]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een bedrijf dat gewassen teelt in een gebouw zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/telen-gebouw/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Glastuinbouwbedrijf]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een glastuinbouwbedrijf zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/glastuinbouw/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bedrijf dat gewassen teelt in de openlucht]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat om een bedrijf dat gewassen teelt in de openlucht zoals bedoeld in hoofdstuk 3 van het Besluit activiteiten leefomgeving\. Op de website van Informatiepunt Leefomgeving staat [meer informatie over welke bedrijven hieronder vallen](https://iplo.nl/regelgeving/regels-voor-activiteiten/milieubelastende-activiteiten-hoofdstuk-3-bal/agrarische-sector/telen-openlucht/)\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>5</uitv:sequenceId>
              <uitv:optieText><![CDATA[Ander bedrijf]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_22679_BizRule">
        <uitv:regelgroepRef href="#_4682_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u afvalwater van het telen, kweken, spoelen of sorteren van gewassen lozen in het riool of op of in de bodem?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_19604_BizRule">
        <uitv:regelgroepRef href="#_4682_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Afvalwater lozen in het riool of op of in de bodem: Is dit afvalwater afkomstig van activiteiten bij een bedrijf?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_19603_BizRule">
        <uitv:regelgroepRef href="#_4682_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Afvalwater lozen in het riool of op of in de bodem: Waar komt dit afvalwater vandaan?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Telen van gewassen in een gebouw, anders dan een kas]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Sorteren van biologisch geteeld fruit]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Van een andere activiteit]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>

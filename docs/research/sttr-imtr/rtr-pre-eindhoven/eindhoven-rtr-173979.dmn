      </semantic:input>
      <semantic:output id="_3047907" />
      <semantic:rule id="_3742956">
        <semantic:inputEntry id="_846891">
          <semantic:text>if ?=null then false else contains(?,"Agrarisch loonwerkbedrijf") or contains(?,"Bedrijf dat gewassen teelt in een gebouw") or contains(?,"Glastuinbouwbedrijf") or contains(?,"Bedrijf dat gewassen teelt in de openlucht")</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_9580502">
          <semantic:text>true</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
      <semantic:rule id="_3685621">
        <semantic:inputEntry id="_8072955">
          <semantic:text>if ?=null then false else not(contains(?,"Agrarisch loonwerkbedrijf") or contains(?,"Bedrijf dat gewassen teelt in een gebouw") or contains(?,"Glastuinbouwbedrijf") or contains(?,"Bedrijf dat gewassen teelt in de openlucht"))</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_1088103">
          <semantic:text>false</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
    </semantic:decisionTable>
  </semantic:decision>

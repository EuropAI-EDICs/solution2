<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_4669874" name="Indieningsvereisten Vergunning - Alarminstallatie hebben" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_1515_RuleGroup">
        <inter:naam>Diverse vragen</inter:naam>
        <inter:prioriteit>990</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_13975_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Beschrijf het soort alarm en hoe het werkt.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Beschrijf wat er gebeurt op het moment dat het alarm afgaat\. Neem in de beschrijving op of er sprake is van licht en/of geluid, of het signaal binnen of buiten de onroerende zaak waarneembaar is, de tijdsduur van het signaal en of het een onafgebroken signaal betreft\.]]></content:toelichting>
          <content:belangrijk>false</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_13976_BizRule">
        <uitv:regelgroepRef href="#_1515_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>false</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef minimaal twee contactpersonen of instanties op die kunnen worden gebeld als het alarm afgaat. Vermeld daarbij de naam, het adres en het telefoonnummer waarop zij kunnen worden gebeld.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_13978_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Locatie alarminstallatie</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: een situatietekening, kaart, foto of een ander geschikt middel waarop de plaats is aangegeven waar de alarminstallatie zich bevindt\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_26303_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>990</inter:prioriteit>
        <uitv:bijlage>
          <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan hiervoor al gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>
  </semantic:extensionElements>

    </semantic:extensionElements>
    <semantic:variable id="_1006182" name="wijze bakkerijoven laden UR" typeRef="feel:string"/>
  </semantic:inputData>
  <semantic:inputData id="_29316_Concept" name="nominale vermogen van de oven groter dan 100kW UR">
    <semantic:extensionElements>

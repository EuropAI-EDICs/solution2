                <dmn:inputEntry id="_fae42098_5174_4eaf_9130_fc8250fd8566">
                    <dmn:text>"no hit"</dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_4d2b8044_d243_49be_84c0_bcff43828f0e">
                    <dmn:extensionElements>
                        <content:conclusieToelichting>
                            <content:toelichting><![CDATA[U lijkt in uw situatie geen vergunning te hoeven aan te vragen. Let wel op: Het bouwwerk mag niet ernstig ontsierend zijn, als dit in het omgevingsplan is bepaald. Kijk voor de regels over ernstige ontsiering van het uiterlijk van bouwwerken in het omgevingsplan. Deze regels worden ook wel het repressief welstandsvereiste genoemd. Neem bij twijfel contact op met de gemeente.]]></content:toelichting>
                        </content:conclusieToelichting>
                    </dmn:extensionElements>
                    <dmn:text>"Toestemmingsvrij"</dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
        </dmn:decisionTable>

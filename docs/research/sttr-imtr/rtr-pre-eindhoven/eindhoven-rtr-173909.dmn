        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Hoe lang verwacht u dat deze activiteit gaat duren?]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[U moet dit minimaal 1 week voor de start van de activiteit doorgeven\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>

<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Indieningsvereisten Melding Bouwwerk slopen" id="_8e1687f3_fa2f_4556_bbe3_326dfbd3fe9d" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5">
                <inter:naam>melding</inter:naam>
                <inter:prioriteit>10</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__306b0afb-731c-4060-a4c6-3f65ef643a80">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef aan hoeveel m3 bouw- of sloopafval u verwacht.]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ced628f6-e1be-4889-8aae-f6dd46f6e12e">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is het bouwwerk voor 1994?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__5dd37c92-0ddb-40f9-9ea7-707dfdd3abb1">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Het bouwwerk is van voor 1994. Voeg hier een asbestinventarisatielijst of foto's toe waaruit duidelijk blijkt dat er geen sprake is van asbest in het te slopen deel.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Meer informatie over een asbest en een asbestinventarisatielijst vindt u op de site van het [Informatiepunt Leefomgeving](https://iplo.nl/thema/asbest/).

Op [www.ascert.nl](http://www.ascert.nl) kunt u een overzicht vinden van bedrijven die gecertificeerd zijn voor het verwijderen van asbest en het opstellen van een asbest inventarisatie en rapportage.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__bc0662b9-093c-4253-8b3f-493d622bf995">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Moet u op basis van het risicomatrix model een veiligheidsplan indienen of heeft u een aanwijzing van de gemeente gekregen om een veiligheidsplan in te dienen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De risicomatrix vindt u [hier](https://iplo.nl/regelgeving/regels-voor-activiteiten/technische-bouwactiviteit/uitvoeren-bouwwerkzaamheden/veiligheid-bouwwerkzaamheden/@264244/risicomatrix-bouw-sloopactiviteit/).

Meer informatie over de veiligheid bij het uitvoeren van bouwwerkzaamheden vindt u op de site van het Informatiepunt Leefomgeving ([Veiligheid bij het uitvoeren van bouwwerkzaamheden | Informatiepunt Leefomgeving (iplo.nl)](https://iplo.nl/regelgeving/regels-voor-activiteiten/technische-bouwactiviteit/uitvoeren-bouwwerkzaamheden/veiligheid-bouwwerkzaamheden/)).]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__98439d4b-3ee2-405b-85e4-93abd03152e9">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U bent verplicht een een veiligheidsplan aan te leveren. Voegt u het veiligheidsplan hier toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9ef74a6d-da53-41f6-93d3-2c4948eb6c9c">
                <uitv:regelgroepRef href="#_6b52d4c4-a527-4c79-a1f0-34db0e6aeff5"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[U bent niet verplicht een een veiligheidsplan aan te leveren. Hebt u toch een veiligheidsplan dat u wilt toevoegen, voeg het veiligheidsplan dan hier toe.]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het is mogelijk dat op basis van de ingediende gegevens alsnog een veiligheidsplan nodig is. Wij nemen in dat geval contact met u op.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

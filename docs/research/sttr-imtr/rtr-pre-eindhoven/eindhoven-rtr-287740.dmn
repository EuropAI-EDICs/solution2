            <uitv:uitvoeringsregel id="uitv__b3739eb1_fd3c_4b7a_a948_54057729bc18">
                <uitv:regelgroepRef href="#_0b4c9d2b_9eef_4112_a22b_393de15e2f9a"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>date</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wanneer verwacht u klaar te zijn met de activiteit? *]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__5963fa89-670c-4e51-9cc4-3308e8d996d5">
                <uitv:regelgroepRef href="#_0b4c9d2b_9eef_4112_a22b_393de15e2f9a"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Ligt de locatie waar u grondwater uit de bodem wilt halen binnen de beheersgrens?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de locatie ligt binnen de beheersgrens]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[nee, de locatie ligt niet binnen de beheersgrens]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het opgepompte water uit de grond noemen we (juridisch) bronneringswater.

De beheersgrens ziet u hieronder op de kaart afgebeeld binnen de rode stippellijnen. Ligt de locatie hierbinnen, laat u dit dan ook weten aan ons door een mail te sturen naar [ggb-centrum@eindhoven.nl](mailto:ggb-centrum@eindhoven.nl)

![](https://sttr-files-preprod.apps.geodan.nl/00000001001902763000/beheersgrens.jpg)]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__d0d528b0_8bcf_4d06_846f_2550dacfa2ac">
                <uitv:regelgroepRef href="#_0b4c9d2b_9eef_4112_a22b_393de15e2f9a"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geef de locatie waar u grondwater uit de bodem gaat oppompen:]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__bce5ec82_6c94_45a8_a8e7_0dde01b296b5">
                <uitv:regelgroepRef href="#_0b4c9d2b_9eef_4112_a22b_393de15e2f9a"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voeg hier een tekening bij als bijlage voor het gebied waar u het water uit de bodem gaat oppompen.*]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Het stuk grond waar u het water uit de bodem op gaat pompen noemen we (juridisch) het onttrekkingsgebied.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__eff2dd4c_b862_4bca_9c1b_40007376f7fd">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Reden van de lozing van het grondwater:]]></uitv:vraagTekst>
                    <inter:inputType>text</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__b5cc400d_a7f2_41ad_ab45_bcf5d7dde7c1">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er een lozingspunt op het gemeenteriool aanwezig?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let op! Als er geen lozingspunt op het gemeenteriool aanwezig is, kunt u ook een aanvraag indienen voor een tijdelijke aansluiting op het gemeenteriool. Kijk hiervoor op onze website [Riolering, aansluiting | Gemeente Eindhoven](https://www.eindhoven.nl/bouwen/grond-en-vastgoed/riolering-aansluiting "https://www.eindhoven.nl/bouwen/grond-en-vastgoed/riolering-aansluiting").]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__e59dbc12_b764_469d_9bec_1055abdb9559">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hoe is het lozingspunt plaatselijk bekend?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Kolk]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Huisaansluiting riolering]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__1b36a363_ffe0_48f3_a608_fc29aca2f6bf">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Namelijk:]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__580685ce-c1b5-4762-80d7-7f102bfae2db">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hoe bent u dan van plan om het water te lozen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Op of in de bodem]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Het is verboden om op of in de bodem grondwater te lozen, als daarbij stoffen zonder doorsijpeling door bodem of ondergrond in het grondwater terecht komen.]]></content:toelichting>
<content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[In oppervlaktewater]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let u hierbij op dat voor het lozen van dat grondwater op of in de bodem, in het oppervlaktewater of in een schoonwaterriool de emissiegrenswaarde voor onopgeloste stoffen 50 mg/l en voor ijzer 5 mg/l, en moet de pH-waarde (zuurgraad) tussen de 6,5 en 9,0 bedragen, gemeten in een steekmonster.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__55592f1c_a1b1_4b4c_b678_b58e8d1c616f">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>130</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[De hoeveelheid van de lozing is bepaald door:]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Berekening in bemalingadvies (voorbereidingsfase)]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Bemalingsplan (uitvoeringsfase)]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Pompcapaciteit]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>4</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Schatting]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>5</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Anders]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__fd44364c_0f0b_48cd_b700_c63343d87053">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>140</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Namelijk:]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__483b1e86_731b_4d7f_bb49_832f9020567e">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>150</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[De maximale hoeveelheid van de lozing bedraagt:]]></uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Geeft u aan hoeveel kubieke meter (m3) u per uur u gaat lozen. Omdat de hoeveelheid per dagdeel kan verschillen vragen wij u ook de tijdstippen aan te geven wanneer u de hoeveelheid kubieke meter water loost. U kunt deze informatie het best als volgt noteren/invullen voor ons:  
1: …m³ / uur; van:… tot:…  
2: …m³ / uur; van:… tot:…  
3: … m³ / uur; van: … tot: …  
__Totale hoeveelheid te lozen grondwater: … m³__  
\*\*\*\*\*Als u deze informatie (nog) niet ter beschikking hebt, vragen wij u hier gemiddelde in te vullen\*]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__82a0c922_742b_474a_9cd6_289e58221cd1">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>160</inter:prioriteit>
                <uitv:bijlage>
                    <uitv:bijlageType><![CDATA[Voeg hier een tekening toe als bijlage waar de locatie van het lozingspunt ten opzichte van het bouwplan te zien is.*]]></uitv:bijlageType>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f00bb5d9-95d6-463c-a7b1-8a4ecb499d96">
                <uitv:regelgroepRef href="#_3e21f193_395d_4f4f_b2cc_bcd63a25cc21"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>

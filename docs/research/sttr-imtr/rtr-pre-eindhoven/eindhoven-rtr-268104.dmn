                <sttrbuilder:maatregelenPossibleOutcomes>
                    <sttrbuilder:maatregelenPossibleOutcome>
                        <sttrbuilder:name>Uitkomst maatregelen</sttrbuilder:name>
                        <sttrbuilder:prescriptions>
                            <sttrbuilder:prescription orderId="1" measureNummer="G25002">
<sttrbuilder:prescription><![CDATA[titelzonderlink=Omgevingsplan gemeente Eindhoven - artikel 10.4 en artikel 22.44]]></sttrbuilder:prescription>
                            </sttrbuilder:prescription>
                            <sttrbuilder:prescription orderId="2" measureNummer="G25006">
<sttrbuilder:prescription><![CDATA[titelzonderlink=Omgevingsplan gemeente Eindhoven - artikel 10.7, artikel 22.49 en artikel 22.50]]></sttrbuilder:prescription>

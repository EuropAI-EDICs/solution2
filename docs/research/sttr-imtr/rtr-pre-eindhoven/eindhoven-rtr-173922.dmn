          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: informatie over de maatregelen die zijn getroffen of worden overwogen om de nadelige gevolgen van het ongewoon voorval te voorkomen\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>

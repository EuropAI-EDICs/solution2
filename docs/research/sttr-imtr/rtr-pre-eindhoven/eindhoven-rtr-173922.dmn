        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Beschrijf de activiteit en het onderwerp waarvoor u een ongewoon voorval wilt melden.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_17213_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:bijlage>
          <uitv:bijlageType>Oorzaken en omstandigheden ongewoon voorval</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Voeg als bijlage toe: informatie over de oorzaken van het ongewoon voorval en de omstandigheden waaronder het voorval zich heeft voorgedaan\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_17214_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>

          <uitv:bijlageType>Informatie vrijgekomen stoffen en hun eigenschappen</uitv:bijlageType>
          <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
        </uitv:bijlage>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Heeft het ongewoon voorval zich voorgedaan bij een milieubelastende activiteit? Voeg dan informatie over de vrijgekomen stoffen en hun eigenschappen toe als bijlage\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>

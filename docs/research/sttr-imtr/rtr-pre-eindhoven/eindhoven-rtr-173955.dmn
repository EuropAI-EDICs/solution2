<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_4924731" name="Conclusie - Dieren slachten en dierlijke bijproducten bewerken of vlees, vis of organen uitsnijden" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_4096_RuleGroup">
        <inter:naam>Slachten van dieren</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_20185_BizRule">
        <uitv:regelgroepRef href="#_4096_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Kies alle werkzaamheden die u gaat uitvoeren.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Slachten van dieren]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Broeien, koken of pekelen van de bij het slachten vrijkomende dierlijke bijproducten]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Uitsnijden van vlees van karkassen of karkasdelen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Uitsnijden van vis]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>5</uitv:sequenceId>
              <uitv:optieText><![CDATA[Uitsnijden en pekelen van organen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>6</uitv:sequenceId>
              <uitv:optieText><![CDATA[Geen van bovenstaande]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_20188_BizRule">
        <uitv:regelgroepRef href="#_4096_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Gaat u per week meer dan 10.000 kilogram levend gewicht aan dieren slachten?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Gaat u hier “Ja” antwoorden? Ga terug naar stap 2: Kies werkzaamheden\. Zoek daar naar “bedrijf in de voedingsmiddelenindustrie” en beantwoordt de vragen\.]]></content:toelichting>
          <content:langeToelichting><![CDATA[Hoeveel dieren geven 10\.000 kilogram levend gewicht?  
Om te toetsen aan deze grens kunnen de onderstaande omrekeningsfactoren worden gebruikt\.

Diersoort \- Levend gewicht \(kg\)

* volwassen runderen en eenhoevigen \- 500
* andere runderen \- 250
* varkens meer dan 100 kg levend gewicht \- 100
* andere varkens \- 75
* schapen en geiten, gedomesticeerde damherten en edelherten \- 50
* rendieren \- 100
* kangoeroes \- 50
* lammeren, jonge geiten en biggen van minder dan 15 kg levend gewicht \- 25
* loopvogels \- 50
* grof vrij wild \- 50
* pluimvee, hazen, konijnen en klein vrij wild \- 3,5]]></content:langeToelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
    </uitv:uitvoeringsregels>
  </semantic:extensionElements>

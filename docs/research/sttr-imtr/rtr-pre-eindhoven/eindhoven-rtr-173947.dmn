    <semantic:decisionTable id="_20100_BizRule_td" hitPolicy="COLLECT" outputLabel="Conclusie - AfscheidingDakterras">
      <semantic:input id="_5490913">
        <semantic:inputExpression typeRef="feel:boolean">
          <semantic:text>Toestemmingen - Vergunningvrij - AfscheidingDakterras</semantic:text>
        </semantic:inputExpression>
      </semantic:input>
      <semantic:output id="_4059303" />
      <semantic:rule id="_5627045">
        <semantic:inputEntry id="_7589746">
          <semantic:text>false</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_5771452">
          <semantic:extensionElements>
            <content:conclusieToelichting>
              <content:toelichting><![CDATA[De gemeente gaat beoordelen of uw \(ver\)bouwplannen voldoen aan de regels in het omgevingsplan\. In het omgevingsplan legt de gemeente vast wat er met de ruimte in de gemeente mag gebeuren\. Bijvoorbeeld waar woningen of bedrijven mogen komen en welke afmetingen die mogen hebben\.]]></content:toelichting>
            </content:conclusieToelichting>
          </semantic:extensionElements>
          <semantic:text>"Vergunningplicht"</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
      <semantic:rule id="_2019875">
        <semantic:inputEntry id="_3300456">
          <semantic:text>true</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_1172477">
          <semantic:text>"Toestemmingsvrij"</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
    </semantic:decisionTable>
  </semantic:decision>

        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>5</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Hoe hoog wordt dat deel van het nieuwe bouwwerk dat op meer dan 4 meter van het oorspronkelijke hoofdgebouw ligt?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>enkelAntwoord</uitv:optieType>
            <uitv:optie>

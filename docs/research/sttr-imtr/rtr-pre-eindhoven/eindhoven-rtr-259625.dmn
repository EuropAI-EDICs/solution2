<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="woning splitsing" id="_c41bda26_b898_4d00_8ae6_2611f772a6c3" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_4194ad34-c18b-4cbe-b0af-a1fa681a2869">
                <inter:naam>testvraag vanuit woningsplitsing</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__dead50f7-d9fb-4d3f-89c5-95b44c6be990">
                <uitv:herbruikbaarId>2013c826-cd96-4560-89c1-2b6e193e7b2c</uitv:herbruikbaarId>
                <uitv:regelgroepRef href="#_4194ad34-c18b-4cbe-b0af-a1fa681a2869"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Bent u van plan (een deel van) uw woning te wijzigen naar kamerbewoning of wordt het pand gesplitst in meerdere woningen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[LET OP: Als u van plan bent iets in de woning aan te passen moet u __ook__ de vergunningcheck invullen voor de werkzaamheid ‘bouwwerk veranderen’. Het is mogelijk dat u ook voor het veranderen van uw woning een aparte vergunning moet indienen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__54032be0-04db-4ed7-9a55-d16a0ddad39d">
                <uitv:herbruikbaarId>ba74d878-e023-4595-9bff-851f1e68a066</uitv:herbruikbaarId>
                <uitv:regelgroepRef href="#_4194ad34-c18b-4cbe-b0af-a1fa681a2869"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Ligt de woning in een van de door ons als gemeente aangewezen op-slot-gebieden?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In sommige delen van Eindhoven staat de leefbaarheid al zodanig onder druk dat we deze niet willen laten verslechteren. Daarom wordt in de volgende buurten/wijken geen vergunning verleend voor het wijzigen van een woning naar __kamerbewoning__:

*   [Limbeek-Noord](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Limbeek-Noord&location=16,51.44857,5.46379&basemap=jawg.light "(opent in een nieuw venster)")
*   [Limbeek-Zuid](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Limbeek-Zuid&location=17,51.44437,5.46818&basemap=jawg.light "(opent in een nieuw venster)")
*   [Bennekel-Oost](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Bennekel-Oost&location=16,51.41957,5.46327&basemap=jawg.light "(opent in een nieuw venster)")
*   [Doornakkers-Oost](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Doornakkers-Oost&location=15,51.43864,5.51791&basemap=jawg.light "(opent in een nieuw venster)")
*   [Doornakkers-West](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Doornakkers-West&location=15,51.43945,5.50847&basemap=jawg.light "(opent in een nieuw venster)")
*   [Woensel-West](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtcode=421&location=15,51.45767,5.45744&basemap=jawg.light "(opent in een nieuw venster)")
*   [Hemelrijken](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Hemelrijken&location=16,51.44862,5.46998&basemap=jawg.light "(opent in een nieuw venster)")
*   [Gildebuurt](https://data.eindhoven.nl/explore/dataset/buurten/map/?refine.buurtnaam=Gildebuurt&location=16,51.44911,5.47472&basemap=jawg.light "(opent in een nieuw venster)")]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

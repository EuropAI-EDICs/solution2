                <dmn:inputEntry id="_d6f2d338_ac33_4973_8534_e910116baac9">
                    <dmn:text><![CDATA[if ?=null then false else contains(?,"Ergens anders")]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_757aef37_6391_41a6_8c44_9b02529920f1">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_a3b12021_e099_4770_918d_000badf976c4">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>

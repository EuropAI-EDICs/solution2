            <dmn:rule id="_955ff6e4_c736_4b60_b34d_49e33a5edba3">
                <dmn:inputEntry id="_53a96691_8261_4018_a0b1_934041612990">
                    <dmn:text><![CDATA[if ?=null then false else contains(?,"Ergens anders")]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_2f1e68f8_6dbc_460b_acf6_e7b2d851bdd7">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_f294e766_7e4c_4eee_93cf_befbb6b48d2e">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_42f67be0_b510_48d4_8d22_ad3122eb7133">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_5531b8ba_232b_41a2_83f5_40aee363f21e">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_9472b7b0_9b5f_48ba_81b4_fdffbcd5abd7">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_c79ade2a_cd72_405e_aa61_da179338108f">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_f09b285b_07d6_4d70_932b_d35d97dba8bf">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_0c85984b_2544_4edd_abed_cbcee915bbfd">
                    <dmn:text><![CDATA["De grond is ernstig vervuild en de sanering heeft spoed"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_994a3f62_ce8a_4c22_ae05_baa638f38835">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>

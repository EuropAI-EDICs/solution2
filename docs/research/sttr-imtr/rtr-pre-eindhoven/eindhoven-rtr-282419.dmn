<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Kleinschalig graven 25 m3 of minder in bodem met een kwaliteit boven de interventiewaarde bodemkwaliteit" id="_5ed193aa_fa05_4298_91c1_4a917db35dcd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_50d26402-26a2-4b1c-826d-e86063cad943">
                <inter:naam>Plaats, grootte en uitvoering van het graafwerk</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_572ee5ae-de34-4721-8b56-77f6fe21e522">
                <inter:naam>Kwaliteit van de Grond</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__8e11b6f0-d59c-4c1b-ad59-86977b746a82">
                <uitv:regelgroepRef href="#_50d26402-26a2-4b1c-826d-e86063cad943"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Waar gaat u graven?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                        <uitv:optieGeenVanBovenstaande>false</uitv:optieGeenVanBovenstaande>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[De grond die hoort bij mijn woning]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Het maakt niet uit of de woning uw eigendom is, of dat u de woning huurt. Het is alleen van belang dat het graven bij een woning gebeurt en niet bij een bedrijf of ander bedrijfsgebouw (zoals kantoor of garage).]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ergens anders]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Bijvoorbeeld bij grond die hoort bij een bedrijf of de openbare ruimte.

De openbare ruimte is bijvoorbeeld de stoep voor uw woning. Wanneer u bijvoorbeeld een geveltuintje wilt aanleggen moet u in de openbare ruimte graven.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Onder graven wordt ook verstaan:

1.  het zeven van de uitkomende grond op dezelfde locatie;
2.  het tijdelijk opslaan van grond; en
3.  het terugplaatsen van grond na afloop van tijdelijk uitnemen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c4130337-593a-4c96-95ab-6365ddf3e77c">
                <uitv:regelgroepRef href="#_50d26402-26a2-4b1c-826d-e86063cad943"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u zelfstandig graven?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, ik ga zelf graven]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, ik besteed het graven uit]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Besteedt u het graven uit (via een aannemer) en krijgt u professionele hulp, dan gaat u niet zelfstandig graven. Kiest u dan voor ‘nee, ik besteed het graven uit’.

Gaat u zelf graven, gaat u samen met hulp van vrienden of familie graven of laat u het graven helemaal over aan vrienden of familie zien wij dit nog steeds als zelfstandig graven. Kiest u dan voor ‘ja, ik ga zelf graven’.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__077f24a8-d4a9-4622-9e21-cb3b005ac23c">
                <uitv:regelgroepRef href="#_50d26402-26a2-4b1c-826d-e86063cad943"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u graven in grond dat direct aan water ligt?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, ik ga in de buurt van water graven]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, ik ga niet in de buurt van water graven]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Met water bedoelen wij sloten, beken, rivieren, kanalen, maar ook vijvers of meren die in verbinding staan met ander water.

Het kan zo zijn dat uw tuin aan zo’n water grenst. Als u dan in het gedeelte van uw grond gaat graven dat aan het water grenst, is die grond vaak anders (vaak natter) dan wanneer u verder weg van het water gaat graven.

Vult u hier ja in, dan hebben wij als gemeente geen verdere informatie nodig. Het kan wel zijn dat u voor het Waterschap nog iets moet doen (bijvoorbeeld informatie aanleveren). Of dat het geval is ziet u op de volgende pagina nadat u alle vragen van de vergunningcheck hebt doorlopen.

Deze vraag lijkt op een vraag die u al hebt beantwoord. Dit komt doordat er hetzelfde stukje grond andere regels vanuit het Rijk (regels die gelden voor heel Nederland) kunnen gelden dan vanuit ons als gemeente (lokale regels). Daarom moeten wij deze vraag nog een keer stellen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9fef5912-3626-4fb8-aaa4-76ab7be6bb0d">
                <uitv:regelgroepRef href="#_50d26402-26a2-4b1c-826d-e86063cad943"/>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Hoe groot wordt het gat dat u gaat graven?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[25 m3 of minder]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[meer dan 25 m3]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[U kunt het volume in m3 berekenen door lengte x breedte x diepte van het gat te nemen. Bijvoorbeeld: 2m x 2m x 2m = 8m3. 25m3 is ongeveer evenveel als één volle vrachtwagen met grond.

Gaat u bijvoorbeeld kabels in de grond leggen (voor bijvoorbeeld verlichting van uw tuin of het opladen van uw elektrische auto), gaat graven voor het planten/verwijderen van enkele bomen of planten of gaat u graven voor de aanleg van een kleine schuur of kleine veranda, dan zult u onder de 25 m3 blijven.

De hoeveelheid grond die u voor een standaard inbouwzwembad moet (laten) uitgraven is ongeveer 50m3.

Gaat u graven om bijvoorbeeld een trampoline in te graven, of gaat u graven voor het aanleggen van een klein zwembad of kleine (vis)vijver (zo groot als een trampoline), dan zult u onder 25 m3 blijven.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__68a9c392-8cde-42d4-ac11-34b643f3a3a3">
                <uitv:regelgroepRef href="#_50d26402-26a2-4b1c-826d-e86063cad943"/>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is een kabel of leiding in de grond stuk en moet die met spoed gerepareerd worden?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, ik ga graven omdat met spoed een kabel of leiding gerepareerd moet worden]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In sommige gevallen moet u voordat u mag beginnen met graven een melding bij ons maken van uw graafwerkzaamheden. U mag dan nog niet beginnen met de werkzaamheden. Maar als het om spoed gaat, zoals bij een breuk, hoeft u niet vooraf een melding te maken. U mag dan direct beginnen met graven en hoeft dan pas later een melding te maken.

Bij leidingen moet u denken aan het weer in orde maken van bijvoorbeeld gasleidingen, drinkwaterleidingen of rioolleidingen.

Bij kabels moet u denken aan het weer in orde maken van bijvoorbeeld de elektriciteitskabel of een glasvezelkabel.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c52c91f2-cc15-4fe6-95ae-174b7197dc70">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er vóór 1 januari 2024 een besluit genomen over de vervuiling van de grond?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, er is een besluit]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, er is geen besluit]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik weet niet of er al een besluit is genomen vóór 1 januari 2024]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Als er vóór 1 januari 2024 al een besluit is genomen over vervuiling van de grond, gelden mogelijk de oude regels van de Wet bodembescherming. Dit kan betekenen dat u langer moet wachten voordat u mag graven.  
Weet u niet zeker of dit voor u van toepassing is? Neem dan contact op met de Omgevingsdienst Zuid Oost Brabant door te bellen naar 088 3690545 of een mail te sturen naar [bodemloket@odzob.nl](mailto:bodemloket@odzob.nl "mailto:bodemloket@odzob.nl"). Zij kunnen u hier verder bij helpen.

U kunt ook in het Kadaster kijken. In het kadaster ziet u vervuilde grond terug als een ‘artikel 55-registratie’.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f5204b6b-d358-489b-bc9d-f98282337830">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Geldt het besluit over de vervuilde grond nog steeds?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, het besluit geldt nog steeds]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, het besluit geldt niet meer]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Als de grond inmiddels is schoongemaakt én u heeft hier een nieuw besluit over ontvangen, dan geldt het oude besluit niet meer. Dan kiest u nee. Als de grond nog niet is schoongemaakt of u heeft nog geen nieuw besluit ontvangen, dan kiest u ja.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__3f9d13ff-ac8e-4385-8fe1-f78ba11204b6">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat voor besluit heeft u?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Beschikking instemming saneringsplan]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Besluit uniforme sanering]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6e71f4ed-43b0-4175-bb77-2c24bb17b43d">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wat is de uitkomst van het besluit over de ernst en de spoed van de vervuiling?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[De grond is ernstig vervuild en de sanering heeft spoed]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[De grond is ernstig vervuild, maar de sanering heeft geen spoed]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[De grond is niet ernstig vervuild]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ae749681-e215-4266-ba97-857f00db29e9">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[De grond is niet ernstig vervuild, maar licht vervuild. Is de vervuiling boven de grenswaarde die wij als gemeente stellen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de grond is toch nog zo vervuild dat de waardes van de vervuiling meer zijn dan de grenswaardes]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, de vervuiling is zo licht dat de waardes onder de grenswaardes liggen]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Deze informatie kan in het besluit staan. Staat deze informatie niet in het besluit of weet u niet meer wat er in het besluit hierover staat, dan kunt op onze [bodeminformatiewebsite](https://www.eindhoven.nl/bouwen/grond-en-vastgoed/bodeminformatie) kijken voor meer informatie. Ook kunt u via onze site informatie over uw grond opvragen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__a8394962-ad5c-4b51-b430-1f08145752eb">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>110</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Het besluit heeft goedkeuring gegeven voor het saneren op basis van een ingediend plan. Gaat u volgens dit ingediende plan graven?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, ik ga graven volgens het ingediende saneringsplan]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, ik ga niet graven volgens het ingediende saneringsplan]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik weet niet of ik ga graven volgens het ingediende saneringsplan]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__454a9162-3f72-4637-84df-4a776f8207f7">
                <uitv:regelgroepRef href="#_572ee5ae-de34-4721-8b56-77f6fe21e522"/>
                <inter:prioriteit>120</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Weet u of de grond waarin u wilt gaan graven vervuild is?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, de grond is vervuild]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, de grond is niet vervuild]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ik weet niet of de grond vervuild is]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[In de grond zitten stoffen zoals lood, koper, kwik, zink of minerale olie. Als er te veel van zulke stoffen in de grond zitten, noemen we dat vervuilde grond. Dit kan namelijk gevaarlijk zijn voor mensen, dieren of planten. De maximale hoeveelheid van een stof die is toegestaan in de grond noemen we de interventiewaarde.

Wilt u weten of de grond op de plek waar u wilt graven vervuild is? Kijk op onze bodeminsformatiesite of bij het Bodemloket. U kunt daar zien of er eerder bodemonderzoek is gedaan. Ook vindt u daar de kwaliteitskaart, de interventiewaardes voor de stoffen en informatie over mogelijke verontreinigen. Weet u het niet zeker? Kies dan ‘Ik weet het niet’]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

            <dmn:rule id="_5192638e_f28f_4edc_b8bc_3b2314d16467">
                <dmn:inputEntry id="_18083892_5cbe_4f7d_8e12_69c84e69a884">
                    <dmn:text><![CDATA["Nee, ik besteed het graven uit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_cdbd2e1c_a036_4118_9bad_7b47e49f3aa3">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_d3ba4993_ea6b_4978_bc7b_9e6b1cb650aa">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_b05b9f18_43f9_4945_9338_c29cb9f98695">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_baf1b977_9c19_40f0_a396_a613269b598d">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_a5bb16f9_4f1a_4620_833c_0f4cd8e3a29a">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_7b3a6150_6e4f_48a8_84b2_3c3879832222">
                    <dmn:text><![CDATA["Beschikking instemming saneringsplan"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_0c4bda7a_413d_4fa0_b517_23b38fdbcc01">
                    <dmn:text><![CDATA["Ik weet niet of ik ga graven volgens het ingediende saneringsplan"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_48a10902_ea9a_401d_b96b_88c956669edd">
                    <dmn:text><![CDATA["Neem contact op met"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
            <dmn:rule id="_9bf6eb36_57a0_4d9a_9746_2dc44a70dfef">
                <dmn:inputEntry id="_0553ec3e_d04f_4597_8048_25a7b761c79c">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>
                </dmn:inputEntry>

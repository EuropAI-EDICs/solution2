                <dmn:inputEntry id="_788eeedf_538d_4195_838e_d07b56e0ee96">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_807aba60_2491_4438_9bf5_0b7951f98686">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_20e25959_0089_49e6_ae3c_90f93ada37fa">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_8cdde766_40e9_4d55_8b7b_24509202357e">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_66335453_916b_423e_b111_6d189d3e7ac8">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_9edd3978_a17d_4d24_bc56_fb53a192108b">
                    <dmn:text><![CDATA["De grond is ernstig vervuild, maar de sanering heeft geen spoed"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_70f3d8a9_ab96_4c2f_b921_de84f60f979b">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>

                <dmn:inputEntry id="_a66ee114_28ac_4195_8dc8_ed35fde4d527">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_fb2ccf7a_6b48_4293_9083_5f8c9eabc9da">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_25cf9af5_b185_4a8a_bf29_b12d27cbcc67">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>

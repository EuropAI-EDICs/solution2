            <dmn:rule id="_b0dd0bb5_559b_4449_b9e4_1f33745901cb">
                <dmn:inputEntry id="_baaf0d4c_066f_4d68_a2bd_7280a11bcab9">
                    <dmn:text><![CDATA[if ?=null then false else contains(?,"Ergens anders")]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_4ba04f70_6c07_4e81_a4e7_e2972f0495c0">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_6d9a719f_afba_4fcd_a22e_f605a58431b0">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_cda14588_508a_45e6_b1db_70b498ec49bb">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_68042d4c_fa87_4859_abbd_923cc4333399">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_ccf3cf8b_922e_4c92_9f59_9e0a3867626a">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_bb8dd852_e5c5_44b4_a372_7003d30fce65">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_adce203f_e23c_47ae_bdb1_628c9b4a8fa6">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_9ad0f142_8f62_46ed_aa51_43e34b3b0c3f">
                    <dmn:text><![CDATA["De grond is niet ernstig vervuild"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_b1027089_f6a5_4110_a82d_ef9d051af010">
                    <dmn:text><![CDATA["Ja, de grond is toch nog zo vervuild dat de waardes van de vervuiling meer zijn dan de grenswaardes"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_56c8e614_5584_4274_a821_383f2500312d">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>

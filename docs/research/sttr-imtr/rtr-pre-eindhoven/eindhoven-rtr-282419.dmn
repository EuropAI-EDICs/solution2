            <dmn:rule id="_59d6a116_cb71_4449_9ec5_4efa1d2fb8e5">
                <dmn:inputEntry id="_3390be70_22a8_45f1_a27b_b7fc5f350f75">
                    <dmn:text><![CDATA[if ?=null then false else contains(?,"Ergens anders")]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_9deaab78_1067_4ad8_ac3a_cd591c941af7">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_ad7738a2_2ca7_4757_a9d4_28d8e34afa78">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_62b1fa30_04ac_4536_9bd2_30718ef549b1">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_ef642951_48c4_4ad7_804d_ea3ad6093b54">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_a2052c11_e8bd_4d8e_9a70_0e3c28f44fd8">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_3cf4da17_9b03_437b_9513_f0bec80a956e">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_a02d4eed_bb85_4a10_862a_07211b369a28">
                    <dmn:text><![CDATA["Beschikking instemming saneringsplan"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_f01a26b6_bc8e_46ee_a33a_2c8ef8d1d542">
                    <dmn:text><![CDATA["Nee, ik ga niet graven volgens het ingediende saneringsplan"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_2cecf775_02cd_48ae_aa3b_17411a40ec77">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>

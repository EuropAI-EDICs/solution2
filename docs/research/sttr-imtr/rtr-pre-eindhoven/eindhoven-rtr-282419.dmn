                            <sttrbuilder:answer rowId="27a6606e-62fc-407e-a1c1-03f95c7cb8d4" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[Nee, er is geen besluit]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                            <sttrbuilder:answer rowId="c66db3c5-d608-4bff-b7f2-7422003a6c37" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[Ik weet niet of de grond vervuild is]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                        </sttrbuilder:answers>
                    </sttrbuilder:questionPath>
                    <sttrbuilder:questionPath>
                        <sttrbuilder:outcome><![CDATA[Neem contact op met]]></sttrbuilder:outcome>
                        <sttrbuilder:information><![CDATA[Weet u niet zeker hoe vervuild de bodem is op de plek waar u wilt graven? Of weet u niet of er eerder een bodemonderzoek is gedaan? Neem dan contact op met de Omgevingsdienst Zuidoost Brabant (ODZOB) via mail: [bodemloket@odzob.nl](mailto:bodemloket@odzob.nl "mailto:bodemloket@odzob.nl") of telefonisch: 088 3690545. Zij kunnen met u meekijken wat er nodig is en of u mogelijk nog een melding moet doen.]]></sttrbuilder:information>
                        <sttrbuilder:outcomeId><![CDATA[NeemContactOpMet]]></sttrbuilder:outcomeId>
                        <sttrbuilder:answers>
                            <sttrbuilder:answer rowId="3ad75388-bc5e-4cef-8a74-71259386be48" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[Nee, ik besteed het graven uit]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                            <sttrbuilder:answer rowId="12459965-dbd8-4c5f-8c0b-1b47f200375e" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[Nee, ik ga niet in de buurt van water graven]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                            <sttrbuilder:answer rowId="69afa5ae-5260-4ca3-88e1-1e7de82fdd10" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[25 m3 of minder]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                            <sttrbuilder:answer rowId="9aad8f2e-15e9-4fd0-a4ca-6643d4fedd69" operand="OR">
<sttrbuilder:multipleValues>
    <sttrbuilder:value><![CDATA[Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden]]></sttrbuilder:value>
</sttrbuilder:multipleValues>
                            </sttrbuilder:answer>
                            <sttrbuilder:answer rowId="27a6606e-62fc-407e-a1c1-03f95c7cb8d4" operand="OR">
<sttrbuilder:multipleValues>

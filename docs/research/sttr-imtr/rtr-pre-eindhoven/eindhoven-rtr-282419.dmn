            <dmn:rule id="_eca100df_a492_43a7_b8c7_ca1ada0b31fc">
                <dmn:inputEntry id="_30a2ba24_eecf_4a53_be6f_a58c38c08cd1">
                    <dmn:text><![CDATA["Nee, ik besteed het graven uit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_8d700a34_1d32_4763_8c4f_c9a8516836a8">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_c0b6862c_af6c_4728_be2c_7a4a64a001bb">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_50c7f4e6_5b55_4e3a_97f6_8322e7620379">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_d90d8a77_30ec_4933_b860_b91d7fc4997d">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_d93d5fc4_2f91_45f6_872c_efa51a9f8dfe">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_19e23547_6fe6_4665_bfd7_5442506f35cf">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_eec7fde2_c0a6_4498_823e_2003a09d1312">
                    <dmn:text><![CDATA["De grond is ernstig vervuild en de sanering heeft spoed"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_5a3971e0_8d87_40e7_b356_889caf5de84c">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
            <dmn:rule id="_a2079179_9443_4f71_88cd_c535b98c5789">
                <dmn:inputEntry id="_c95f7bb3_a76f_49e6_a12e_e0e9ff3e633a">
                    <dmn:text><![CDATA["Ja, ik ga zelf graven"]]></dmn:text>

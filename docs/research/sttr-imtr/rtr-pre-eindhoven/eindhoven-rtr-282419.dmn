            <dmn:rule id="_c72005c0_8288_4113_a53c_49f5965aaf52">
                <dmn:inputEntry id="_75032dfb_29b6_48ca_a64e_9f890da83332">
                    <dmn:text><![CDATA["Nee, ik besteed het graven uit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_5f0bbc8e_56b5_401f_bf3a_3047f2c647cd">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_10c93ea6_e1ab_4fa9_b8f0_ed122c3b9495">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_0e36a935_d9b0_4703_a50d_73b848c2c2ef">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_af6e3e92_c87f_4ab6_bfe4_335e80fc1d2b">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_b38b8bcb_3a82_444d_b7ef_5ace77b08347">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_dcb895a3_46fc_4632_be68_26a222fcc8a3">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_e846cc38_2287_4b1b_b77b_93d4bdaffc7c">
                    <dmn:text><![CDATA["De grond is ernstig vervuild, maar de sanering heeft geen spoed"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_27b7d0fe_b110_49fd_a8ca_64eac7504376">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>
            </dmn:rule>

            <dmn:rule id="_92e70972_5f53_485d_ad3b_935ad02af96f">
                <dmn:inputEntry id="_c99b87fd_b62a_4be2_a8e2_ca910279cfaa">
                    <dmn:text><![CDATA["Nee, ik besteed het graven uit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_8cd58219_e7cc_4f6b_b0f9_27f28180f25f">
                    <dmn:text><![CDATA["Nee, ik ga niet in de buurt van water graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_0b77b30f_ed99_4e03_865a_e6377a100d3d">
                    <dmn:text><![CDATA["25 m3 of minder"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_5aeee536_082b_43c0_ba86_47084798c42c">
                    <dmn:text><![CDATA["Nee, ik ga wel graven, maar dat is niet omdat er snel iets gerepareerd moet worden"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_0a89f257_e887_4706_9112_f5225423e01c">
                    <dmn:text><![CDATA["Ja, er is een besluit"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_9b986dc1_f38f_4636_8f05_f645d9618c24">
                    <dmn:text><![CDATA["Ja, het besluit geldt nog steeds"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_826285a0_5607_4f7d_ae56_69054c66997b">
                    <dmn:text><![CDATA["Een beschikking over de ernst en de spoed van de vervuiling op de plek waar u gaat graven"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_801d85dc_7a95_4413_b530_c94cce3b3c53">
                    <dmn:text><![CDATA["De grond is niet ernstig vervuild"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="_f48880e6_6cff_4988_b750_716a1e564ead">
                    <dmn:text><![CDATA["Ja, de grond is toch nog zo vervuild dat de waardes van de vervuiling meer zijn dan de grenswaardes"]]></dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="_6123d33f_f6b0_4c0f_9187_25ff8c1b5a57">
                    <dmn:text><![CDATA["Informatieplicht"]]></dmn:text>
                </dmn:outputEntry>

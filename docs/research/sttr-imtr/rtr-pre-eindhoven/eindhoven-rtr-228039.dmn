                 exporter="Geodan FLO Legal STTR Builder" exporterVersion="" id="_c2353218-977a-4436-acb9-a0cd94470f99"
                 name="Uitweg maken hebben of veranderen of het gebruik daarvan veranderen">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="groep1">
    <inter:naam>Uitweg maken hebben of veranderen of het gebruik daarvan veranderen Eindhoven</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__fddfd4d0-f5a7-4c64-bcfb-9589042ad86d">
        <uitv:regelgroepRef href="#groep1"/>
            <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Gaat u een uitweg aanleggen naar een openbare weg?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Een uitweg is een weg om ergens uit te komen, zoals bijvoorbeeld een bouwperceel of de oprit van uw eigen woning of bedrijventerrein.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[Alle openbare wegen binnen onze gemeente zijn in beheer bij de gemeente. U zal dus altijd bij de gemeente een aanvraag in moeten dienen.

LET OP: U dient wel rekening te houden met de regels die hiervoor gelden. Zie hiervoor onze website: [Omgevingsvergunning uitweg | Gemeente Eindhoven](https://www.eindhoven.nl/bouwen/vergunningen/omgevingsvergunning-uitweg?suggestie=Omgevingsvergunning%20uitweg)]]></content:langeToelichting>
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__64d2068b-1639-4d5c-beab-88fb876c55f0">
        <uitv:regelgroepRef href="#groep1"/>
            <inter:prioriteit>20</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>list</uitv:gegevensType>
    <uitv:vraagTekst>Gaat u een bestaande uitweg veranderen of een nieuwe uitweg maken</uitv:vraagTekst>
                <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                            <uitv:optie>
                    <uitv:sequenceId>0</uitv:sequenceId>
                    <uitv:optieText>bestaande uitweg veranderen</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>1</uitv:sequenceId>
                    <uitv:optieText>nieuwe uitweg maken</uitv:optieText>
                                    </uitv:optie>
                    </uitv:opties>
    </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Een uitweg is een weg om ergens uit te komen, zoals bijvoorbeeld een bouwperceel of de oprit van uw eigen woning of bedrijventerrein.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[Alle openbare wegen binnen onze gemeente zijn in beheer bij de gemeente. U zal dus altijd bij de gemeente een aanvraag in moeten dienen.

LET OP: U dient wel rekening te houden met de regels die hiervoor gelden. zie hiervoor onze website: [Omgevingsvergunning uitweg | Gemeente Eindhoven](https://www.eindhoven.nl/bouwen/vergunningen/omgevingsvergunning-uitweg?suggestie=Omgevingsvergunning%20uitweg)]]></content:langeToelichting>
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        

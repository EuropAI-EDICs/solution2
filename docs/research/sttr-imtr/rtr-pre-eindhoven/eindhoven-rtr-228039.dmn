                    <content:conclusieToelichting>
                        <content:toelichting><![CDATA[Als u een uitweg gaat aanleggen die uitkomt op een eigen weg, dan mag dit zonder toestemming van de gemeente.]]></content:toelichting>
                    </content:conclusieToelichting>
                </dmn:extensionElements>
                        <dmn:text><![CDATA["Toestemmingsvrij"]]></dmn:text>
        </dmn:outputEntry>

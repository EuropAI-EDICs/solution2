            <dmn:input id="_9b6233d7-3dd0-4cb1-add5-9c31c2c2be9b" label="Is er op de locatie (het kadastrale perceel) waarop u iets van plan bent een gemeentelijk monument of een voorbeschermd gemeentelijk monument aanwezig?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_956c7d06-809f-4ce4-be73-d85fe676bf0a</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_9e014d12-d098-448a-8ee1-8cb767b7e089" label="Bent u van plan het monument anders te gaan gebruiken?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_d10d3e09-b1ba-4a78-aafa-7c0f12da3474</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_88c5db71-0f8c-402b-aad1-a51506f9afe4" label="Bent u van plan om werkzaamheden uit te voeren aan het monument?">
            <dmn:inputExpression typeRef="feel:boolean">
                <dmn:text>_9e62bc92-b319-4c72-86fa-df8ca3bd8d0c</dmn:text>
            </dmn:inputExpression>
        </dmn:input>
            <dmn:input id="_36fc8f41-3505-40ec-9c19-2299ecb25b4e" label="Om wat voor een monument of voorbeschermd monument gaat het?">

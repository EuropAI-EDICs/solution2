      <uitv:uitvoeringsregel id="_18957_BizRule">
        <uitv:regelgroepRef href="#_3959_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Detailhandel: Geef aan welke installaties binnen uw bedrijf aanwezig zijn?]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optieGeenVanBovenstaande>true</uitv:optieGeenVanBovenstaande>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[één of meer elektromotoren met een gezamenlijk vermogen van meer dan 1,5 kW]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Let op\! U hoeft elektromotoren met een vermogen van 0,25 kW of minder niet mee te tellen bij het totaal\.]]></content:toelichting>
                <content:belangrijk>true</content:belangrijk>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[één of meer stookinstallaties met een nominaal thermisch ingangsvermogen van meer dan 130 kW]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_27238_BizRule">
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <uitv:implicietAntwoord>
          <uitv:werkzaamheid urn="SchietbaanExploiteren" />
          <uitv:waarde>true</uitv:waarde>

      <semantic:rule id="_8378973">
        <semantic:inputEntry id="_9781362">
          <semantic:text>if ?=null then false else (contains(?,"Aanbouw, uitbouw of bijgebouw (bijbehorend bouwwerk) bouwen") or contains(?,"Andere nieuw te bouwen bouwwerken dan hierboven genoemd") or contains(?,"Stacaravan, vakantiehuis  of ander recreatief nachtverblijf plaatsen") or contains(?,"Bouwwerk ten behoeve van het verkeer, de infrastructuur of openbare voorziening plaatsen") or contains(?,"Bouwwerk voor agrarische bedrijfsvoering plaatsen") or contains(?,"Bouwkeet, bouwbord, steiger, of andere hulpconstructie voor bouw-, sloop- of aanlegwerkzaamheden plaatsen") or contains(?,"Tuinmeubilair plaatsen") or contains(?,"Sport- of speeltoestel plaatsen") or contains(?,"Antenne plaatsen") or contains(?,"Zwembad, bubbelbad of soortgelijke voorziening of vijver plaatsen") or contains(?,"Buisleiding aanleggen"))
</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_2933034">

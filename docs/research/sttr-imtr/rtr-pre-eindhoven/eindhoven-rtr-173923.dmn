      <semantic:output id="_5884328" />
      <semantic:rule id="_3886696">
        <semantic:inputEntry id="_962839">
          <semantic:text>if ?=null then false else (contains(?,"Aanbouw, uitbouw of bijgebouw (bijbehorend bouwwerk) bouwen") or contains(?,"Andere nieuw te bouwen bouwwerken dan hierboven genoemd") or contains(?,"Stacaravan, vakantiehuis  of ander recreatief nachtverblijf plaatsen") or contains(?,"Bouwwerk ten behoeve van het verkeer, de infrastructuur of openbare voorziening plaatsen") or contains(?,"Bouwwerk voor agrarische bedrijfsvoering plaatsen") or contains(?,"Bouwkeet, bouwbord, steiger, of andere hulpconstructie voor bouw-, sloop- of aanlegwerkzaamheden plaatsen") or contains(?,"Zwembad, bubbelbad of soortgelijke voorziening of vijver plaatsen") or contains(?,"Buisleiding aanleggen"))</semantic:text>
        </semantic:inputEntry>
        <semantic:outputEntry id="_9712829">
          <semantic:text>true</semantic:text>
        </semantic:outputEntry>
      </semantic:rule>
      <semantic:rule id="_9613452">
        <semantic:inputEntry id="_6953487">
          <semantic:text>if ?=null then false else not (contains(?,"Aanbouw, uitbouw of bijgebouw (bijbehorend bouwwerk) bouwen") or contains(?,"Andere nieuw te bouwen bouwwerken dan hierboven genoemd") or contains(?,"Stacaravan, vakantiehuis  of ander recreatief nachtverblijf plaatsen") or contains(?,"Bouwwerk ten behoeve van het verkeer, de infrastructuur of openbare voorziening plaatsen") or contains(?,"Bouwwerk voor agrarische bedrijfsvoering plaatsen") or contains(?,"Bouwkeet, bouwbord, steiger, of andere hulpconstructie voor bouw-, sloop- of aanlegwerkzaamheden plaatsen") or contains(?,"Zwembad, bubbelbad of soortgelijke voorziening of vijver plaatsen") or contains(?,"Buisleiding aanleggen"))</semantic:text>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<semantic:definitions xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:triso="http://www.rulearts.com/modeling" xmlns:trisofeed="http://rulearts.com/feed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" exporter="RuleArts STTR Export" exporterVersion="0.2.0" id="_9975547" name="Indieningsvereisten - Vergunning - Aanvraagvereisten binnenplanse omgevingsvergunning omgevingsplanactiviteit bouwwerken" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
  <semantic:extensionElements xmlns:semantic="http://www.omg.org/spec/DMN/20151101/dmn.xsd">
    <inter:regelgroepen xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel">
      <inter:regelgroep id="_3330_RuleGroup">
        <inter:naam>Algemeen</inter:naam>
        <inter:prioriteit>10</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3359_RuleGroup">
        <inter:naam>Woningen</inter:naam>
        <inter:prioriteit>20</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3331_RuleGroup">
        <inter:naam>Gebruik</inter:naam>
        <inter:prioriteit>20</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3336_RuleGroup">
        <inter:naam>Bruto vloeroppervlakte bouwwerk</inter:naam>
        <inter:prioriteit>30</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3337_RuleGroup">
        <inter:naam>Bruto inhoud bouwwerk</inter:naam>
        <inter:prioriteit>40</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3398_RuleGroup">
        <inter:naam>Plaats van het bouwwerk</inter:naam>
        <inter:prioriteit>50</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4377_RuleGroup">
        <inter:naam>Oppervlakte bebouwd perceel</inter:naam>
        <inter:prioriteit>60</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4385_RuleGroup">
        <inter:naam>Hoogte bouwwerk</inter:naam>
        <inter:prioriteit>63</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4386_RuleGroup">
        <inter:naam>Parkeervoorzieningen</inter:naam>
        <inter:prioriteit>66</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_3320_RuleGroup">
        <inter:naam>Seizoensgebonden en tijdelijke bouwwerken</inter:naam>
        <inter:prioriteit>70</inter:prioriteit>
      </inter:regelgroep>
      <inter:regelgroep id="_4380_RuleGroup">
        <inter:naam>Bodemonderzoek</inter:naam>
        <inter:prioriteit>80</inter:prioriteit>
      </inter:regelgroep>
    </inter:regelgroepen>
    <uitv:uitvoeringsregels>
      <uitv:uitvoeringsregel id="_24072_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Beschrijf de werkzaamheden waarvoor u een vergunning aanvraagt in een paar zinnen.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Beschrijf alle werkzaamheden die u gaat uitvoeren\. Geef hierbij aan of u een nieuw bouwwerk gaat realiseren of een bestaand bouwwerk gaat verbouwen, uitbreiden of hieraan andere bouwwerkzaamheden gaat verrichten, bijvoorbeeld in verband met onderhoud\.  
Gaat u meerdere bouwwerken bouwen? Geef hier dan alle bouwwerken op die u gaat bouwen\. Denk bijvoorbeeld aan: ik ga mijn woning uitbouwen en een tuinhuisje plaatsen\.  
Vraagt u deze vergunning aan om van de gemeente een oordeel te krijgen dat u voor het aangevraagde bouwwerk geen vergunning nodig heeft? Geef dit hier dan aan\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_26021_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>40</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>number</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Wat zijn de totale geschatte bouwkosten in euro’s (exclusief BTW)?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Geef alleen de totale kosten op voor die onderdelen die vergunningplichtig zijn\. Geef de \(ruwbouw\) bouwkosten op\. Bijvoorbeeld de kosten voor het stucwerk van muren, aanleggen van een parketvloer of het plaatsen van een keukenblok met inbouwapparatuur neemt u hierin niet mee\. De bouwkosten geeft u zonder BTW op\.

##### Meerdere bouwwerkzaamheden in één vergunningaanvraag]]></content:toelichting>
          <content:langeToelichting><![CDATA[Vraagt u een vergunning aan voor meerdere bouwwerkzaamheden? Geef dan bij de volgende vraag per werkzaamheid de geschatte bouwkosten aan\.]]></content:langeToelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_26022_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>50</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Indien er over uw bouwplan advies wordt gevraagd aan bijvoorbeeld een commissie die over welstand adviseert. Wilt u het bouwplan dan mondeling toelichten aan de adviseur?]]></uitv:vraagTekst>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_45847_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>45</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Geef hier eventueel een toelichting op de geschatte bouwkosten.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Vraagt u een vergunning aan voor meerdere bouwwerkzaamheden? Geef dan hier per werkzaamheid de geschatte bouwkosten\. Bijvoorbeeld apart de geschatte bouwkosten van het plaatsen van een dakkapel en de kosten voor het realiseren van zonnecollectoren\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_24075_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Vink alle werkzaamheden aan die u wilt aanvragen.]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Aanbouw, uitbouw of bijgebouw (bijbehorend bouwwerk) bouwen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder vallen aan\- of uitbouwen, bijgebouwen en overkappingen of het bouwen van een bouwwerk voor bewoning ten behoeve van mantelzorg\. Ook kleine bouwwerken zoals een plantenkas, een hondenhok, volière of speelhuisje vallen onder deze categorie\. Ook het vergroten van een bestaande aanbouw, uitbouw, bijgebouw of overkapping valt hieronder\. Bijvoorbeeld als u een kelder gaat aanleggen onder een al bestaande aanbouw\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>10</uitv:sequenceId>
              <uitv:optieText><![CDATA[Dakraam, lichtkoepel of lichtstraat plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de plaatsing van alle raamopeningen, dus ook 'daklichten' en 'dakserres', in een schuin of plat dak\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>11</uitv:sequenceId>
              <uitv:optieText><![CDATA[Hekwerk of andere erf- of perceelafscheiding plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Erf\- of perceelafscheidingen zijn hekwerken, tuinmuren, schuttingen van beton of hout, vlechtschermen en andere kant\-en\-klare afscheidingen\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>12</uitv:sequenceId>
              <uitv:optieText><![CDATA[Nieuw kozijn plaatsen of bestaand kozijn of gevelpaneel veranderen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder vallen alle veranderingen aan de raamindeling of het vergroten of verkleinen van openingen in de gevel van een gebouw\. Ook het plaatsen van een nieuw kozijn valt hieronder\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>13</uitv:sequenceId>
              <uitv:optieText><![CDATA[Normaal onderhoud verrichten]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder vallen alle werkzaamheden die erop gericht zijn het gebouw, of delen ervan, in stand te houden of te repareren\. Onderhoud heeft dus geen invloed op de structuur of het uiterlijk van een bouwwerk\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>14</uitv:sequenceId>
              <uitv:optieText><![CDATA[Sport- of speeltoestel plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Een sport\- of speeltoestel is bestemd voor vermaak of ontspanning\. Het toestel komt in beweging door de zwaartekracht of fysieke, menselijke kracht\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>15</uitv:sequenceId>
              <uitv:optieText><![CDATA[Stacaravan, vakantiehuis  of ander recreatief nachtverblijf plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de plaatsing van tenten, \(sta\)caravans, tentwagens, kampeerauto's, trekkershutten, recreatiebungalows en andere verblijven die worden gebruikt voor recreatief nachtverblijf\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>16</uitv:sequenceId>
              <uitv:optieText><![CDATA[Tuinmeubilair plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de plaatsing van tuinmeubilair dat een vaste plaats krijgt op het erf en dat niet \(makkelijk\) te verwijderen is, bijvoorbeeld pergola's, zonnewijzers en zitbanken\. Voor tuinmeubilair dat wel eenvoudig te verplaatsen is, zoals tuinstoelen, heeft u geen vergunning nodig\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>17</uitv:sequenceId>
              <uitv:optieText><![CDATA[Vlaggenmast plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Een vlaggenmast is een mast, paal of stok die op zichzelf staat en die uitsluitend gebruikt wordt om een vlag aan te bevestigen\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>18</uitv:sequenceId>
              <uitv:optieText><![CDATA[Zonnepaneel of zonnecollector plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Met een zonnepaneel of \-collector kunt u zelf energie opwekken\. Met een zonnepaneel wordt elektriciteit opgewekt uit daglicht\. Met een zonnecollector wordt warmte opgewekt die kan worden gebruikt voor het verwarmen van water\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>19</uitv:sequenceId>
              <uitv:optieText><![CDATA[Zonwering, rolhek, luik of rolluik bevestigen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Onder zonwering vallen alle soorten zonwering aan de buitenkant van het bouwwerk, bijvoorbeeld markiezen, screens en uitvalschermen\. \(Rol\)luiken en rolhekken zijn voorzieningen die aan een gebouw worden geplaatst om bijvoorbeeld inbraak in winkels en woningen te voorkomen\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Afscheiding tussen balkons of dakterrassen plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat hier om een privacyscherm\. Dit is een afscheiding tussen balkons of dakterrassen ten behoeve van de privacy\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>20</uitv:sequenceId>
              <uitv:optieText><![CDATA[Zwembad, bubbelbad of soortgelijke voorziening of vijver plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de aanleg van alle permanente zwembaden, bubbelbaden en vijvers die met of zonder overkapping op het terrein worden geplaatst\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>21</uitv:sequenceId>
              <uitv:optieText><![CDATA[Andere veranderingen aan bestaande bouwwerken]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder vallen alle bouwwerken of werkzaamheden ten behoeve van aanpassing van een bouwwerk die niet in deze lijst voorkomen\. Bijvoorbeeld het bouwen van een balkon, het aanleggen van een dakterras, het maken van een dakopbouw of het bouwen van een kelder onder een bestaand gebouw\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>22</uitv:sequenceId>
              <uitv:optieText><![CDATA[Andere nieuw te bouwen bouwwerken dan hierboven genoemd]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Toelichting: Hieronder vallen alle overige nieuw te bouwen gebouwen en constructies die niet in deze lijst voorkomen, zoals een woning, brug, een school, een bedrijfspand, een schuilstal op een weiland of een veldschuur op een heideveld]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Antenne plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Het gaat hier om diverse soorten antenne\-installaties\. Hieronder vind u enkele voorbeelden\.

* \(Schotel\)antennes voor de ontvangst van radio\- of TV\-signalen, sprietantennes, of bijvoorbeeld 27 MC zendinstallaties\.
* Antenne\-installaties voor de C2000 infrastructuur\. Dit zijn antennes voor de communicatie tussen hulpdiensten, zoals politie, brandweer en ambulance\.
* Antenne\-installatie voor mobiele telecommunicatie bijvoorbeeld een GSM\- of UMTS\-antenne\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[Beschoeiing, damwand of andere constructie voor het overbruggen van een terreinhoogteverschil plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Een grondkering of damwand wordt ook wel keermuur, walmuur of kademuur genoemd\. Het gaat hier om constructies die voorkomen dat grond kan gaan schuiven in verband met hoogteverschillen in het terrein\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>5</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bouwkeet, bouwbord, steiger, of andere hulpconstructie voor bouw-, sloop- of aanlegwerkzaamheden plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Gebruikt u het bouwwerk voor de bouw\-, sloop\- of aanlegwerkzaamheden? Dan heeft u hoogstwaarschijnlijk geen vergunning nodig voor het plaatsen van dit bouwwerk\.  
Hieronder valt de plaatsing van \(tijdelijke\) bouwwerken die worden gebruikt tijdens en ten behoeve van de bouw of sloop van een bouwwerk, bijvoorbeeld een bouwbord, steiger, heistelling, hijskraan of damwand\. Ook bouwwerken voor het uitvoeren van werkzaamheden in grond\-, wegen\- en waterbouw en bouwwerken voor werkzaamheden met een verplaatsbaar mijnbouwwerk, waarop het Besluit activiteiten leefomgeving van toepassing, is vallen hieronder\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>6</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bouwwerk ten behoeve van het verkeer, de infrastructuur of openbare voorziening plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de plaatsing van zowel gebouwen als bouwwerken, bijvoorbeeld verkeersborden en –lichten, wegbewijzering, elektriciteitskastjes, meetstations, nutsgebouwen en buis\- en leidingstelsels\. Ook het plaatsen van containers voor het inzamelen van huishoudelijk afval valt hieronder\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>7</uitv:sequenceId>
              <uitv:optieText><![CDATA[Bouwwerk voor agrarische bedrijfsvoering plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Hieronder valt de bouw van voeder\-, mest\- en sleufsilo's, kuilvoer\- en mestplaten en tanks voor opslag van bijvoorbeeld brandstof, spoelwater of melk\. Het gaat hier om bouwwerken die geen gebouw zijn\. Een gebouw is een overdekte ruimte die voor mensen toegankelijk is en die twee of meer wanden heeft\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>8</uitv:sequenceId>
              <uitv:optieText><![CDATA[Buisleiding aanleggen]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>9</uitv:sequenceId>
              <uitv:optieText><![CDATA[Dakkapel plaatsen]]></uitv:optieText>
              <content:uitvoeringsregelToelichting>
                <content:toelichting><![CDATA[Een dakkapel is een op een schuin dak te bouwen uitbouw\. Een dakkapel heeft twee verticale zijkanten, een verticale voorkant en een eigen dak\.]]></content:toelichting>
              </content:uitvoeringsregelToelichting>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Vink hier alleen werkzaamheden aan waarvoor u ook daadwerkelijk een vergunning nodig heeft\. Weet u niet voor welke werkzaamheden een vergunning nodig is? Doe dan eerst de vergunningcheck\.]]></content:toelichting>
          <content:belangrijk>true</content:belangrijk>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_24138_BizRule">
        <uitv:regelgroepRef href="#_3330_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>30</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>boolean</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Verandert het aantal woningen of wooneenheden door de werkzaamheden?]]></uitv:vraagTekst>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Een wooneenheid is een gedeelte van de woning dat bestemd is voor afzonderlijke bewoning\. Een eigenaar of verhuurder van een woning kan de kamers afzonderlijk laten bewonen\. Wooneenheden kunnen uit één of meer kamers bestaan\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_24141_BizRule">
        <uitv:regelgroepRef href="#_3359_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>10</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>string</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[U heeft aangegeven dat het aantal woningen of wooneenheden verandert door de werkzaamheden. Beschrijf hier wat u gaat doen.]]></uitv:vraagTekst>
          <inter:inputType>textarea</inter:inputType>
        </uitv:vraag>
        <content:uitvoeringsregelToelichting>
          <content:toelichting><![CDATA[Hieronder staan enkele voorbeelden van beschrijvingen die u hier kunt geven\.

* Gaat u één of meerdere nieuwe woning\(en\) realiseren? Geef dan hier aan hoeveel\.
* Gaat u een bedrijfswoning gebruiken als burgerwoning? Geef dit dan hier aan\.
* Gaat u bestaande woningen samenvoegen? Of gaat u een bestaande woning of bestaand pand opsplitsen in meerdere \(kleinere\) woningen of zelfstandige wooneenheden? Beschrijf hier dan hoeveel woningen er zijn voor en na het samenvoegen of splitsen\.]]></content:toelichting>
        </content:uitvoeringsregelToelichting>
      </uitv:uitvoeringsregel>

            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>10</uitv:sequenceId>
              <uitv:optieText><![CDATA[Oktober]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>11</uitv:sequenceId>
              <uitv:optieText><![CDATA[November]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>12</uitv:sequenceId>
              <uitv:optieText><![CDATA[December]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>2</uitv:sequenceId>
              <uitv:optieText><![CDATA[Februari]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>3</uitv:sequenceId>
              <uitv:optieText><![CDATA[Maart]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>4</uitv:sequenceId>
              <uitv:optieText><![CDATA[April]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>5</uitv:sequenceId>
              <uitv:optieText><![CDATA[Mei]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>6</uitv:sequenceId>
              <uitv:optieText><![CDATA[Juni]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>7</uitv:sequenceId>
              <uitv:optieText><![CDATA[Juli]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>8</uitv:sequenceId>
              <uitv:optieText><![CDATA[Augustus]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>9</uitv:sequenceId>
              <uitv:optieText><![CDATA[September]]></uitv:optieText>
            </uitv:optie>
          </uitv:opties>
        </uitv:vraag>
      </uitv:uitvoeringsregel>
      <uitv:uitvoeringsregel id="_26294_BizRule">
        <uitv:regelgroepRef href="#_3320_RuleGroup" />
        <uitv:bereik>werkzaamheid</uitv:bereik>
        <inter:classificatie>activiteit</inter:classificatie>
        <uitv:publiceerbaar>true</uitv:publiceerbaar>
        <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
        <inter:prioriteit>20</inter:prioriteit>
        <uitv:vraag>
          <uitv:gegevensType>list</uitv:gegevensType>
          <uitv:vraagTekst><![CDATA[Seizoensgebonden bouwwerk: Het bouwwerk is aanwezig van]]></uitv:vraagTekst>
          <uitv:opties>
            <uitv:optieType>enkelAntwoord</uitv:optieType>
            <uitv:optie>
              <uitv:sequenceId>1</uitv:sequenceId>
              <uitv:optieText><![CDATA[Januari]]></uitv:optieText>
            </uitv:optie>
            <uitv:optie>
              <uitv:sequenceId>10</uitv:sequenceId>
              <uitv:optieText><![CDATA[Oktober]]></uitv:optieText>
            </uitv:optie>

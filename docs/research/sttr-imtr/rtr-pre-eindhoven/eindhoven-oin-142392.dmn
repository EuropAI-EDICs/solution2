                 exporter="Geodan FLO Legal STTR Builder" exporterVersion="" id="_b3c2f1ff-d5a3-47c8-af95-1d085675e23f"
                 name="Bouwwerk slopen in een gemeentelijk beschermd of rijksbeschermd stads of dorpsgezicht">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="groep1">
    <inter:naam>Bouwwerk slopen in een gemeentelijk beschermd of rijksbeschermd stads of dorpsgezicht Gemeente Tilburg</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__eeff0bff-3bee-4a8e-a641-3c52cf406c6c">
        <uitv:regelgroepRef href="#groep1"/>
            <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Ligt het bouwwerk, of een onderdeel daarvan, dat u wilt slopen in een beschermd stads- of dorpsgezicht?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[U kunt nagaan of het te slopen bouwwerk is gelegen in een beschermd stads- of dorpsgezicht via de volgende [link](https://geo.tilburg.nl/portal/apps/webappviewer/index.html?id=47b7f0ee33e5448c8584d8e4762e2cdc).]]></content:toelichting>
    
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__3da6ac77-c437-4e42-b6f6-e055e79e5a72">
        <uitv:regelgroepRef href="#groep1"/>
            <inter:prioriteit>20</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Ontstaan er door de sloopwerkzaamheden open gaten in de bebouwing of de beschermde historische structuur?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Open gaten ontstaan indien er sprake is van volledige sloop van panden of delen daarvan. Hiermee wordt niet het slopen of verwijderen van bijvoorbeeld een kozijn of dakkapel bedoeld.]]></content:toelichting>
    
    
    <content:belangrijk>true</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        
    </dmn:extensionElements>
    

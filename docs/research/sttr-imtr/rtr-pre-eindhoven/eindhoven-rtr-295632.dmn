    <dmn:extensionElements>
        <bedr:sttr versie="2"/>
        <inter:regelgroepen>
            <inter:regelgroep id="_e7715e9b-6284-406b-94af-dcfc04f26c27">
                <inter:naam>Kabels en leidingen</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__e9b49c25-ee81-4198-b028-6ce00477f7f2">
                <uitv:regelgroepRef href="#_e7715e9b-6284-406b-94af-dcfc04f26c27"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er sprake van een calamiteit?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, er is sprake van een calamiteit.]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[dit is ...]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, er is geen sprake van een calamiteit.]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Calamiteit of spoed werkzaamheden zijn werkzaamheden voor reparatie of onderhoud in verband met een storing of een belemmering, waarvan uitstel, gelet op de aard en/of omvang van de storing of belemmering, redelijkerwijs niet mogelijk is.

Let op: in sommige gevallen kan het zo zijn dat u naast de melding van calamiteitenwerkzaamheden alsnog een vergunning (achteraf) moet aanvragen. Of dit voor u van toepassing is, ziet u bij het invullen van het informatieformulier.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__6282d4d1-ad7e-47d3-9db0-f56213a5edf4">
                <uitv:regelgroepRef href="#_e7715e9b-6284-406b-94af-dcfc04f26c27"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er sprake van een gestuurde boring of boogzinker?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Ja, er is sprake van een gestuurde boring of een boogzinker.]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Nee, er is geen sprake van een gestuurde boring of boogzinker.]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Een gestuurde boring is het met behulp van een sleuf loze techniek maken van een holle ruimte in de grond zonder daarbij de omringende grondslag te verwijderen.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__f4d78044-175c-447f-9a60-576c4e16ae73">
                <uitv:regelgroepRef href="#_e7715e9b-6284-406b-94af-dcfc04f26c27"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wordt de kabel/worden de kabels aangebracht of verwijderd in reeds aangebrachte voorzieningen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[ja, de werkzaamheden vinden plaats aan een reeds aangebrachte vorziening]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[nee, de werkzaamheden vinden niet plaats aan een reeds aangebrachte voorziening]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>

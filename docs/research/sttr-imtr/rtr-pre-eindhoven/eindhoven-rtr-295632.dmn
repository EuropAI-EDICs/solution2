                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om een werkzaamheid die meer dan 25 strekkende meter omvat?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>

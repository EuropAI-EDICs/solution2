<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Handelsreclame maken of voeren" id="_5fd68e6d_8342_4477_9b01_786b0762f654" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_37c74781-0549-4e81-9cff-3e5694ff0b52">
                <inter:naam>reclame</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="implicietAntwoordGroup">
                <inter:naam>Impliciet antwoord</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__3b6441a8-3d2e-4148-8325-d3a4e91c0f15">
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:implicietAntwoord>
                    <uitv:werkzaamheid urn="ReclamebordenPlaatsen"/>
                    <uitv:waarde>true</uitv:waarde>
                    <uitv:context>werkzaamheidSpecifiek</uitv:context>
                </uitv:implicietAntwoord>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__937f3041-e89e-4533-b9da-ae375dc74d84">
                <uitv:regelgroepRef href="#_37c74781-0549-4e81-9cff-3e5694ff0b52"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wordt de reclame geplaatst aan of bij een monument?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De monumentenkaart is raadpleegbaar via onze website, zie hiervoor [Monumenten | Gemeente Eindhoven](https://www.eindhoven.nl/stad-en-wonen/stad/erfgoed/monumenten?search=monumentenkaart).

Als u deze vraag met **ja** beantwoordt moet u **ook** de check uitvoeren:

**Werkzaamheden in, aan of op een monument of archeologisch monument uitvoeren, of dit anders gebruiken.**

Doe een stap terug en selecteer deze!]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__2eddcb73-ae77-468e-8097-cc839664475b">
                <uitv:regelgroepRef href="#_37c74781-0549-4e81-9cff-3e5694ff0b52"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Betreft de reclame het beletteren d.m.v. stickers of verven?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let op: hier zijn wel de redelijke eisen van welstand van toepassing. Twijfelt u, neemt u dan contact op met de commissie ruimtelijke kwaliteit.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__72972d3d-3638-4014-96ae-456c8e65f970">
                <uitv:regelgroepRef href="#_37c74781-0549-4e81-9cff-3e5694ff0b52"/>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Betreft de reclame een object dat kleiner is dan 0,5 m2 én is dit het enige object per gevel op dit pand?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Bij een object moet u denken aan borden, doeken, lichtbakken en dergelijke.

Als u deze vraag met **nee** beantwoordt moet u **ook** de check uitvoeren:

**Constructie bouwen of vervangen**

Doe een stap terug en selecteer deze!]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Werk niet zijnde bouwwerk of werkzaamheid uitvoeren" id="_384db317_ebf4_4ac6_9e27_bdee2d1953c8" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_874cda23-cb1d-47ca-881b-e14b7a68b054">
                <inter:naam>Archeologie</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__56c99b8a-e5ac-41b1-9afd-4f685a701246">
                <uitv:regelgroepRef href="#_874cda23-cb1d-47ca-881b-e14b7a68b054"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u graven in de grond?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Deze vraag stellen wij, omdat er misschien spullen in de grond liggen die historische waarde hebben. U kunt met historische spullen in aanraking komen als u in de grond gaat graven, omdat u bijvoorbeeld:

*   grond gaat ophogen of afgraven (minder dan 25 m3);
    
*   bomen gaat planten;
    
*   wegen of paden gaat aanleggen;
    
*   sloten gaat graven of dempen;
    
*   grond gaat draineren; of
    
*   voorwerpen voor langere tijd in de grond gaat brengen (indrijven)
    

De regels die komen kijken bij het graven als er historische spullen in de grond liggen zijn ingewikkeld en verschillend per locatie. Als u zelf wilt kijken of deze regels voor uw locatie gelden, kijkt u dan bij regels op de kaart. Als u graag hulp wilt om te weten welke regels er gelden en of u misschien een vergunning nodig hebt, neemt u dan contact met ons op.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>
        <sttrbuilder:dependencyInformation>
            <sttrbuilder:dependencyInformationVersion>1.0.3</sttrbuilder:dependencyInformationVersion>
            <sttrbuilder:checkDependencyInformation>
                <sttrbuilder:rows>
                    <sttrbuilder:row id="ffeb17ce-8f38-4347-80d3-3b5495f8d787" questionId="uitv__56c99b8a-e5ac-41b1-9afd-4f685a701246" groupId="_874cda23-cb1d-47ca-881b-e14b7a68b054"/>
                </sttrbuilder:rows>
                <sttrbuilder:questionPaths>
                    <sttrbuilder:questionPath>
                        <sttrbuilder:outcome><![CDATA[Neem contact op met]]></sttrbuilder:outcome>
                        <sttrbuilder:outcomeId><![CDATA[NeemContactOpMet]]></sttrbuilder:outcomeId>
                        <sttrbuilder:answers>
                            <sttrbuilder:answer rowId="ffeb17ce-8f38-4347-80d3-3b5495f8d787">
<sttrbuilder:answer><![CDATA[ja]]></sttrbuilder:answer>
<sttrbuilder:multipleValues/>
                            </sttrbuilder:answer>
                        </sttrbuilder:answers>
                    </sttrbuilder:questionPath>
                </sttrbuilder:questionPaths>
                <sttrbuilder:outcomeInformation>
                    <sttrbuilder:outcomeInformationContent outcomeId="NeemContactOpMet">
                        <sttrbuilder:content><![CDATA[Het is moeilijk om te zeggen of u met het graven rekening moet houden met spullen in de grond die archeologische waarden hebben. Neemt u contact met ons op en dan helpen wij u om te bepalen of dat zo is en waar u dan rekening mee moet houden.

Als u zelf al wilt kijken, kunt u de regels die van toepassing zijn ook vinden in het DSO onder ‘Regels op de kaart’.]]></sttrbuilder:content>
                    </sttrbuilder:outcomeInformationContent>
                    <sttrbuilder:outcomeInformationContent outcomeId="Toestemmingsvrij">
                        <sttrbuilder:content><![CDATA[Het is moeilijk om te zeggen of u met het graven rekening moet houden met spullen in de grond die archeologische waarden hebben. Neemt u contact met ons op en dan helpen wij u om te bepalen of dat zo is en waar u dan rekening mee moet houden.

Als u zelf al wilt kijken, kunt u de regels die van toepassing zijn ook vinden in het DSO onder ‘Regels op de kaart’.]]></sttrbuilder:content>
                    </sttrbuilder:outcomeInformationContent>
                </sttrbuilder:outcomeInformation>
                <sttrbuilder:maatregelenPossibleOutcomes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
            </sttrbuilder:checkDependencyInformation>
        </sttrbuilder:dependencyInformation>
    </dmn:extensionElements>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Grondwater afkomstig van een sanering of ontwatering lozen in het riool of op of in de bodem" id="_018d115f_148a_40e8_93b1_aa391e1dbcda" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_4684_RuleGroup">
                <inter:naam>Grondwater lozen in het riool of op of in de bodem</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="implicietAntwoordGroup">
                <inter:naam>Impliciet antwoord</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__4cc63c13-3391-47e5-8c6a-0d37f1dee224">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:implicietAntwoord>
                    <uitv:werkzaamheid urn="BodemsaneringUitvoeren"/>
                    <uitv:waarde>true</uitv:waarde>
                    <uitv:context>werkzaamheidSpecifiek</uitv:context>
                </uitv:implicietAntwoord>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__ac654a9f-bf99-4f01-8e5c-395e50835fe2">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:implicietAntwoord>
                    <uitv:werkzaamheid urn="WaterUitDeGrondHalen"/>
                    <uitv:waarde>true</uitv:waarde>
                    <uitv:context>werkzaamheidSpecifiek</uitv:context>
                </uitv:implicietAntwoord>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__d858fddf-c638-44e8-8c4d-55cc4fba3b87">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:implicietAntwoord>
                    <uitv:werkzaamheid urn="GrondDraineren"/>
                    <uitv:waarde>true</uitv:waarde>
                    <uitv:context>werkzaamheidSpecifiek</uitv:context>
                </uitv:implicietAntwoord>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__4b08dc3c-2bf5-426e-b19f-f10eb8207988">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u binnen de beheersgrens grondwater lozen?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[ja, de locatie ligt binnen de beheersgrens]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[De locatie ligt binnen de beheersgrens, laat dit naast de melding ook weten aan ons door een mail te sturen naar [ggb-centrum@eindhoven.nl](mailto:ggb-centrum@eindhoven.nl)]]></content:toelichting>
<content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[nee, de locatie ligt niet binnen de beheersgrens]]></uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[weet ik niet]]></uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[De beheersgrens ziet u hieronder op de kaart afgebeeld binnen de rode stippellijnen.

![](https://sttr-files-preprod.apps.geodan.nl/00000001001902763000/beheersgrens.jpg)]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__9fd3423a-d86e-43eb-8152-40181e03f407">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u met uw werkzaamheid ook grondwater lozen (in het riool of op of in de bodem)?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Let u er bij het lozen van het grondwater wel op dat u onder de maximaal toegestane eisen en emissiegrenswaarden blijft, zoals deze in artikel 10.201 en art. 10.202 van het omgevingsplan zijn genoemd. Zie hiervoor regels op de kaart op het [DSO](https://omgevingswet.overheid.nl/regels-op-de-kaart?session=81c5a983-1d82-466e-9522-1f4418be6028).]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c6839192-5aeb-4f2c-ae04-b99c5819630c">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Waar komt het grondwater dat u wilt gaan lozen vandaan?]]></uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>enkelAntwoord</uitv:optieType>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Bodem - / Grondwatersanering]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Vanwege doelmatig beheer hanteren wij als gemeente een voorkeursvolgorde bij de mogelijkheden waar u grondwater afkomstig uit sanering kunt lozen, te weten:

1.  op of in de bodem;
2.  in het oppervlaktewater;
3.  in een schoonwaterriool;
4.  in een vuilwaterriool.

Kijkt u voor de waarden die toegestaan zijn bij het lozen van grondwater afkomstig uit saneringen in ons omgevingsplan in artikel 10.202 en tabel 10.202 (te vinden in regels op de kaart).]]></content:toelichting>
<content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText><![CDATA[Onderzoek voorafgaand aan een grondwatersanering]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Vanwege doelmatig beheer hanteren wij als gemeente een voorkeursvolgorde bij de mogelijkheden waar u grondwater afkomstig uit een onderzoek voorafgaand aan een grondwatersanering kunt lozen, te weten:

1.  op of in de bodem;
2.  in het oppervlaktewater;
3.  in een schoonwaterriool;
4.  in een vuilwaterriool.

Kijkt u voor de waarden die toegestaan zijn bij het lozen van grondwater afkomstig uit een onderzoek voorafgaand aan een grondwatersanering in ons omgevingsplan in artikel 10.202 en tabel 10.202.]]></content:toelichting>
<content:belangrijk>false</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText><![CDATA[grondwater ergens anders vandaan]]></uitv:optieText>
                            <content:uitvoeringsregelToelichting>
<content:toelichting><![CDATA[Bijvoorbeeld grondwater afkomstig van ontwatering, uit een bouwput, een sleuf (bijvoorbeeld voor rioolaanleg) of grondwater dat vrij komt bij een activiteit aan kabels of leidingen in de bodem.

Vanwege doelmatig beheer hanteren wij als gemeente een voorkeursvolgorde bij de mogelijkheden waar u dit grondwater kunt lozen, te weten:

1.  Op of in de bodem; Hierbij is de emissiegrenswaarde voor onopgeloste stoffen 50 mg/l en voor ijzer 5 mg/l, en moet de pH-waarde (zuurgraad) tussen de 6,5 en 9,0 bedragen, gemeten in een steekmonster.
    
2.  In het oppervlaktewater; hierbij gelden dezelfde waarden als hiervoor vermeld onder 1. “op of in de bodem”.
    
3.  In een hemelwaterriool; hierbij gelden dezelfde waarden als vermeld onder 1. “op of in de bodem”.
    
4.  In een vuilwaterriool. Hierbij is de emissiegrenswaarde voor onopgeloste stoffen 300 mg/l.
    

Het lozen van dat grondwater in een vuilwaterriool duurt niet langer dan 8 weken en de geloosde hoeveelheid is ten hoogste 5 m3 /u.]]></content:toelichting>
<content:belangrijk>true</content:belangrijk>
                            </content:uitvoeringsregelToelichting>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__b6abfddf-a984-4232-a2e8-954f35226f06">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Kan het water dat u gaat lozen tijdens het lozen direct in contact komen met grondwater?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__82ca04c8-f882-4f89-83bb-48bddb177777">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u meer dan 25m3 grond verzetten?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__752db0e6-b151-409f-b439-4b213d3c47db">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u langer dan 48 uur grondwater lozen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__4f61f581-5c66-4b4f-b7b3-c11ba761e6d0">
                <uitv:regelgroepRef href="#_4684_RuleGroup"/>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Verwacht u binnen 8 weken klaar te zijn met het lozen van het grondwater?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Is uw antwoord hier “ja”, dan geldt niet de gebruikelijke termijn van 4 weken, maar een afwijkende termijn van ten minste 5 dagen voor de start (of wijziging) van uw activiteit om ons te informeren over deze activiteit.]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

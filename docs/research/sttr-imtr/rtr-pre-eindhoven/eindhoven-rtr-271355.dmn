<dmn:definitions xmlns:sttrbuilder="http://sttr-builder.apps.geodan.nl/v1.0" xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:bedr="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Bedrijfsregel" xmlns:uitv="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Uitvoeringsregel" xmlns:content="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Content" xmlns:inter="http://toepasbare-regels.omgevingswet.overheid.nl/v1.0/Interactieregel" namespace="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000" exporter="Sogelink Netherlands STTR Builder" name="Gewoon onderhoud verrichten aan een bouwwerk" id="_8efbe58a_d170_4c49_957d_5f10added496" xmlns="http://toepasbare-regels.omgevingswet.overheid.nl/00000001001902763000">
    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_3b940bbd_7aa9_44c9_861f_d6d5760f979e">
                <inter:naam>Regulier onderhoud</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_31bbf28b_a707_4ebc_9e87_d726ed6cc044">
                <inter:naam>Monument/archeologisch monument en stads- of dorpsgezicht</inter:naam>
                <inter:prioriteit>2</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_0766a6b6_803b_4831_8acd_c7ffb502fdf6">
                <inter:naam>Monumenten</inter:naam>
                <inter:prioriteit>3</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_de1b631e_eb61_405f_9ad0_45a1129c7df5">
                <inter:naam>Bouwwerkzaamheden naast een monument</inter:naam>
                <inter:prioriteit>4</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="_8ffa1a7d_8ffc_4d21_bcb2_8d12b2ddf468">
                <inter:naam>Beschermd stads- of dorpsgezicht</inter:naam>
                <inter:prioriteit>5</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="vasteWaardeGroup">
                <inter:naam>Vaste waarde</inter:naam>
                <inter:prioriteit>6</inter:prioriteit>
            </inter:regelgroep>
            <inter:regelgroep id="vasteWaardeVoorbehoudGroup">
                <inter:naam>Vaste waarde onder voorbehoud</inter:naam>
                <inter:prioriteit>7</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__b0219ec6_23c3_457d_a51a_55b579d9e96d">
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vasteWaarde>
                    <uitv:waardeVraag><![CDATA[Vaste waarde, altijd 'true' ]]></uitv:waardeVraag>
                    <uitv:waarde><![CDATA[true]]></uitv:waarde>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                </uitv:vasteWaarde>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c24efb3e_2aea_4ae6_b13d_f982637cfb73">
                <uitv:regelgroepRef href="#_3b940bbd_7aa9_44c9_861f_d6d5760f979e"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u tijdens het onderhoud het uiterlijk van het bouwwerk wijzigen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Gaat u hier ‘Ja’ antwoorden? Dan gaat u meer doen dan alleen maar regulier onderhoud\. Ga terug naar stap 2: Kies werkzaamheden\. Zoek daar naar bijvoorbeeld ‘veranderen’, ‘verbouwen’, ‘renoveren’ of restaureren’ en beantwoordt de vragen\.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[Dit is bijvoorbeeld het geval indien u een kozijn vervangt door een raam met een andere indeling\. Dan verandert het uiterlijk van het bouwwerk\. Het maakt in dit geval niet uit welk materiaal u gebruikt\.   
    
 Gaat u alleen schilderwerkzaamheden uitvoeren? Dan wijzigt het uiterlijk van het bouwwerk daardoor niet\.]]></content:langeToelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__670c9dfb_6dc3_46e6_b9cb_051ca6540a9c">
                <uitv:regelgroepRef href="#_31bbf28b_a707_4ebc_9e87_d726ed6cc044"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Is er op het perceel een beschermd of voorbeschermd monument of archeologisch monument aanwezig?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Iets is een beschermd monument of archeologisch monument als de gemeente, de provincie of het Rijk het heeft aangewezen als gemeentelijk monument, provinciaal monument of rijksmonument\.   
 Vul hier ook ‘ja’ in als er een procedure tot aanwijzing als gemeentelijk, provinciaal of rijksmonument loopt\. Dan is er sprake van een zogenoemd ‘voorbeschermd’ gemeentelijk monument, provinciaal monument of rijksmonument\.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[Of iets een gemeentelijk monument of provinciaal monument is, kunt u navragen bij de gemeente\.   
    
 Of iets een rijksmonument is, kunt u opzoeken in het rijksmonumentenregister \([https://monumentenregister\.cultureelerfgoed\.nl](https://monumentenregister.cultureelerfgoed.nl)\)\. In de omschrijving van het rijksmonument staat om welke onroerende zaak/onroerende zaken of welk terrein het gaat\. U kunt ook contact opnemen met de Rijksdienst voor het Cultureel Erfgoed \([https://cultureelerfgoed\.nl/contact/contactformulier](https://cultureelerfgoed.nl/contact/contactformulier)\)\.]]></content:langeToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__db9aaaee_0fbd_4fa2_bcaf_7ec43a4401d0">
                <uitv:regelgroepRef href="#_31bbf28b_a707_4ebc_9e87_d726ed6cc044"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>40</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Vinden de voorgenomen bouwwerkzaamheden plaats in een rijksbeschermd stads- of dorpsgezicht?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[##### Rijksbeschermd stads- of dorpsgezich**t**

Het gaat hier om bouwwerkzaamheden binnen een door het Rijk aangewezen beschermd stads- of dorpsgezicht\. Neem bij twijfel of voor meer informatie contact op met uw gemeente\.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__13047a1f_f77b_443e_9b8f_23c091aecf1b">
                <uitv:regelgroepRef href="#_0766a6b6_803b_4831_8acd_c7ffb502fdf6"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>50</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om bouwwerkzaamheden in, aan of op het beschermde of voorbeschermde monument of archeologisch monument?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Is dit het geval, dan is daarvoor waarschijnlijk \(ook\) een aparte omgevingsvergunning nodig\. Vul hierna, afhankelijk van de status \(gemeentelijk monument, provinciaal monument of rijksmonument\), ook de vergunningcheck in voor de desbetreffende monumentenactiviteit\.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__27d43846_3f9c_4971_a178_2f59d87f8716">
                <uitv:regelgroepRef href="#_de1b631e_eb61_405f_9ad0_45a1129c7df5"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>60</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om bouwwerkzaamheden bij (naast of vlakbij) een (voor)beschermd monument of archeologisch monument?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Iets is een beschermd monument of archeologisch monument als de gemeente, de provincie of het Rijk het heeft aangewezen als gemeentelijk monument, provinciaal monument of rijksmonument\.   
    
 Vul hier ook ‘ja’ in als er een procedure tot aanwijzing als gemeentelijk, provinciaal of rijksmonument loopt\. Dan is er sprake van een zogenoemd ‘voorbeschermd’ gemeentelijk monument, provinciaal monument of rijksmonument\.]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__40c76295-9cf2-4ff7-965c-ebc9e9571c9e">
                <uitv:regelgroepRef href="#_de1b631e_eb61_405f_9ad0_45a1129c7df5"/>
                <inter:prioriteit>70</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het ook om bouwwerkzaamheden bij (naast of vlakbij) een (voor)beschermd monument of archeologisch monument?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Verschillende onderdelen kunnen de status monumentaal hebben. Het kan dus zijn dat uw woning de monumentale status heeft, maar ook het bijgebouw of de tuin. Wanneer u werkzaamheden aan een van deze onderdelen met monumentale status gaat uitvoeren, kan het zijn dat u voor de werkzaamheden aan het onderdeel zelf geen vergunning nodig hebt, maar wel voor het feit dat u werkzaamheden uitvoert naast een ander monumentaal onderdeel.

Kijkt u voor meer informatie ook op onze [site](https://www.eindhoven.nl/bouwen/vergunningen/onderhouden-en-wijzigen-van-een-monument).]]></content:toelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c0980fad_99ab_40b9_8cb8_17ae30a82ad4">
                <uitv:regelgroepRef href="#_de1b631e_eb61_405f_9ad0_45a1129c7df5"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>80</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u de kleur of materiaalsoort van het bouwwerk wijzigen?]]></uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__c78d82c6_fd4f_4e61_8ed2_c4d89f5e97d0">
                <uitv:regelgroepRef href="#_8ffa1a7d_8ffc_4d21_bcb2_8d12b2ddf468"/>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>90</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat u de kleur of materiaalsoort van het bouwwerk wijzigen?]]></uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__4fa2d8ce_d022_4d0b_90a2_e4828a9e190c">
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <inter:prioriteit>100</inter:prioriteit>
                <uitv:vasteWaardeVoorbehoud>
                    <uitv:vasteWaarde>
                        <uitv:waardeVraag><![CDATA[Voorbehoud GewonOndehoud]]></uitv:waardeVraag>
                        <uitv:waarde><![CDATA[true]]></uitv:waarde>
                        <uitv:gegevensType>boolean</uitv:gegevensType>
                    </uitv:vasteWaarde>
                    <uitv:tekstVoorbehoud><![CDATA[Het bouwwerk mag niet ernstig ontsierend zijn, als dit in het omgevingsplan is bepaald. Kijk voor de regels over ernstige ontsiering van het uiterlijk van bouwwerken in het omgevingsplan. Deze regels worden ook wel het repressief welstandsvereiste genoemd. Neem bij twijfel contact op met de gemeente.]]></uitv:tekstVoorbehoud>
                </uitv:vasteWaardeVoorbehoud>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

                 exporter="Geodan FLO Legal STTR Builder" exporterVersion="" id="_f59d6351-72b2-4acd-b635-2747a7988a31"
                 name="Indieningsvereisten Vergunning Uitweg maken hebben of veranderen of het gebruik daarvan veranderen">
    <dmn:extensionElements>
        <inter:regelgroepen>
                            <inter:regelgroep id="_1bce68e4-3c56-4a1c-a9aa-c02ef5594c42">
    <inter:naam>Werkzaamheden in- of uitrit</inter:naam>
    <inter:prioriteit>10</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_fbe2f82b-ed11-4383-bb21-99dac8b2e083">
    <inter:naam>Aanwezigheid obstakels in- of uitrit</inter:naam>
    <inter:prioriteit>20</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_4e72c2cc-6b59-43ef-930b-7c0f96f1f657">
    <inter:naam>Diverse vragen</inter:naam>
    <inter:prioriteit>30</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_0f806977-323e-4ed0-aaae-78aa7e51fe59">
    <inter:naam>Algemene bijlagen</inter:naam>
    <inter:prioriteit>40</inter:prioriteit>
</inter:regelgroep>
                            <inter:regelgroep id="_d4577135-d47d-4526-9d45-bde6c4fbf2e6">
    <inter:naam>Diverse vragen 2</inter:naam>
    <inter:prioriteit>50</inter:prioriteit>
</inter:regelgroep>
                    </inter:regelgroepen>
        <uitv:uitvoeringsregels>
                            <uitv:uitvoeringsregel id="uitv__3dbe3959-430e-44f4-95cc-b61c0f4829fa">
        <uitv:regelgroepRef href="#_1bce68e4-3c56-4a1c-a9aa-c02ef5594c42"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>10</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>list</uitv:gegevensType>
    <uitv:vraagTekst>Kies de werkzaamheden die u gaat uitvoeren</uitv:vraagTekst>
                <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                            <uitv:optie>
                    <uitv:sequenceId>0</uitv:sequenceId>
                    <uitv:optieText>Een nieuwe in- of uitrit aanleggen</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>1</uitv:sequenceId>
                    <uitv:optieText>Een bestaande in- of uitrit veranderen</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>2</uitv:sequenceId>
                    <uitv:optieText>Anders</uitv:optieText>
                                    </uitv:optie>
                    </uitv:opties>
    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__41f173ed-3a5c-4302-8b6a-ab9f8c80cb8d">
        <uitv:regelgroepRef href="#_1bce68e4-3c56-4a1c-a9aa-c02ef5594c42"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>20</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>U heeft aangegeven dat u andere werkzaamheden gaat uitvoeren dan een nieuwe in- of uitrit aanleggen of een bestaande in- of uitrit veranderen. Omschrijf wat u wilt gaan doen.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__4198a9a9-6482-416b-95da-6e50da6913c1">
        <uitv:regelgroepRef href="#_fbe2f82b-ed11-4383-bb21-99dac8b2e083"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>30</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>boolean</uitv:gegevensType>
    <uitv:vraagTekst>Zijn er obstakels aanwezig die het aanleggen of het gebruiken van de in- of uitrit in de weg staan?</uitv:vraagTekst>
        </uitv:vraag>


                          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Obstakels zijn bijvoorbeeld bomen, lantaarnpalen en nutsvoorzieningen \(zoals transformatorhuisjes, flitspalen of buspoortjes\)\.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__00949557-0f62-405f-b401-85f068c9ac3a">
        <uitv:regelgroepRef href="#_fbe2f82b-ed11-4383-bb21-99dac8b2e083"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>40</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>list</uitv:gegevensType>
    <uitv:vraagTekst>Welke obstakel(s) zijn aanwezig?</uitv:vraagTekst>
                <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                            <uitv:optie>
                    <uitv:sequenceId>0</uitv:sequenceId>
                    <uitv:optieText>Boom</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>1</uitv:sequenceId>
                    <uitv:optieText>Lantaarnpaal</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>2</uitv:sequenceId>
                    <uitv:optieText>Nutsvoorziening</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>3</uitv:sequenceId>
                    <uitv:optieText>Anders</uitv:optieText>
                                    </uitv:optie>
                    </uitv:opties>
    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__180b25aa-4d78-4269-b8fa-073b4e256914">
        <uitv:regelgroepRef href="#_fbe2f82b-ed11-4383-bb21-99dac8b2e083"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>50</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Beschrijf het obstakel dat voor het aanleggen of gebruiken van de in- of uitrit in de weg staat.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__bdd4c8fc-e257-4c1a-b583-128362cc414b">
        <uitv:regelgroepRef href="#_4e72c2cc-6b59-43ef-930b-7c0f96f1f657"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>60</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Wat zijn de afmetingen van de nieuwe in- of uitrit?</uitv:vraagTekst>
    <inter:inputType>text</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__f59e1a51-58c1-438d-8785-900de286166c">
        <uitv:regelgroepRef href="#_4e72c2cc-6b59-43ef-930b-7c0f96f1f657"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>70</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>list</uitv:gegevensType>
    <uitv:vraagTekst>Aan welk erf ligt de in- of uitrit?</uitv:vraagTekst>
                <uitv:opties>
            <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                            <uitv:optie>
                    <uitv:sequenceId>0</uitv:sequenceId>
                    <uitv:optieText>Voorerf</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>1</uitv:sequenceId>
                    <uitv:optieText>Zijerf</uitv:optieText>
                                    </uitv:optie>
                            <uitv:optie>
                    <uitv:sequenceId>2</uitv:sequenceId>
                    <uitv:optieText>Achtererf</uitv:optieText>
                                    </uitv:optie>
                    </uitv:opties>
    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__28e68467-2761-4c71-9024-d1f360007c9b">
        <uitv:regelgroepRef href="#_4e72c2cc-6b59-43ef-930b-7c0f96f1f657"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>80</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Vul de straatnaam in waar de in- of uitrit op uitkomt.</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__b637dbc1-7184-4682-be77-7677b3747c0a">
        <uitv:regelgroepRef href="#_0f806977-323e-4ed0-aaae-78aa7e51fe59"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>90</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Situatietekening huidige situatie</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: Een situatietekening die de bestaande situatie laat zien. De nieuwe situatie kan ingetekend worden op deze tekening, of aangeleverd worden op een extra situatietekening. Ook kunt u een foto van de situatie mee sturen ter verduidelijking.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[Deze tekening geeft de bestaande situatie weer. De nieuwe situatie kan ingetekend worden op deze tekening, of aangeleverd worden op een extra situatietekening.

De situatietekening uitrit moet de volgende gegevens bevatten:

*   locatie van de uitrit aan het voor-, zij- of achtererf
*   aanwezigheid van obstakels die bij het aanleggen van de uitrit in de weg staan, zoals bomen, lantaarnpalen en nutsvoorzieningen
*   noordpijl
*   duidelijke maatvoering en schaalaanduiding (aanduiding met maatlijn)
*   datum van de eerste opstelling van de tekening
*   datum van de laatste wijziging van de tekening
*   ondergrond van voldoende kwaliteit (bijvoorbeeld grootschalige basiskaart van Nederland, kadastrale kaart)
*   grens van de locatie
*   dichtstbijzijnde openbare weg
*   dichtstbijzijnde woonbebouwing
*   functie van de aangrenzende percelen

Als u de nieuwe situatie in deze tekening intekent, moet u dezelfde informatie aanleveren voor wat betreft de nieuwe situatie.]]></content:langeToelichting>
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__0637b33f-6a62-4b54-9a5d-7f29b3f5984c">
        <uitv:regelgroepRef href="#_0f806977-323e-4ed0-aaae-78aa7e51fe59"/>
            <inter:prioriteit>100</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Situatietekening nieuwe situatie</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: Een situatietekening die de nieuwe situatie laat zien. De nieuwe situatie kan ook ingetekend worden op de tekening van de huidige situatie. Ook kunt u een foto van de situatie mee sturen ter verduidelijking.

De situatietekening uitrit moet de volgende gegevens bevatten:

*   locatie van de uitrit aan het voor-, zij- of achtererf
*   aanwezigheid van obstakels die bij het aanleggen van de uitrit in de weg staan, zoals bomen, lantaarnpalen en nutsvoorzieningen
*   noordpijl
*   duidelijke maatvoering en schaalaanduiding (aanduiding met maatlijn)
*   datum van de eerste opstelling van de tekening
*   datum van de laatste wijziging van de tekening
*   ondergrond van voldoende kwaliteit (bijvoorbeeld grootschalige basiskaart van Nederland, kadastrale kaart)
*   grens van de locatie
*   dichtstbijzijnde openbare weg
*   dichtstbijzijnde woonbebouwing
*   functie van de aangrenzende percelen]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__847e8e6c-8156-4d84-811d-0dc1f0c3b385">
        <uitv:regelgroepRef href="#_0f806977-323e-4ed0-aaae-78aa7e51fe59"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>110</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Tekening vormgeving uitrit</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Voeg als bijlage toe: een tekening van de exacte vormgeving van de nieuwe of gewijzigde uitrit.]]></content:toelichting>
    
            <content:langeToelichting><![CDATA[De ontwerptekening moet de volgende gegevens bevatten:

*   afmeting van de nieuwe uitrit
*   duidelijke maatvoering en schaalaanduiding (aanduiding met maatlijn)

Indien van toepassing moet de ontwerptekening nieuwe of gewijzigde uitrit ook de onderstaande gegevens bevatten:

*   afmetingen van de bestaande uitrit]]></content:langeToelichting>
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__c29849da-041b-421e-afd6-279fb74fd28d">
        <uitv:regelgroepRef href="#_0f806977-323e-4ed0-aaae-78aa7e51fe59"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>120</inter:prioriteit>
                     <uitv:bijlage>
    <uitv:bijlageType>Overige gegevens noodzakelijk voor toetsing aan omgevingsplan</uitv:bijlageType>
    <uitv:documenttypeGeneriek></uitv:documenttypeGeneriek>
</uitv:bijlage>
          <content:uitvoeringsregelToelichting>
            <content:toelichting><![CDATA[Heeft de gemeente aangegeven dat u ook nog andere, dan de hiervoor gevraagde, gegevens moet aanleveren? Of wilt u zelf nog andere gegevens toevoegen? Voeg die dan hier toe als bijlage.]]></content:toelichting>
    
    
    <content:belangrijk>false</content:belangrijk>
</content:uitvoeringsregelToelichting>
 </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__3f38edf0-9dd6-4f36-b7db-69aac942b1b9">
        <uitv:regelgroepRef href="#_d4577135-d47d-4526-9d45-bde6c4fbf2e6"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>130</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Wat zijn de afmetingen van de bestaande in- of uitrit?</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                            <uitv:uitvoeringsregel id="uitv__2b5a0011-3f0a-4ee4-9fa5-b1327c132dba">
        <uitv:regelgroepRef href="#_d4577135-d47d-4526-9d45-bde6c4fbf2e6"/>
    <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>        <inter:prioriteit>140</inter:prioriteit>
     <uitv:vraag>
    <uitv:gegevensType>string</uitv:gegevensType>
    <uitv:vraagTekst>Wat worden de afmetingen van de in- of uitrit in de nieuwe situatie?</uitv:vraagTekst>
    <inter:inputType>textarea</inter:inputType>    </uitv:vraag>


                         </uitv:uitvoeringsregel>

                    </uitv:uitvoeringsregels>
        
    </dmn:extensionElements>
    

		<dmn:decisionTable hitPolicy="COLLECT"
		                   id="_76d3206d-54c9-4b66-ae68-d9594247ccf7_table"
		                   outputLabel="Maatregelen - Verwerken van thermoplastisch kunststof - Maatregelen"
		                   typeRef="tMaatregelenVerwerkenThermoplastischKunstst">
			<dmn:input>
				<dmn:inputExpression typeRef="boolean">
					<dmn:text>Toepassingsbereik - VerwerkenThermoplastischKunstst - Verwerken van thermoplastisch kunststof - Toepassingsbereik</dmn:text>
				</dmn:inputExpression>
			</dmn:input>
			<dmn:input>
				<dmn:inputExpression typeRef="boolean">
					<dmn:text>andere werkzaamheden met thermoplastisch kunststof - Verwerken van thermoplastisch kunststof - Maatregelen + Toepassingsbereik</dmn:text>
				</dmn:inputExpression>
			</dmn:input>
			<dmn:input>
				<dmn:inputExpression typeRef="boolean">
					<dmn:text>Andere werkzaamheden + ftalaten BR - Verwerken van thermoplastisch kunststof - Maatregelen + Toepassingsbereik</dmn:text>
				</dmn:inputExpression>
			</dmn:input>

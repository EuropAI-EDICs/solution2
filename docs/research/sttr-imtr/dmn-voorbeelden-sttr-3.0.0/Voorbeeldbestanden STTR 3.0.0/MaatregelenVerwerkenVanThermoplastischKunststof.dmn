		<uitv:uitvoeringsregels>
			<uitv:uitvoeringsregel id="_20418853-acfa-4e9e-8de5-2455e6b6dfcd">
				<uitv:regelgroepRef href="#_bde952b0-6f98-47f0-9228-04d53c538e03"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>10</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>list</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Thermoplastisch kunststof verwerken: Kies alle werkzaamheden die u uitvoert.]]></uitv:vraagTekst>
					<uitv:opties>
						<uitv:optieType>meerdereAntwoorden</uitv:optieType>
						<uitv:optie>
							<uitv:sequenceId>1</uitv:sequenceId>
							<uitv:optieText><![CDATA[Textiel lassen]]></uitv:optieText>
							<content:uitvoeringsregelToelichting>
								<content:toelichting><![CDATA[Het gaat bij textiel bijvoorbeeld om vrachtwagenzeil\. Dat is gemaakt van kunststof met een kern van textiel\.]]></content:toelichting>
								<content:belangrijk>true</content:belangrijk>
							</content:uitvoeringsregelToelichting>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>2</uitv:sequenceId>
							<uitv:optieText><![CDATA[Andere werkzaamheden met thermoplastisch kunststof]]></uitv:optieText>
							<content:uitvoeringsregelToelichting>
								<content:toelichting><![CDATA[**Wat is thermoplastisch kunststof?**   
 Thermoplastisch kunststof is kunststof dat zacht wordt als u het verwarmt\. U kunt het zachte kunststof in de gewenste vorm brengen\. Als het kunststof dan weer afkoelt, houdt het die nieuwe vorm\. Thermoplastische kunststoffen heten ook wel thermoplasten\. Voorbeelden zijn polyethyleen, polypropyleen en polyvinylchloride\.**﻿**]]></content:toelichting>
								<content:belangrijk>true</content:belangrijk>
							</content:uitvoeringsregelToelichting>
						</uitv:optie>
					</uitv:opties>
				</uitv:vraag>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_f16ee956-77b1-425e-b125-075da557b838">
				<uitv:herbruikbaarId>f16ee956-77b1-425e-b125-075da557b838_11_353d89fe-d469-4186-8018-17138a5c9455_1</uitv:herbruikbaarId>
				<uitv:regelgroepRef href="#_86178ee2-18d2-4a50-9eaf-5291d0f8558b"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>10</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>list</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Kies alles wat u heeft om de bodem te beschermen. ]]></uitv:vraagTekst>
					<uitv:opties>
						<uitv:optieType>meerdereAntwoorden</uitv:optieType>
						<uitv:optieGeenVanBovenstaande>true</uitv:optieGeenVanBovenstaande>
						<uitv:optie>
							<uitv:sequenceId>1</uitv:sequenceId>
							<uitv:optieText><![CDATA[Lekbak]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>2</uitv:sequenceId>
							<uitv:optieText><![CDATA[Vloeistofdichte vloer]]></uitv:optieText>
							<content:uitvoeringsregelToelichting>
								<content:toelichting><![CDATA[Het gaat om een vloer die geen vloeistof doorlaat\.]]></content:toelichting>
								<content:belangrijk>false</content:belangrijk>
							</content:uitvoeringsregelToelichting>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>3</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ander soort voorziening of vloer]]></uitv:optieText>
							<content:uitvoeringsregelToelichting>
								<content:toelichting><![CDATA[Hieronder valt het volgende:   
 

*   Een vloer die vloeistof een tijdje kan tegenhouden, maar die niet helemaal vloeistofdicht is\. Zoals een betonvloer of asfaltvloer zonder scheuren\. Of een vloer van tegels of betonplaten met gekitte naden\. In de wet heet zo'n vloer een aaneengesloten bodemvoorziening\. Eerder heette dit een vloeistofkerende vloer\.
*   Een vloer die vloeistof kort kan tegenhouden\. Bijvoorbeeld een tegelvloer waarvan de naden niet zijn gekit\. Of een klinkervloer\. In de wet heet zo'n vloer een elementen bodemvoorziening\.
*   Een vloeistofdichte folie onder de grond\. Dit heet ook wel geomembraanbaksysteem\.
*   Een bak onder een vulpunt van een opslagtank\. Dit heet ook wel een vulpuntmorsbak\.]]></content:toelichting>
								<content:belangrijk>true</content:belangrijk>
							</content:uitvoeringsregelToelichting>
						</uitv:optie>
					</uitv:opties>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[Kies ook alles wat u nog gaat aanleggen of plaatsen\.]]></content:toelichting>
					<content:belangrijk>true</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_60720c30-9709-4f24-9ff3-4326554c9c25">
				<uitv:regelgroepRef href="#_18b9d9f8-8829-4f37-a03c-c54a4fbf1489"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>10</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>boolean</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Verwerkt u thermoplastisch kunststof door het te verhitten en vorm te geven? ]]></uitv:vraagTekst>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[Een kunststof is thermoplastisch als het zacht wordt als u het verhit\.]]></content:toelichting>
					<content:langeToelichting><![CDATA[**Wat valt onder verhitten en vormgeven?**   
 Onder het verhitten en vormgeven van thermoplastisch kunststof vallen bijvoorbeeld de volgende technieken:   
 

*   extruderen
*   spuitgieten
*   thermovormen
*   kalanderen
*   textiel lassen

   
 **Wat valt niet onder verhitten en vormgeven?**   
 Kunststof mechanisch bewerken, lijmen of coaten van kunststof valt hier niet onder\. Hiervoor moet u een andere werkzaamheid kiezen\. Controleer of u die al gekozen heeft\. Heeft u die nog niet gekozen? Ga dan terug naar stap 2: Kies werkzaamheden\. Zoek daar naar ‘kunststof bewerken’ en kies de passende werkzaamheid\.]]></content:langeToelichting>
					<content:belangrijk>true</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_b19c559d-1844-4605-a8a6-456ac32f4324">
				<uitv:regelgroepRef href="#_bde952b0-6f98-47f0-9228-04d53c538e03"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>20</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>boolean</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Textiel lassen: Voert u lucht naar buiten af?]]></uitv:vraagTekst>
				</uitv:vraag>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_611b2373-7036-4242-811c-679c869b253f">
				<uitv:regelgroepRef href="#_18b9d9f8-8829-4f37-a03c-c54a4fbf1489"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>20</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>boolean</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Gebruikt u een blaasmiddel als u thermoplastisch kunststof verwerkt?]]></uitv:vraagTekst>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[Voorbeelden van blaasmiddelen zijn lucht, stikstof, kooldioxide en pentaan\.]]></content:toelichting>
					<content:belangrijk>true</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_2d54d0d5-a58d-4b15-a251-4c7c4104a6f9">
				<uitv:herbruikbaarId>2d54d0d5-a58d-4b15-a251-4c7c4104a6f9_2_6fb4d3a3-4e6a-4c29-82c6-24f30ab63ea2_1</uitv:herbruikbaarId>
				<uitv:regelgroepRef href="#_4cb98a8b-6863-4590-929d-0b8856b7fead"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<uitv:vraag>
					<uitv:gegevensType>boolean</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Gaat u stoppen met werkzaamheden die de bodem kunnen vervuilen?]]></uitv:vraagTekst>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[**Welke werkzaamheden kunnen de bodem vervuilen?**   
 De volgende werkzaamheden kunnen de bodem vervuilen:   
 

*   bodembedreigende stoffen gebruiken
*   producten maken waarin bodembedreigende stoffen zitten
*   werkzaamheden waarbij bodembedreigende stoffen kunnen vrijkomen

   
 **Welke stoffen zijn bodembedreigende stoffen?**   
 Voorbeelden van bodembedreigende stoffen zijn olie, oplosmiddelen, lijmen, verven, verdunners en koelvloeistof\. Maar hieronder vallen ook autowrakken, poetsdoeken en andere voorwerpen waar stoffen uit kunnen lekken\.]]></content:toelichting>
					<content:belangrijk>false</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_84164855-ec1c-4eca-a2fe-91cbbe9a3080">
				<uitv:regelgroepRef href="#_bde952b0-6f98-47f0-9228-04d53c538e03"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>30</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>list</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Thermoplastisch kunststof verwerken: Kunnen er ftalaten vrijkomen die erg schadelijk zijn voor mens en milieu? ]]></uitv:vraagTekst>
					<uitv:opties>
						<uitv:optieType>enkelAntwoord</uitv:optieType>
						<uitv:optie>
							<uitv:sequenceId>1</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ja]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>2</uitv:sequenceId>
							<uitv:optieText><![CDATA[Nee]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>3</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ik weet het niet]]></uitv:optieText>
						</uitv:optie>
					</uitv:opties>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[**Wat zijn ftalaten?**   
 Ftalaten zijn weekmakers\. Weekmakers zijn stoffen die kunststof en rubber flexibel en buigzaam maken\.   
    
 **Welke ftalaten zijn erg schadelijk voor mens en milieu?**   
 De volgende ftalaten zijn erg schadelijk voor mens en milieu:   
 

*   benzylbutylftalaat
*   dibutylftalaat
*   di-ethylhexylftalaat
*   di-isobutylftalaat]]></content:toelichting>
					<content:belangrijk>true</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_721b7be6-32d3-41c7-8018-094e431e13ac">
				<uitv:herbruikbaarId>721b7be6-32d3-41c7-8018-094e431e13ac_4_336eed0f-39cc-4d23-9c26-bdba66f1c7fd_1</uitv:herbruikbaarId>
				<uitv:regelgroepRef href="#_4cb98a8b-6863-4590-929d-0b8856b7fead"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>10</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>list</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Kunnen uw werkzaamheden de bodem vervuilen?]]></uitv:vraagTekst>
					<uitv:opties>
						<uitv:optieType>enkelAntwoord</uitv:optieType>
						<uitv:optie>
							<uitv:sequenceId>1</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ja]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>2</uitv:sequenceId>
							<uitv:optieText><![CDATA[Nee]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>3</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ik weet het niet]]></uitv:optieText>
						</uitv:optie>
					</uitv:opties>
				</uitv:vraag>
				<content:uitvoeringsregelToelichting>
					<content:toelichting><![CDATA[**Welke werkzaamheden kunnen de bodem vervuilen?**   
 De volgende werkzaamheden kunnen de bodem vervuilen:   
 

*   bodembedreigende stoffen gebruiken
*   producten maken waarin bodembedreigende stoffen zitten
*   werkzaamheden waarbij bodembedreigende stoffen kunnen vrijkomen

   
 **Welke stoffen zijn bodembedreigende stoffen?**   
 Voorbeelden van bodembedreigende stoffen zijn olie, oplosmiddelen, lijmen, verven, verdunners en koelvloeistof\. Maar hieronder vallen ook autowrakken, poetsdoeken en andere voorwerpen waar stoffen uit kunnen lekken\.]]></content:toelichting>
					<content:belangrijk>false</content:belangrijk>
				</content:uitvoeringsregelToelichting>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_aee8dbb4-82b4-40a3-b0af-2782e672aeb4">
				<uitv:regelgroepRef href="#_4d8624cd-3b13-4a23-9095-c750da3a3fdf"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>
				<uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>10</inter:prioriteit>
				<uitv:vraag>
					<uitv:gegevensType>list</uitv:gegevensType>
					<uitv:vraagTekst><![CDATA[Kies alle blaasmiddelen die u gebruikt.]]></uitv:vraagTekst>
					<uitv:opties>
						<uitv:optieType>meerdereAntwoorden</uitv:optieType>
						<uitv:optie>
							<uitv:sequenceId>1</uitv:sequenceId>
							<uitv:optieText><![CDATA[Lucht]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>2</uitv:sequenceId>
							<uitv:optieText><![CDATA[Kooldioxide]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>3</uitv:sequenceId>
							<uitv:optieText><![CDATA[Stikstof]]></uitv:optieText>
						</uitv:optie>
						<uitv:optie>
							<uitv:sequenceId>4</uitv:sequenceId>
							<uitv:optieText><![CDATA[Ander blaasmiddel]]></uitv:optieText>
							<content:uitvoeringsregelToelichting>
								<content:toelichting><![CDATA[Een voorbeeld van een ander blaasmiddel is pentaan\.]]></content:toelichting>
								<content:belangrijk>true</content:belangrijk>
							</content:uitvoeringsregelToelichting>
						</uitv:optie>
					</uitv:opties>
				</uitv:vraag>
			</uitv:uitvoeringsregel>
			<uitv:uitvoeringsregel id="_50ce23a3-829e-4c3b-9257-2cecc68e7bc3">
				<uitv:regelgroepRef href="#_43a31ff8-1b22-4599-9c48-46dd2be5b04d"/>
				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>true</uitv:publiceerbaar>

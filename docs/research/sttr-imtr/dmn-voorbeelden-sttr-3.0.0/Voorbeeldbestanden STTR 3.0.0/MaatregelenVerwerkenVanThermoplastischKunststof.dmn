	<dmn:decision id="_7150a754-f88d-40d7-a5af-cc47031554d6"
	              name="ftalaten - Verwerken van thermoplastisch kunststof - Maatregelen">
		<dmn:variable id="_1f588f9b-1d57-4416-830c-248c6a6b0116"
		              name="ftalaten - Verwerken van thermoplastisch kunststof - Maatregelen"
		              typeRef="boolean"/>
		<dmn:informationRequirement>
			<dmn:requiredInput href="#_090061ca-32d0-11ee-8848-ba0630dc84cd"/>
		</dmn:informationRequirement>
		<dmn:decisionTable hitPolicy="ANY"
		                   id="_7150a754-f88d-40d7-a5af-cc47031554d6_table"
		                   outputLabel="ftalaten - Verwerken van thermoplastisch kunststof - Maatregelen"
		                   typeRef="boolean">
			<dmn:input>
				<dmn:inputExpression typeRef="string">
					<dmn:text>Thermoplasten_Ftalaten UR</dmn:text>
				</dmn:inputExpression>
			</dmn:input>
			<dmn:output/>
			<dmn:rule>
				<dmn:inputEntry>
					<dmn:text>if ?=null then false else list contains(?,"Ja")</dmn:text>
				</dmn:inputEntry>
				<dmn:outputEntry>
					<dmn:text>true</dmn:text>
				</dmn:outputEntry>
			</dmn:rule>
			<dmn:rule>
				<dmn:inputEntry>

				<inter:classificatie>activiteit</inter:classificatie>
				<uitv:publiceerbaar>false</uitv:publiceerbaar> 
				<uitv:potentieelVertrouwelijk>false</uitv:potentieelVertrouwelijk>
				<inter:prioriteit>1</inter:prioriteit>
				<uitv:vasteWaarde>

    <semantic:extensionElements>
		<bedr:sttr versie="3"/>
        <inter:regelgroepen>
            <inter:regelgroep id="groep1">
                <inter:naam>Soortenbescherming</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="UitvId0001">
                <uitv:regelgroepRef href="#groep1"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst>Welke beschermde soort valt binnen de invloedsfeer van uw activiteiten?</uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Denk aan vogels, vleermuizen of overige soorten waarvan het leefgebied door uw activiteiten mogelijk aangetast wordt.</content:toelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="UitvId0002">
                <uitv:regelgroepRef href="#groep1"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst>Beschrijf hier wat de werkzaamheden zijn en in welke periode en op welke wijze ze worden uitgevoerd.</uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="UitvId0003">
                <uitv:regelgroepRef href="#groep1"/>
                <inter:prioriteit>30</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst>Voeg hier een foto toe van de boom/bomen die u wilt gaan kappen.</uitv:vraagTekst>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="UitvId0004">
                <uitv:regelgroepRef href="#groep1"/>
                <inter:prioriteit>1</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>list</uitv:gegevensType>
                    <uitv:vraagTekst>Wat voor soort boom of soorten bomen wilt u gaan kappen?</uitv:vraagTekst>
                    <uitv:opties>
                        <uitv:optieType>meerdereAntwoorden</uitv:optieType>
                        <uitv:optieGeenVanBovenstaande>true</uitv:optieGeenVanBovenstaande>
                        <uitv:optie>
                            <uitv:sequenceId>1</uitv:sequenceId>
                            <uitv:optieText>Beuk</uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>2</uitv:sequenceId>
                            <uitv:optieText>Eik</uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>3</uitv:sequenceId>
                            <uitv:optieText>Es</uitv:optieText>
                        </uitv:optie>
                        <uitv:optie>
                            <uitv:sequenceId>4</uitv:sequenceId>
                            <uitv:optieText>Spar</uitv:optieText>
                        </uitv:optie>
                    </uitv:opties>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Er kunnen meerdere soorten worden gekozen.</content:toelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>
    </semantic:extensionElements>

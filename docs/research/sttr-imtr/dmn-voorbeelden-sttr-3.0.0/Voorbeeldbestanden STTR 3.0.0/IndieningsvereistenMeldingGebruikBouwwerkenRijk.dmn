            <uitv:uitvoeringsregel id="_6931_BizRule">
                <uitv:regelgroepRef href="#_1515_RuleGroup"/>
                <uitv:bereik>werkzaamheid</uitv:bereik>
                <inter:classificatie>activiteit</inter:classificatie>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst>Gaat het om seizoensgebonden gebruik?</uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Geef aan of het bouwwerk ieder jaar alleen tijdens een bepaald deel van het jaar wordt gebruikt\.</content:toelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="_13499_BizRule">
                <uitv:bereik>werkzaamheid</uitv:bereik>
                <inter:classificatie>activiteit</inter:classificatie>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <uitv:bijlage>
                    <uitv:bijlageType>Gelijkwaardigheid brandveilig gebruik</uitv:bijlageType>
                    <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Gaat u een gelijkwaardige maatregel toepassen? Voeg dan gegevens en bescheiden toe op grond waarvan het bevoegd gezag kan oordelen of er sprake is van een gelijkwaardige oplossing\.</content:toelichting>
                    <content:langeToelichting>Gelijkwaardigheid brandveilig gebruik houdt in dat niet rechtstreeks wordt voldaan aan de eisen van het Besluit bouwwerken leefomgeving, maar dat het bouwwerk ten minste dezelfde mate van brandveilig gebruik biedt als de eisen die in het Besluit zijn gesteld\.</content:langeToelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="_13486_BizRule">
                <uitv:bereik>werkzaamheid</uitv:bereik>
                <inter:classificatie>activiteit</inter:classificatie>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <uitv:bijlage>
                    <uitv:bijlageType>Veranderde gegevens gebruik bouwwerk</uitv:bijlageType>
                    <uitv:documenttypeGeneriek>Overig</uitv:documenttypeGeneriek>
                </uitv:bijlage>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Gaat u een bouwwerk veranderen of uitbreiden? En wijkt u daarmee af van plattegrond\- of situatietekening die u eerder heeft aangeleverd? Voeg dan een nieuwe tekening toe als bijlage\.</content:toelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="_13485_BizRule">
                <uitv:regelgroepRef href="#_1515_RuleGroup"/>
                <uitv:bereik>werkzaamheid</uitv:bereik>
                <inter:classificatie>activiteit</inter:classificatie>
                <uitv:publiceerbaar>true</uitv:publiceerbaar>
                <uitv:potentieelVertrouwelijk>true</uitv:potentieelVertrouwelijk>
                <uitv:vraag>
                    <uitv:gegevensType>string</uitv:gegevensType>
                    <uitv:vraagTekst>Gaat u een bouwwerk veranderen of uitbreiden? En wijkt u daarmee af van de gegevens die u bij deze eerdere melding heeft aangeleverd? Geef dan een korte omschrijving van de gegevens die wijzigen.</uitv:vraagTekst>
                    <inter:inputType>textarea</inter:inputType>
                </uitv:vraag>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="_BAG_Opp_BizRule">
                <uitv:regelgroepRef href="#_1515_RuleGroup"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:registerbevragingAPIProfiel>
				<uitv:verborgenStuurvraag>true</uitv:verborgenStuurvraag>
                    <uitv:afnamepunt>
                        <uitv:endpointAfnamepunt>/publiek/knooppunt/RaadplegenBAG/v1/objectklassen/verblijfsobject/_zoek</uitv:endpointAfnamepunt>
						<uitv:registerNaam>BAG</uitv:registerNaam>
                        <uitv:query>
                            <uitv:zoekingang>geometrie</uitv:zoekingang>
                            <uitv:registerKoppelveld>
                                <uitv:kenmerk>geometrie</uitv:kenmerk>
                                <uitv:registerKetenVariabele>geometrie</uitv:registerKetenVariabele>
                            </uitv:registerKoppelveld>
                        </uitv:query>
                        <uitv:criteria>
                            <uitv:kenmerk>oppervlakte</uitv:kenmerk>
                            <uitv:kwaliteit>indicatief</uitv:kwaliteit>
                            <uitv:resultaattype>enkelvoudig</uitv:resultaattype>
                        </uitv:criteria>
                        <uitv:projectie>
                            <uitv:naam>numeriek</uitv:naam>
                        </uitv:projectie>
                    </uitv:afnamepunt>
                    <uitv:vraag>
                        <uitv:gegevensType>number</uitv:gegevensType>
                        <uitv:vraagTekst>Wat is het oppervlakte?</uitv:vraagTekst>
                    </uitv:vraag>
                </uitv:registerbevragingAPIProfiel>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting>Het oppervlakte zoals opgehaald uit de Basisregistratie Adressen en Gebouwen</content:toelichting>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
        </uitv:uitvoeringsregels>

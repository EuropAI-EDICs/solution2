# Root .gitignore ignores `data/` and `sources.json` at any depth.
# Re-include the Rijnland registry and cache dir markers; keep downloaded
# GeoJSON offline (large) and runs/ artifacts untracked.
!data/
data/*
!data/sources.json
!sources.json
!data/cache/
data/cache/*
!data/cache/.gitignore
# WKP measurement fixture: committed with provenance (fase 2b).
!data/wkp/
data/wkp/*
!data/wkp/waterkwaliteit-*.json
# Peil archive: committed with provenance (fase 2d, grows per re-fetch).
!data/peilen/
data/peilen/*
!data/peilen/peilen.json
# Flow fixtures (fase 3 trede 1): Rijnland legger — peilgebieden,
# gemalen, primaire watergangen; committed with flow-source.json provenance.
!data/flow/
data/flow/*
!data/flow/peilgebieden.geojson
!data/flow/gemalen.geojson
!data/flow/watergangen-primair.json
!data/flow/flow-source.json

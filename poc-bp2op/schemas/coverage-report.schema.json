{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/poc-bp2op/schemas/coverage-report.schema.json",
  "title": "CoverageReport",
  "description": "The bulk 'Plangids-analyse' (MC-8): match-rate of the bron regels against the doelregeling per source document, conversie-gereedheid band, needs-new-rule clusters, and the plan-portfolio statistics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["perBronDocument", "needsNewRules", "portfolio", "methodTrace"],
  "properties": {
    "perBronDocument": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["docId", "naam", "nRegels", "sterk", "mogelijk", "zwak", "geenMatch", "matchRatio", "gereedheid"],
      "properties": {
        "docId": { "type": "string", "pattern": "^B\\d{2}$" },
        "naam": { "type": "string", "minLength": 5 },
        "nRegels": { "type": "integer", "minimum": 1 },
        "sterk": { "type": "integer", "minimum": 0 },
        "mogelijk": { "type": "integer", "minimum": 0 },
        "zwak": { "type": "integer", "minimum": 0 },
        "geenMatch": { "type": "integer", "minimum": 0 },
        "matchRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "gereedheid": { "enum": ["conversie_gereed", "deels_gereed", "doelregeling_uitbreiden_eerst"] }
      }
    } },
    "needsNewRules": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["thema", "nRegels", "voorbeeldBronRegelIds"],
      "properties": {
        "thema": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9_]+$" },
        "nRegels": { "type": "integer", "minimum": 1 },
        "voorbeeldBronRegelIds": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "pattern": "^BR-\\d{3}$" } }
      }
    } },
    "portfolio": { "type": "object", "additionalProperties": false, "required": ["bronhouder", "plannenTotaal", "vastgesteld", "tamOmgevingsplannen", "laatstGeverifieerd", "bron"],
      "properties": {
        "bronhouder": { "type": "string", "minLength": 2 },
        "plannenTotaal": { "type": "integer", "minimum": 0 },
        "vastgesteld": { "type": "integer", "minimum": 0 },
        "tamOmgevingsplannen": { "type": "integer", "minimum": 0 },
        "laatstGeverifieerd": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "bron": { "type": "string", "pattern": "^https?://\\S+$" }
      }
    },
    "methodTrace": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^MC-\\d{1,2}$" } }
  }
}

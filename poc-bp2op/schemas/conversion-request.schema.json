{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/poc-bp2op/schemas/conversion-request.schema.json",
  "title": "ConversionRequest",
  "description": "Intake contract of the bp2op PoC: one beleidsneutrale conversion assignment (MC-1, MC-2, MC-9) projected on a municipality. Emitted by run.py; validated by the Critic (V0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "municipality", "beleid", "doelregeling", "bronset", "kennisbankSeeds", "pilotCriteria", "methodCardsRef"],
  "properties": {
    "id": { "type": "string", "pattern": "^CR-[a-z0-9-]+$" },
    "municipality": { "type": "object", "additionalProperties": false, "required": ["naam", "code", "deadline"],
      "properties": {
        "naam": { "type": "string", "minLength": 2 },
        "code": { "type": "string", "pattern": "^gm\\d{4}$" },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "beleid": { "const": "neutraal", "description": "MC-2: the conversion itself never changes policy" },
    "doelregeling": { "type": "object", "additionalProperties": false, "required": ["naam", "cvdrId", "versie", "geldendVan", "url", "file"],
      "properties": {
        "naam": { "type": "string", "minLength": 5 },
        "cvdrId": { "type": "string", "pattern": "^CVDR\\d{6}$" },
        "versie": { "type": "integer", "minimum": 1 },
        "geldendVan": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "file": { "type": "string", "minLength": 5, "description": "path relative to poc-bp2op/ of the archived consolidation" }
      }
    },
    "bronset": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["docId", "naam", "type", "url", "file"],
      "properties": {
        "docId": { "type": "string", "pattern": "^B\\d{2}$" },
        "naam": { "type": "string", "minLength": 5 },
        "type": { "enum": ["conversiebesluit", "wijzigingsbesluit", "tam_omgevingsplan", "tijdelijk_deel_plan", "bestemmingsplan"] },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "file": { "type": "string", "minLength": 5 }
      }
    } },
    "kennisbankSeeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^B\\d{2}$" } },
    "pilotCriteria": { "type": "object", "additionalProperties": false, "required": ["laagdynamisch", "geenOpenBeleidswijziging", "vergelijkbareGebieden", "deelgebiedToegestaan"],
      "properties": {
        "laagdynamisch": { "type": "boolean" },
        "geenOpenBeleidswijziging": { "type": "boolean" },
        "vergelijkbareGebieden": { "type": "boolean" },
        "deelgebiedToegestaan": { "type": "boolean" }
      }
    },
    "methodCardsRef": { "type": "string", "minLength": 5, "description": "path of METHOD-CARDS.md the run traces itself against" }
  }
}

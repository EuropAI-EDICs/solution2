{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.local/poc-breda/schemas/spatial-claim.schema.json",
  "title": "Breda Plane D — SpatialClaimSpec",
  "description": "Ruimtelijke claim-contract voor integrale gebiedsafweging: kind + doelbuurten + magnitude + bewijsklasse. Geen prompt.",
  "type": "object",
  "required": ["claimId", "name", "kind", "buurtcodes", "magnitude", "basis"],
  "additionalProperties": false,
  "properties": {
    "claimId": {
      "type": "string",
      "pattern": "^CL-[A-Z0-9][A-Z0-9-]{0,40}$"
    },
    "name": {"type": "string", "minLength": 3},
    "kind": {
      "type": "string",
      "enum": ["woningverdichting", "dak_pv_maximalisatie"]
    },
    "buurtcodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^BU[0-9]{8}$"
      },
      "uniqueItems": true
    },
    "magnitude": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Schaal 1–5; lineaire vermenigvuldiger op gedocumenteerde Δ-formules"
    },
    "basis": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["policy_variant", "hypothetical"]
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "description": "Verplicht bij hypothetical; aanbevolen bij policy_variant"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "hypothetical"}}},
          "then": {"required": ["rationale"]}
        }
      ]
    },
    "provenanceNote": {"type": "string"},
    "proposedBy": {
      "type": "string",
      "description": "Identiteitsstempel (file|auto|…) — nooit een zelfclaim van een model"
    }
  }
}

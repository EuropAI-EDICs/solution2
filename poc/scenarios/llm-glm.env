# GLM Coding Plan (Z.AI) — OpenAI-compatible chat for scenario proposals.
# Docs: https://docs.z.ai/devpack/tool/others
#
#   # one-time: write key to gitignored local file (do not commit)
#   cat > poc/scenarios/.env.local <<'EOF'
#   export LDT_SCENARIO_LLM_API_KEY='your-key'
#   EOF
#
#   set -a && source poc/scenarios/llm-glm.env && set +a
#   nldt/.venv/bin/python poc/scenarios/compare_authors.py --use-case zon

# Optional local secrets (gitignored)
_GLM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
if [ -f "$_GLM_DIR/.env.local" ]; then
  # shellcheck disable=SC1091
  . "$_GLM_DIR/.env.local"
fi

# Force Z.AI coding endpoint (do not inherit leftover Ollama env)
export LDT_SCENARIO_LLM_ENDPOINT="https://api.z.ai/api/coding/paas/v4"
export LDT_SCENARIO_LLM_API="openai"
export LDT_SCENARIO_LLM_MODEL="${LDT_SCENARIO_LLM_MODEL:-glm-5.3}"
export LDT_SCENARIO_LLM_TIMEOUT="${LDT_SCENARIO_LLM_TIMEOUT:-300}"
export LDT_SCENARIO_LLM_DISABLE_THINK="${LDT_SCENARIO_LLM_DISABLE_THINK:-1}"
# Required via .env.local or prior export — never commit the key.

# Local open-model seam for scenario proposals (S7) and narration (S8).
# Source: docs/GENAI_SEAMS.md · poc/README.md
#
#   set -a && source poc/scenarios/llm.env && set +a
#   python3 poc/scenarios/compare_authors.py --use-case zon
#   python3 poc/scenarios/run.py --use-case zon --author llm --narrator llm

export LDT_SCENARIO_LLM_ENDPOINT="${LDT_SCENARIO_LLM_ENDPOINT:-http://localhost:11434}"
export LDT_SCENARIO_LLM_API="${LDT_SCENARIO_LLM_API:-ollama}"
export LDT_SCENARIO_LLM_MODEL="${LDT_SCENARIO_LLM_MODEL:-qwen3.8:latest}"
export LDT_SCENARIO_LLM_TIMEOUT="${LDT_SCENARIO_LLM_TIMEOUT:-300}"
export LDT_SCENARIO_LLM_DISABLE_THINK="${LDT_SCENARIO_LLM_DISABLE_THINK:-1}"

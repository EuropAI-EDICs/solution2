{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/poc/schemas/norm-card.schema.json",
  "title": "NormCard",
  "description": "One harvested norm claim with its verbatim legal citation (cite-or-abstain: a card without docId+article+version+quote+uri must never exist). Emitted by the Norm Analyst; consumed by the Norm Formalizer and the Critic (V2 legal grounding).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "evidenceId", "claim", "source", "instrument", "legalForce", "theme", "confidence", "verified", "extractedBy", "extractedAt", "appliesTo"],
  "properties": {
    "id": { "type": "string", "pattern": "^NC-[A-Z]{1,4}-\\d{2,3}$" },
    "evidenceId": { "type": "string", "pattern": "^[A-Z]{1,3}-\\d{2,3}$", "description": "id of the underlying evidence record in poc/corpus/evidence-*.json" },
    "claim": { "type": "string", "minLength": 25, "description": "English summary of the norm claim" },
    "source": { "$ref": "#/$defs/source" },
    "instrument": { "type": "string", "minLength": 8, "description": "Legal instrument name incl. consolidation version, e.g. Omgevingsverordening provincie Utrecht (CVDR704250, geldend 13-10-2025)" },
    "legalForce": { "enum": ["binding", "interpretive", "non_binding"] },
    "theme": { "type": "string", "pattern": "^(energy|nature|noise|heritage|landscape|water|spatial|ambition|forest|safety|bodem|mobiliteit|landschap):[a-z0-9]+(-[a-z0-9]+)*$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verified": { "const": true, "description": "cite-or-abstain gate: only evidence whose citation was verified may become a NormCard" },
    "extractedBy": { "$ref": "#/$defs/agentRun" },
    "extractedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "appliesTo": { "$ref": "#/$defs/appliesTo" },
    "geoBinding": { "$ref": "#/$defs/geoBinding" },
    "notes": { "type": "string", "description": "recon notes carried along for provenance (GIO join-ids, cross-references, caveats)" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docId", "article", "version", "quote", "uri"],
      "properties": {
        "docId": { "type": "string", "pattern": "^S\\d{2}$", "description": "id into poc/corpus/sources.json" },
        "article": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "minLength": 4, "description": "instrument version/date, e.g. 'CVDR704250/8, geldend van 13-10-2025 t/m heden'" },
        "quote": { "type": "string", "minLength": 20, "description": "verbatim quote in the source language" },
        "quoteLanguage": { "enum": ["nl", "en"], "default": "nl" },
        "uri": { "type": "string", "pattern": "^https?://\\S+$" },
        "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectType"],
      "properties": {
        "objectType": { "enum": ["wind_turbine", "solar_field", "forest_planting", "biomass_installation", "energy_storage", "riparian_development", "soil_activity", "roadside_development", "landscape_intervention", "agricultural_expansion", "housing_development"] },
        "contextTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "geoBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoneIds", "geometrySource"],
      "properties": {
        "zoneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "geometrySource": { "enum": ["provincial_gio", "provincial_gio_unverified", "national_source", "derived", "none"] },
        "gioJoinId": { "type": "string", "pattern": "^/join/id/regdata/pv26/\\d{4}/gio[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/nld@\\d{4}-\\d{2}-\\d{2};\\d{1,4}$" },
        "caveat": { "type": "string", "minLength": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "geometrySource": { "const": "provincial_gio" } }, "required": ["geometrySource"] },
          "then": { "required": ["gioJoinId"] }
        }
      ]
    },
    "agentRun": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*#[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}

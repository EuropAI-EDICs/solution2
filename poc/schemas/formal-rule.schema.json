{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/poc/schemas/formal-rule.schema.json",
  "title": "FormalRule",
  "description": "A typed, executable rule formalized from one NormCard by the Norm Formalizer. Ambiguous or rejected cards are flagged as such and must never carry executable predicates (never guess). executableRef points at the deterministic zone-engine operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "normCardId", "status", "ruleType", "zoneSemantics", "appliesTo", "executableRef", "formalizedBy", "formalizedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^FR-[A-Z]{1,4}-\\d{2,3}$" },
    "normCardId": { "type": "string", "pattern": "^NC-[A-Z]{1,4}-\\d{2,3}$" },
    "relatedNormCardIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^NC-[A-Z]{1,4}-\\d{2,3}$" } },
    "status": { "enum": ["formalized", "ambiguous", "rejected"] },
    "reason": { "type": "string", "minLength": 15, "description": "mandatory when status is not 'formalized': why the card was flagged or dropped" },
    "ruleType": { "enum": ["zone_inclusion", "zone_exclusion", "zone_attention", "zone_conditional", "compensation_requirement", "procedural_condition", "scope_declaration", "unsupported_claim"] },
    "zoneSemantics": { "enum": ["inclusion", "exclusion", "conditional", "attention", "compensation", "none"] },
    "appliesTo": { "$ref": "#/$defs/appliesTo" },
    "zoneSelector": { "$ref": "#/$defs/zoneSelector" },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "executableRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*@[a-z0-9][a-z0-9_.-]*$", "description": "deterministic engine operation, e.g. engine.zone.within@poc-v1" },
    "rationale": { "type": "string", "minLength": 20, "description": "how the rule follows from the quoted article (carries the cite-or-abstain argument)" },
    "formalizedBy": { "$ref": "#/$defs/agentRun" },
    "formalizedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "formalized" } }, "required": ["status"] },
      "then": { "required": ["zoneSelector", "conditions"] }
    },
    {
      "if": { "properties": { "status": { "not": { "const": "formalized" } } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    }
  ],
  "$defs": {
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectType"],
      "properties": {
        "objectType": { "enum": ["wind_turbine", "solar_field", "forest_planting", "biomass_installation", "energy_storage"] },
        "contextTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "operator", "value"],
      "properties": {
        "parameter": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "operator": { "enum": [">=", "<=", ">", "<", "==", "!=", "within", "outside"] },
        "value": { "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }, { "type": "boolean" }] },
        "unit": { "type": "string", "enum": ["m", "km", "MW", "kWh", "dB(A)", "ha", "ratio", "count", "jaar", "%"] }
      }
    },
    "zoneSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoneIds", "selection", "geometrySource"],
      "properties": {
        "zoneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "selection": { "enum": ["within", "outside"] },
        "geometrySource": { "enum": ["provincial_gio", "provincial_gio_unverified", "national_source", "derived"] },
        "gioJoinId": { "type": "string", "pattern": "^/join/id/regdata/pv26/\\d{4}/gio[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/nld@\\d{4}-\\d{2}-\\d{2};\\d{1,4}$" },
        "bufferDistanceM": { "type": "number", "exclusiveMinimum": 0 },
        "derivedFrom": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "base zone a derived geometry (e.g. a buffer) is computed from" },
        "caveat": { "type": "string", "minLength": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "geometrySource": { "const": "provincial_gio" } }, "required": ["geometrySource"] },
          "then": { "required": ["gioJoinId"] }
        },
        {
          "if": { "properties": { "geometrySource": { "const": "derived" } }, "required": ["geometrySource"] },
          "then": { "required": ["bufferDistanceM", "derivedFrom"] }
        }
      ]
    },
    "agentRun": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*#[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}

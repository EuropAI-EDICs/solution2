{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nldt.example/schemas/research-brief.schema.json",
  "title": "ResearchBrief",
  "description": "S10 Deep Research seam output — propose-only. Never executes scans or mutations; downstream S7/S4 consume hints behind their own gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefId", "topic", "findings", "proposedBy"],
  "properties": {
    "briefId": {
      "type": "string",
      "pattern": "^RB-[A-Za-z0-9._-]{1,64}$"
    },
    "topic": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "confidence"],
        "properties": {
          "claim": { "type": "string", "minLength": 8, "maxLength": 800 },
          "sourceHint": { "type": "string", "maxLength": 400 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "suggestedSeriesIds": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "suggestedMutationHints": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aspect", "rationale"],
        "properties": {
          "aspect": {
            "type": "string",
            "enum": [
              "social_rule",
              "spatial_weights",
              "economic_weights",
              "access_min",
              "other"
            ]
          },
          "rationale": { "type": "string", "minLength": 8, "maxLength": 500 }
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    },
    "proposedBy": {
      "type": "string",
      "description": "Identity stamped by the seam — never trusted from the model body",
      "minLength": 3,
      "maxLength": 120
    },
    "harness": {
      "type": "string",
      "enum": ["stub", "deepagents", "offline"],
      "description": "Which research harness produced the draft before the gate"
    }
  }
}

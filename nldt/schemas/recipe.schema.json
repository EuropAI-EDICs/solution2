{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/nldt/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "nLDT recipe definition (Cookbook): describes how an application in a digital twin is executed — data, processes, steps, outputs. Catalog (AppStore) holds metadata with link to this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "inputs", "outputs", "steps", "riskLevel"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable recipe identifier, e.g. spatial-overlay-analysis"
    },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requiredData": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataRequirement" }
    },
    "requiredProcesses": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Process ids that must exist in the catalog"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeParameter" }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeOutput" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipeStep" }
    },
    "visualizationHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredFormat": { "enum": ["geojson", "3dtiles", "wms"] },
        "layerTitle": { "type": "string" }
      }
    },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "service": { "$ref": "#/$defs/serviceBlock" },
    "cookbookUri": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI where this recipe is served"
    }
  },
  "$defs": {
    "dataRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["aoi", "reference_layer", "context_layer", "sensor_feed"] },
        "format": { "enum": ["geojson", "url", "ngsi-ld"] }
      }
    },
    "recipeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "geojson", "uri"] },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "recipeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["geojson", "json", "uri"] },
        "description": { "type": "string" }
      }
    },
    "recipeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "processId", "inputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "processId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "object" }
            ]
          },
          "description": "Values may use ${recipe.inputs.*} or ${steps.<stepId>.outputs.*} templates"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "backend": {
          "enum": ["local", "ucs", "kubeflow"],
          "default": "local",
          "description": "Hybrid routing hint for process adapter"
        }
      }
    },
    "serviceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dish", "serviceType"],
      "properties": {
        "dish": { "enum": ["the-key", "urban-air-mobility", "3-30-300", "circular-neighborhoods", "15-minute-city"] },
        "lifeEventCode": { "type": "string", "pattern": "^(THK|UAM|GRN|CIR|MIN)-[0-9]{2}$" },
        "serviceType": { "enum": ["reactive", "proactive", "measure", "plan", "share", "system", "infrastructure", "cargo"] },
        "blueprintSteps": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
        "parties": { "type": "array", "items": { "$ref": "#/$defs/serviceParty" } },
        "legalBasis": { "type": "array", "items": { "$ref": "#/$defs/legalBasisEntry" } },
        "humanMeasure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handover", "exceptions"],
          "properties": {
            "handover": { "type": "array", "items": { "type": "string" } },
            "exceptions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "localVariant": { "type": "string" },
        "genAiTestPoints": { "type": "array", "items": { "$ref": "#/$defs/genAiTestPoint" } },
        "kpis": { "type": "array", "items": { "$ref": "#/$defs/serviceKpi" } }
      }
    },
    "serviceParty": {
      "type": "object", "additionalProperties": false, "required": ["name", "role"],
      "properties": { "name": { "type": "string" }, "role": { "type": "string" } }
    },
    "legalBasisEntry": {
      "type": "object", "additionalProperties": false, "required": ["basis"],
      "properties": { "basis": { "type": "string" }, "timeLimit": { "type": "string" } }
    },
    "genAiTestPoint": {
      "type": "object", "additionalProperties": false, "required": ["point", "description"],
      "properties": {
        "point": { "enum": ["G1", "G2", "G3", "G4", "G5"] },
        "description": { "type": "string" },
        "testCases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "serviceKpi": {
      "type": "object", "additionalProperties": false,
      "required": ["kpi", "kpiType", "unit", "outcomeLens"],
      "properties": {
        "kpi": { "type": "string" },
        "kpiType": { "enum": ["output", "outcome"] },
        "unit": { "type": "string" },
        "outcomeLens": { "enum": ["Z", "L", "W", "—"] },
        "baseline": { "type": "string" },
        "target": { "type": "string" },
        "dataSource": { "type": "string" },
        "frequency": { "type": "string" },
        "kviRollup": { "type": "string" }
      }
    }
  }
}

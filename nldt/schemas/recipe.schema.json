{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/nldt/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "nLDT recipe definition (Cookbook): describes how an application in a digital twin is executed — data, processes, steps, outputs. Catalog (AppStore) holds metadata with link to this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "inputs", "outputs", "steps", "riskLevel"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable recipe identifier, e.g. spatial-overlay-analysis"
    },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requiredData": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataRequirement" }
    },
    "requiredProcesses": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Process ids that must exist in the catalog"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeParameter" }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/recipeOutput" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipeStep" }
    },
    "visualizationHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredFormat": { "enum": ["geojson", "3dtiles", "wms"] },
        "layerTitle": { "type": "string" }
      }
    },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "cookbookUri": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI where this recipe is served"
    }
  },
  "$defs": {
    "dataRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["aoi", "reference_layer", "context_layer", "sensor_feed"] },
        "format": { "enum": ["geojson", "url", "ngsi-ld"] }
      }
    },
    "recipeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "geojson", "uri"] },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "recipeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["geojson", "json", "uri"] },
        "description": { "type": "string" }
      }
    },
    "recipeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "processId", "inputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "processId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "object" }
            ]
          },
          "description": "Values may use ${recipe.inputs.*} or ${steps.<stepId>.outputs.*} templates"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "backend": {
          "enum": ["local", "ucs", "kubeflow"],
          "default": "local",
          "description": "Hybrid routing hint for process adapter"
        }
      }
    }
  }
}

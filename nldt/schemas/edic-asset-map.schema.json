{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/nldt/schemas/edic-asset-map.schema.json",
  "title": "EuropAI EDIC asset push map",
  "description": "Every nLDT asset with an EDIC destination, named owner, acceptance condition, fallback channel and readiness. WP4 SO5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "source", "assets"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 8 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "path",
        "edic",
        "assetClass",
        "owner",
        "acceptance",
        "fallback",
        "readiness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(recipe|skill|schema|agent|service|methodology|application):[a-z0-9][a-z0-9./_-]*$"
        },
        "kind": {
          "enum": [
            "recipe",
            "skill",
            "schema",
            "agent",
            "service",
            "methodology",
            "application"
          ]
        },
        "title": { "type": "string", "minLength": 3 },
        "path": { "type": "string", "minLength": 3 },
        "edic": {
          "enum": [
            "ldt-citiverse",
            "impacts",
            "digital-commons",
            "alt-edic",
            "none"
          ]
        },
        "assetClass": { "type": "string", "minLength": 3 },
        "owner": { "type": "string", "minLength": 2 },
        "relationshipOwners": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "acceptance": { "type": "string", "minLength": 8 },
        "fallback": { "type": "string", "minLength": 3 },
        "readiness": { "enum": ["mock", "hybrid", "live"] },
        "riskLevel": { "enum": ["low", "medium", "high"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldttoolbox.example/nldt/schemas/compliance-declaration.schema.json",
  "title": "Compliance declaration",
  "description": "Portable declaration of an nLDT asset against OASC MIMs and the Digital Rulebook. Written for IMPACTS-EDIC, not against project-only templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assetId",
    "assetKind",
    "version",
    "declaredAt",
    "doctrine",
    "mims",
    "digitalRulebook",
    "sovereignty",
    "hitl",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DECL-[a-z0-9][a-z0-9-]*$"
    },
    "assetId": { "type": "string", "minLength": 3 },
    "assetKind": {
      "enum": ["recipe", "agent", "schema", "application", "methodology"]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "declaredAt": { "type": "string", "format": "date" },
    "doctrine": {
      "type": "string",
      "const": "LLMs propose · engines dispose · humans decide"
    },
    "mims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MIM[0-9]+$"
          },
          "title": { "type": "string", "minLength": 3 },
          "status": { "enum": ["aligned", "partial", "not_applicable", "gap"] },
          "evidence": { "type": "string", "minLength": 8 }
        }
      }
    },
    "digitalRulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interoperability", "transparency", "contestability"],
      "properties": {
        "interoperability": { "type": "string", "minLength": 8 },
        "transparency": { "type": "string", "minLength": 8 },
        "contestability": { "type": "string", "minLength": 8 }
      }
    },
    "sovereignty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "compute", "note"],
      "properties": {
        "tier": { "enum": ["T0", "T1", "T2", "T3"] },
        "compute": { "enum": ["local-engine", "toolbox", "nlaif", "none"] },
        "note": { "type": "string", "minLength": 8 }
      }
    },
    "hitl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "trigger"],
      "properties": {
        "required": { "type": "boolean" },
        "trigger": { "type": "string", "minLength": 3 }
      }
    },
    "status": { "enum": ["draft", "proposed", "accepted"] }
  }
}

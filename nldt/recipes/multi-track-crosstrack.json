{
  "id": "multi-track-crosstrack",
  "title": "Utrecht multi-track crosstrack",
  "description": "Plane C via nLDT: crosstrack overlay across wind×solar×forest baseline runs.",
  "version": "1.0.0",
  "tags": ["poc-utrecht", "crosstrack", "plane-c", "legal"],
  "requiredProcesses": ["crosstrack-overlay"],
  "inputs": {
    "mode": {
      "type": "string",
      "description": "replay|execute",
      "required": false
    },
    "runDir": {
      "type": "string",
      "description": "Existing crosstrack-runs dir",
      "required": false
    },
    "outDir": {
      "type": "string",
      "description": "Output directory (execute)",
      "required": false
    }
  },
  "outputs": {
    "summary": {
      "type": "json",
      "description": "Crosstrack summary"
    }
  },
  "steps": [
    {
      "id": "crosstrack",
      "processId": "crosstrack-overlay",
      "title": "Run crosstrack overlay",
      "inputs": {
        "mode": "${recipe.inputs.mode}",
        "runDir": "${recipe.inputs.runDir}",
        "outDir": "${recipe.inputs.outDir}"
      },
      "outputs": { "summary": "summary" },
      "backend": "local"
    }
  ],
  "riskLevel": "high",
  "cookbookUri": "http://localhost:8081/recipes/multi-track-crosstrack"
}

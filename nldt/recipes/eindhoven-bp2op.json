{
  "id": "eindhoven-bp2op",
  "title": "Eindhoven bp2op transform",
  "description": "Bestemmingsplan → omgevingsplan conversion for Eindhoven (poc-bp2op). V4 HITL always pending.",
  "version": "1.0.0",
  "tags": ["poc-eindhoven", "bp2op", "legal"],
  "requiredProcesses": ["bp2op-transform"],
  "inputs": {
    "mode": {
      "type": "string",
      "description": "replay|execute",
      "required": false
    },
    "useCase": {
      "type": "string",
      "description": "Use case id (eindhoven)",
      "required": false
    },
    "runDir": {
      "type": "string",
      "description": "Existing bp2op run dir",
      "required": false
    },
    "outDir": {
      "type": "string",
      "description": "Output root (execute)",
      "required": false
    }
  },
  "outputs": {
    "summary": {
      "type": "json",
      "description": "bp2op run summary"
    }
  },
  "steps": [
    {
      "id": "transform",
      "processId": "bp2op-transform",
      "title": "Run bp2op transform",
      "inputs": {
        "mode": "${recipe.inputs.mode}",
        "useCase": "${recipe.inputs.useCase}",
        "runDir": "${recipe.inputs.runDir}",
        "outDir": "${recipe.inputs.outDir}"
      },
      "outputs": { "summary": "summary" },
      "backend": "local"
    }
  ],
  "riskLevel": "high",
  "cookbookUri": "http://localhost:8081/recipes/eindhoven-bp2op"
}

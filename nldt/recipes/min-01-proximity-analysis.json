  "outputs": {"run": {"type": "json", "description": "HCS run-artefact"}},
  "steps": [{"id": "run", "processId": "hcs-recipe-run", "title": "Replay nabijheidsanalyse", "inputs": {"recipeId": "min-01-proximity-analysis", "scenario": "${recipe.inputs.scenario}", "mode": "${recipe.inputs.mode}", "lang": "${recipe.inputs.lang}"}, "outputs": {"run": "run"}, "backend": "local"}],

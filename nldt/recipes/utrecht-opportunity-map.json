{
  "id": "utrecht-opportunity-map",
  "title": "Utrecht opportunity-map (replay)",
  "description": "Plane A via nLDT: replay summary of a canonical poc/runs opportunity-map (execute mode available on the process).",
  "version": "1.0.0",
  "tags": ["poc-utrecht", "opportunity-map", "plane-a", "legal"],
  "requiredProcesses": ["opportunity-map-run"],
  "inputs": {
    "useCase": {
      "type": "string",
      "description": "wind|zon|bos",
      "required": true
    },
    "runDir": {
      "type": "string",
      "description": "Optional existing run dir",
      "required": false
    }
  },
  "outputs": {
    "summary": {
      "type": "json",
      "description": "Opportunity-map run summary"
    }
  },
  "steps": [
    {
      "id": "replay",
      "processId": "opportunity-map-run",
      "title": "Replay opportunity-map summary",
      "inputs": {
        "mode": "replay",
        "useCase": "${recipe.inputs.useCase}",
        "runDir": "${recipe.inputs.runDir}"
      },
      "outputs": { "summary": "summary" },
      "backend": "local"
    }
  ],
  "riskLevel": "high",
  "cookbookUri": "http://localhost:8081/recipes/utrecht-opportunity-map"
}

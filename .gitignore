data/
*.db
__pycache__/
*.py[cod]
.DS_Store
node_modules/
.vite/
*.pem
ldtsolutions/

# PoC-5 MiniGIM: registry + probe-bewijs wél committen (de data/-regel hierboven
# dekt alle data/-mappen); zware caches en run-artefacten blijven lokaal
!poc-minigim/data/
!poc-minigim/data/**
poc-minigim/data/cache/
poc-minigim/runs/

# PoC NSPD: zelfde principe — sources-registry + probe-bewijs horen bij de repo
# (data-root terug aan; cachesubtree opnieuw weg). Zonder trailing slash, zodat
# óók de worktree-symlinks (.venv, data/cache -> hoofdcheckout) matchen.
!poc-nspd/data/
poc-nspd/data/cache
# bronze = ruwe PDOK-pagina's als-ontvangen (fetch_pdok_layers.py); lake-laag,
# niet voor git — het probe-bewijs + registry dragen de verificatie.
poc-nspd/data/bronze
poc-nspd/.venv
# gegenereerde viewer-output (make_viewer_config, task 11) blijft lokaal; de
# e2e-test schrijft naar tmp_path. Geen negatie nodig: geen eerdere regel matcht
# viewer-data/ (de data/-regel hierboven matcht alleen mappen die letterlijk
# data heten).
poc-nspd/viewer-data/

# runtime caches & build artifacts
nldt/dbt_lake/target/
nldt/dbt_lake/logs/
nldt/dbt_lake/.user.yml

poc/eval/golden-diff.json
.worktrees/

[{"article":{"type":"Property","value":"art. 6.4, eerste lid"},"cites":{"object":"https://lokaleregelgeving.overheid.nl/cvdr704250","type":"Relationship"},"id":"urn:ldt:utrecht:normcard:NC-B-01","legalForce":{"type":"Property","value":"binding"},"quote":{"type":"Property","value":"Een omgevingsplan dat betrekking heeft op locaties binnen de Groene contour bevat regels die strekken tot het beschermen en cre\u00ebren van de mogelijkheden om op de gronden gelegen binnen de Groene contour nieuwe natuur te realiseren."},"theme":{"type":"Property","value":"nature:zoekgebied-nieuwe-natuur"},"type":"ldt:NormCard"},{"article":{"type":"Property","value":"art. 6.5, tweede lid (onder d)"},"cites":{"object":"https://lokaleregelgeving.overheid.nl/cvdr704250","type":"Relationship"},"id":"urn:ldt:utrecht:normcard:NC-B-02","legalForce":{"type":"Property","value":"binding"},"quote":{"type":"Property","value":"het overblijvende verlies aan mogelijkheden om nieuwe natuur te realiseren wordt gecompenseerd met de realisatie van nieuwe natuur binnen de Groene contour met een oppervlakte van minimaal de oppervlakte van het verlies aan mogelijkheden om nieuwe natuur te realiseren."},"theme":{"type":"Property","value":"nature:compensatie-1-op-1"},"type":"ldt:NormCard"},{"article":{"type":"Property","value":"art. 6.13, eerste lid"},"cites":{"object":"https://lokaleregelgeving.overheid.nl/cvdr704250","type":"Relationship"},"id":"urn:ldt:utrecht:normcard:NC-B-03","legalForce":{"type":"Property","value":"binding"},"quote":{"type":"Property","value":"Een omgevingsplan dat betrekking heeft op locaties binnen de Waardevolle Houtopstanden - oude bosgroeiplaatsen bevat regels die strekken tot bescherming en instandhouding van op de locatie van die oude bosgroeiplaats aanwezige waarden."},"theme":{"type":"Property","value":"forest:oude-bosgroeiplaatsen"},"type":"ldt:NormCard"},{"article":{"type":"Property","value":"art. 6.15, onder a"},"cites":{"object":"https://lokaleregelgeving.overheid.nl/cvdr704250","type":"Relationship"},"id":"urn:ldt:utrecht:normcard:NC-B-04","legalForce":{"type":"Property","value":"binding"},"quote":{"type":"Property","value":"het maken van verjongingsgaten, als: 1. deze niet groter zijn dan 10 are; 2. deze gezamenlijk niet meer oppervlakte beslaan dan 10% van het bosperceel; 3. dit maximaal 1 keer per 4 jaar plaatsvindt op dezelfde locatie; en 4. dit plaatsvindt voor duurzaam bosbeheer."},"theme":{"type":"Property","value":"forest:vrijstelling-vellingsmelding"},"type":"ldt:NormCard"},{"article":{"type":"Property","value":"par. Natuur (Utrechtse kwaliteit en opgave)"},"cites":{"object":"https://www.provincie-utrecht.nl/media/8648","type":"Relationship"},"id":"urn:ldt:utrecht:normcard:NC-B-05","legalForce":{"type":"Property","value":"non_binding"},"quote":{"type":"Property","value":"Voor 2040 realiseren we in totaal 3.000 hectares natuur in de Groene contour. Grote natuureenheden worden ecologisch met elkaar in verbinding gebracht (Rivierengebied en Veenweide-plassengebied). Daarnaast onderzoeken wij de kansen voor uitbreiding van houtopstanden die bijdragen aan CO2-reductie."},"theme":{"type":"Property","value":"ambition:3000ha-nieuwe-natuur"},"type":"ldt:NormCard"},{"groundedIn":{"object":"urn:ldt:utrecht:normcard:NC-B-01","type":"Relationship"},"id":"urn:ldt:utrecht:rule:FR-B-01","ruleType":{"type":"Property","value":"zone_inclusion"},"status":{"type":"Property","value":"formalized"},"type":"ldt:FormalRule","zoneSemantics":{"type":"Property","value":"inclusion"}},{"groundedIn":{"object":"urn:ldt:utrecht:normcard:NC-B-02","type":"Relationship"},"id":"urn:ldt:utrecht:rule:FR-B-02","ruleType":{"type":"Property","value":"compensation_requirement"},"status":{"type":"Property","value":"formalized"},"type":"ldt:FormalRule","zoneSemantics":{"type":"Property","value":"compensation"}},{"groundedIn":{"object":"urn:ldt:utrecht:normcard:NC-B-03","type":"Relationship"},"id":"urn:ldt:utrecht:rule:FR-B-03","ruleType":{"type":"Property","value":"zone_co
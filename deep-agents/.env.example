# Fully local: no cloud provider keys needed. Ollama must be running
# (`ollama serve` or the Ollama app).

# Ollama endpoint (default http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Models as they appear in `ollama list` — orchestrator + POC specialists
# DEEP_AGENT_MODEL=gemma4:31b-mlx
# DEEP_AGENT_SUBMODEL=gemma4:12b-mlx

# Context window per agent (deep-agent loops grow fast; default 16384)
# OLLAMA_NUM_CTX=16384

# Laya typed-decision router on Apple Silicon (MLX, ~ms, no tokens). Default on arm64 Mac.
# DEEP_AGENT_LAYA=1
# LAYA_MAX_LOADED=1
# LAYA_PRELOAD=0
# Min. confidence (primary_poc + workflow) om hint in de orchestrator-run te injecteren (default 0.55)
# LAYA_MIN_CONFIDENCE=0.55

# Z.ai GLM (cloud, like the ZCode assistant) — optional.
# Create a key at https://z.ai/manage-apikey/apikey-list (your GLM Coding Plan
# includes API access), then uncomment and use model "zai:glm-5.3-flash":
# ZAI_API_KEY=...
